{%- comment -%}
  Aperçu : 5 styles — le 2 reste « relief Windows », les autres = dégradés gauche→droite autour du jaune.
{%- endcomment -%}
<div class="rs-btn-proposals" role="region" aria-labelledby="rs-btn-proposals-heading">
  <p id="rs-btn-proposals-heading" class="rs-btn-proposals__heading">
    <strong>Propositions de boutons</strong>
    <span class="rs-btn-proposals__hint">(aperçu — dégradés radiaux depuis le centre, sauf n°2)</span>
  </p>
  <div class="rs-btn-proposals__grid">
    <div class="rs-btn-proposals__cell">
      <span class="rs-btn-proposals__num">1</span>
      <span class="rs-btn-proposals__name">Jaune centre → crème</span>
      <button type="button" class="rs-btn-p rs-btn-p--1">Voir l’offre</button>
    </div>
    <div class="rs-btn-proposals__cell">
      <span class="rs-btn-proposals__num">2</span>
      <span class="rs-btn-proposals__name">Relief Windows jaune</span>
      <button type="button" class="rs-btn-p rs-btn-p--2">Voir l’offre</button>
    </div>
    <div class="rs-btn-proposals__cell">
      <span class="rs-btn-proposals__num">3</span>
      <span class="rs-btn-proposals__name">Jaune centre → bleu pâle</span>
      <button type="button" class="rs-btn-p rs-btn-p--3">Voir l’offre</button>
    </div>
    <div class="rs-btn-proposals__cell">
      <span class="rs-btn-proposals__num">4</span>
      <span class="rs-btn-proposals__name">Ambre centre → vanille</span>
      <button type="button" class="rs-btn-p rs-btn-p--4">Voir l’offre</button>
    </div>
    <div class="rs-btn-proposals__cell">
      <span class="rs-btn-proposals__num">5</span>
      <span class="rs-btn-proposals__name">Jaune logo → blanc cassé</span>
      <button type="button" class="rs-btn-p rs-btn-p--5">Voir l’offre</button>
    </div>
  </div>
</div>
