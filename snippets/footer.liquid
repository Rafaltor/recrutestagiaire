<footer class="footer skin-dark-footer">
  <div class="container">
    <div class="row mb-5">
      <div class="col-12 col-lg-4 col-md-5">
        <div class="footer-widget pe-xl-5 mb-5 mb-md-0">
          <div class="footerLogo mb-3">
            <span class="text-light fw-bold fs-4">{{ shop.name | upcase }}</span>
          </div>
          <div class="footerText pe-xl-3">
            <p>Collectif artistique mode & textile, Paris. Chaque vêtement est une offre. Chaque achat, une candidature.</p>
          </div>
          <div class="socialLinks">
            <ul>
              <li><a href="#" class="link"><i class="bi bi-instagram"></i></a></li>
              <li><a href="#" class="link"><i class="bi bi-tiktok"></i></a></li>
              <li><a href="#" class="link"><i class="bi bi-linkedin"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="col-6 col-lg-2 col-md-4 offset-md-3 offset-lg-0">
        <div class="footer-widget mb-5 mb-md-5 mb-lg-0">
          <h4 class="widget-title">Collections</h4>
          <ul class="footer-menu">
            {% for collection in collections limit: 5 %}
              <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="footer-widget mb-5 mb-md-5 mb-lg-0">
          <h4 class="widget-title">Le collectif</h4>
          <ul class="footer-menu">
            <li><a href="/pages/about">À propos</a></li>
            <li><a href="/pages/profils-candidats">Profils candidats</a></li>
            <li><a href="/pages/deposer-candidature">Déposer une candidature</a></li>
            <li><a href="/pages/contact">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="footer-widget">
          <h4 class="widget-title">Informations</h4>
          <ul class="footer-menu">
            <li><a href="/policies/privacy-policy">Politique de confidentialité</a></li>
            <li><a href="/policies/terms-of-service">CGV</a></li>
            <li><a href="/policies/refund-policy">Retours</a></li>
            <li><a href="/pages/mentions-legales">Mentions légales</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <div class="row align-items-center justify-content-between">
        <div class="col-auto"><p class="mb-0">© {{ 'now' | date: '%Y' }} {{ shop.name }}. Tous droits réservés.</p></div>
        <div class="col-auto"><p class="mb-0">Paris, France</p></div>
      </div>
    </div>
  </div>
</footer>
