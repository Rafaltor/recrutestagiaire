{%- comment -%}
  Remplit les encarts `rs-sponsored-rail-candidate-ad` via ?action=profiles.
  Chaque section pose `data-rs-cand-ads="1"` + data-api sur `.rs-uni-shell`.
{%- endcomment -%}
<script>
(function () {
  function escHtml(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
  }
  function escAttr(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }
  function normalizeApi(u) {
    return String(u || '').replace(/\?+$/, '');
  }
  function shuffle(arr) {
    for (var i = arr.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = arr[i];
      arr[i] = arr[j];
      arr[j] = t;
    }
    return arr;
  }
  function cvUrl(cv) {
    if (!cv) return '';
    if (typeof cv === 'string' && /^https?:\/\//i.test(cv)) return cv;
    if (Array.isArray(cv) && cv.length && cv[0]) {
      if (typeof cv[0] === 'object' && cv[0].url) return String(cv[0].url);
      if (typeof cv[0] === 'string') return cv[0];
    }
    if (typeof cv === 'object' && cv !== null && cv.url) return String(cv.url);
    return '';
  }

  function buildCandidateCard(p, kicker, labelEmail, labelCv, listUrl) {
    var name = escHtml(p.name || 'Candidat');
    var role = p.role ? escHtml(String(p.role)) : '';
    var prof = p.professions ? escHtml(String(p.professions)) : '';
    var ref = (p.id || '').slice(-6).toUpperCase();
    var email = (p.email && String(p.email).trim()) || '';
    var cv = cvUrl(p.cv);
    var mailCls = 'rs-rail-ad__cta rs-rail-ad__cta--half' + (email ? '' : ' rs-rail-ad__cta--disabled');
    var mailHref = email ? 'mailto:' + escAttr(email) : '#';
    var mailAria = email ? '' : ' aria-disabled="true"';
    var cvCls = 'rs-rail-ad__cta rs-rail-ad__cta--half' + (cv ? '' : ' rs-rail-ad__cta--disabled');
    var cvHref = cv ? escAttr(cv) : '#';
    var cvAria = cv ? '' : ' aria-disabled="true"';
    var refText = ref ? 'Réf. CND-' + escHtml(ref) : '';
    var kickerHtml =
      kicker && String(kicker).trim() !== ''
        ? '<span class="rs-rail-ad__sponsored" data-rs-cand-kicker>' + escHtml(String(kicker)) + '</span>'
        : '';
    return (
      kickerHtml +
      '<a href="' +
      escAttr(listUrl) +
      '" class="rs-rail-ad__title" data-rs-cand-name>' +
      name +
      '</a>' +
      '<div class="rs-rail-ad__cand-line" data-rs-cand-role' +
      (role ? '' : ' hidden') +
      '>' +
      role +
      '</div>' +
      '<div class="rs-rail-ad__cand-line rs-rail-ad__cand-line--muted" data-rs-cand-prof' +
      (prof ? '' : ' hidden') +
      '>' +
      prof +
      '</div>' +
      '<div class="rs-rail-ad__cand-ref" data-rs-cand-ref' +
      (refText ? '' : ' hidden') +
      '>' +
      refText +
      '</div>' +
      '<div class="rs-rail-ad__cta-row">' +
      '<a href="' +
      mailHref +
      '" class="' +
      mailCls +
      '"' +
      mailAria +
      ' data-rs-cand-email>' +
      escHtml(labelEmail) +
      '</a>' +
      '<a href="' +
      cvHref +
      '" class="' +
      cvCls +
      '"' +
      cvAria +
      ' data-rs-cand-cv target="_blank" rel="noopener noreferrer">' +
      escHtml(labelCv) +
      '</a></div>'
    );
  }

  function fillRoot(root) {
    var api = root.getAttribute('data-api');
    if (!api) return;
    var kicker = root.getAttribute('data-kicker') || 'Sponsorisé';
    var url = root.getAttribute('data-url') || {{ settings.rs_portail_url_profils | default: 'https://portail.recrutestagiaire.eu/profils' | json }};
    var labelEmail = root.getAttribute('data-cand-label-email') || 'E-mail';
    var labelCv = root.getAttribute('data-cand-label-cv') || 'CV';
    var slots = Array.from(root.querySelectorAll('[data-rs-cand-ad="1"]'));
    if (!slots.length) return;

    fetch(normalizeApi(api) + '?action=profiles')
      .then(function (r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function (d) {
        var profiles = (d && d.profiles) ? d.profiles : [];
        profiles = profiles.filter(function (p) {
          return p && (p.name || p.role || p.professions);
        });
        if (!profiles.length) return;
        shuffle(profiles);

        slots.forEach(function (slot, idx) {
          var p = profiles[idx % profiles.length];
          slot.innerHTML = buildCandidateCard(p, kicker, labelEmail, labelCv, url);
          slot.removeAttribute('hidden');
          slot.removeAttribute('aria-hidden');
        });
      })
      .catch(function (err) {
        if (typeof console !== 'undefined' && console.warn) {
          console.warn('[rs-candidate-rails] API profils indisponible', err);
        }
      });
  }

  function run() {
    document.querySelectorAll('[data-rs-cand-ads="1"]').forEach(fillRoot);
  }

  run();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  }
  window.addEventListener('load', run);
  setTimeout(run, 500);
})();
</script>
