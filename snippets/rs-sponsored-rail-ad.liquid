{%- comment -%}
  Mini pub produit façon Amazon ~2012 — rail latéral (bloc sponsored_rail).
  Optionnel : rail_product, rail_compact (bool),
  inline_product + inline_kicker, inline_show_price, inline_show_stars, inline_cta (sous profil API).
{%- endcomment -%}
{%- liquid
  assign rail_c = false
  if rail_compact == true
    assign rail_c = true
  endif

  if inline_product != blank
    assign p = inline_product
    assign ad_show_price = true
    if inline_show_price == false
      assign ad_show_price = false
    endif
    assign ad_cta = inline_cta | default: 'Voir'
  else
    assign b = block.settings
    assign p = rail_product | default: b.product
    assign ad_show_price = b.show_price
    assign ad_cta = b.cta_label | default: 'Voir'
  endif
-%}
{%- if p == blank -%}
  <div class="rs-rail-ad rs-rail-ad--placeholder{% if rail_c %} rs-rail-ad--compact{% endif %}">
    <p class="rs-rail-ad__placeholder-text mb-0">Choisissez un produit.</p>
  </div>
{%- else -%}
  {%- assign v = p.selected_or_first_available_variant -%}
  <article class="rs-rail-ad{% if rail_c %} rs-rail-ad--compact{% endif %}">
    <a href="{{ p.url }}" class="rs-rail-ad__media">
      {%- if p.featured_image != blank -%}
        {%- if rail_c -%}
          <img
            src="{{ p.featured_image | image_url: width: 240 }}"
            alt=""
            width="120"
            height="120"
            loading="lazy"
            class="rs-rail-ad__img">
        {%- else -%}
          <img
            src="{{ p.featured_image | image_url: width: 600 }}"
            alt=""
            width="200"
            height="200"
            loading="lazy"
            class="rs-rail-ad__img">
        {%- endif -%}
      {%- else -%}
        <div class="rs-rail-ad__img-fallback">IMG</div>
      {%- endif -%}
    </a>
    <a href="{{ p.url }}" class="rs-rail-ad__title">{{ p.title | escape }}</a>
    {%- if ad_show_price -%}
      <div class="rs-rail-ad__price">
        {%- if v.compare_at_price > v.price -%}
          <span class="rs-rail-ad__was">{{ v.compare_at_price | money }}</span>
        {%- endif -%}
        <strong>{{ v.price | money }}</strong>
      </div>
    {%- endif -%}
    {%- if p.type != blank -%}
      <div class="rs-rail-ad__type">{{ p.type | escape }}</div>
    {%- endif -%}
    <a href="{{ p.url }}" class="rs-rail-ad__cta">{{ ad_cta | escape }}</a>
  </article>
{%- endif -%}
