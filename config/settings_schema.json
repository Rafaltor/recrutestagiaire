      { "type": "font_picker", "id": "font_heading", "label": "Police des titres", "default": "inter_n7" },
      { "type": "range", "id": "font_size_base", "min": 12, "max": 18, "step": 1, "unit": "px", "label": "Taille de base", "default": 14 }
    ]
