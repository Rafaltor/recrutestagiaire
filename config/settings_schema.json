      { "type": "color", "id": "color_gray_bg", "label": "Fond gris (en-têtes)", "default": "#f8f9fa" },
      { "type": "header", "content": "Badges & statuts" },
      { "type": "color", "id": "color_badge_open_bg", "label": "Badge Ouvert — fond", "default": "#198754" },
      { "type": "color", "id": "color_badge_open_text", "label": "Badge Ouvert — texte", "default": "#ffffff" },
      { "type": "color", "id": "color_badge_closed_bg", "label": "Badge Pourvu — fond", "default": "#6c757d" },
      { "type": "color", "id": "color_badge_closed_text", "label": "Badge Pourvu — texte", "default": "#ffffff" }
    ]
