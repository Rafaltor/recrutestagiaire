[
  {
    "name": "theme_info",
    "theme_name": "Recrute Stagiaire",
    "theme_version": "8.0",
    "theme_author": "RS Collectif",
    "theme_documentation_url": "https://recrute-stagiaire.fr",
    "theme_support_url": "https://recrute-stagiaire.fr"
  },
  {
    "name": "Portail Recrute Stagiaire (liens boutique ↔ portail)",
    "settings": [
      {
        "type": "paragraph",
        "content": "URLs du portail externe. Elles servent de défaut pour le menu « Candidatures », le pied de page, l’accueil et les CTA. La page Shopify « candidatures » peut rester pour afficher la liste API ; les liens menu pointent par défaut vers le portail."
      },
      { "type": "text", "id": "rs_portail_url_profils", "label": "Portail — Profils / annuaire (URL complète)", "default": "https://portail.recrutestagiaire.eu/profils", "info": "Champ texte : les réglages de type « URL » Shopify n’acceptent pas les https externes en valeur par défaut." },
      { "type": "text", "id": "rs_portail_url_depot", "label": "Portail — Déposer une candidature", "default": "https://portail.recrutestagiaire.eu/depot" },
      { "type": "text", "id": "rs_portail_url_vote", "label": "Portail — Vote / swipe", "default": "https://portail.recrutestagiaire.eu/swipe" },
      { "type": "text", "id": "rs_portail_url_connexion", "label": "Portail — Connexion (Mon espace)", "default": "https://portail.recrutestagiaire.eu/connexion" },
      {
        "type": "text",
        "id": "rs_api_url_top_profile",
        "label": "API — Meilleur profil (classement)",
        "default": "https://api.recrutestagiaire.eu/rs-airtable-proxy.php?action=profil_top",
        "info": "Ionos : …/rs-airtable-proxy.php?action=profil_top (ou …/api/profils/top/). Portail Next : https://portail.recrutestagiaire.eu/api/profils/top — renvoie profile.cv (PDF signé) pour le bloc d’accueil."
      }
    ]
  },
  {
    "name": "Pages candidatures (Shopify)",
    "settings": [
      {
        "type": "paragraph",
        "content": "Page optionnelle sur la boutique (handle candidatures) pour afficher les profils via l’API IONOS. Les entrées de menu « Candidatures » renvoient par défaut vers le portail (réglages Portail ci-dessus) ; vous pouvez surcharger chaque lien dans l’en-tête."
      }
    ]
  },
  {
    "name": "Identité & Logo",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "range", "id": "logo_width", "min": 50, "max": 300, "step": 5, "unit": "px", "label": "Largeur du logo", "default": 140 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon" }
    ]
  },
  {
    "name": "Couleurs",
    "settings": [
      { "type": "header", "content": "Couleurs principales" },
      { "type": "color", "id": "color_primary", "label": "Couleur primaire (bleu logo EU)", "default": "#0033cc" },
      { "type": "color", "id": "color_primary_hover", "label": "Primaire au survol", "default": "#0015a3" },
      { "type": "color", "id": "color_secondary", "label": "Couleur secondaire", "default": "#6c757d" },
      { "type": "header", "content": "Textes" },
      { "type": "color", "id": "color_text", "label": "Texte principal", "default": "#212529" },
      { "type": "color", "id": "color_text_muted", "label": "Texte atténué", "default": "#6c757d" },
      { "type": "header", "content": "Fond" },
      { "type": "color", "id": "color_body_bg", "label": "Fond général", "default": "#ffffff" },
      { "type": "color", "id": "color_gray_bg", "label": "Fond gris (en-têtes)", "default": "#f8f9fa" },
      { "type": "header", "content": "Badges & statuts" },
      { "type": "color", "id": "color_badge_open_bg", "label": "Badge Ouvert — fond", "default": "#198754" },
      { "type": "color", "id": "color_badge_open_text", "label": "Badge Ouvert — texte", "default": "#ffffff" },
      { "type": "color", "id": "color_badge_closed_bg", "label": "Badge Pourvu — fond", "default": "#6c757d" },
      { "type": "color", "id": "color_badge_closed_text", "label": "Badge Pourvu — texte", "default": "#ffffff" }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      { "type": "font_picker", "id": "font_body", "label": "Police du corps", "default": "assistant_n4" },
      { "type": "font_picker", "id": "font_heading", "label": "Police des titres", "default": "assistant_n7" },
      { "type": "range", "id": "font_size_base", "min": 12, "max": 18, "step": 1, "unit": "px", "label": "Taille de base", "default": 13 }
    ]
  },
  {
    "name": "Mise en page",
    "settings": [
      { "type": "range", "id": "page_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Largeur max du site", "default": 1140 },
      { "type": "range", "id": "container_padding", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Padding conteneur", "default": 20 },
      { "type": "header", "content": "Mobile" },
      {
        "type": "checkbox",
        "id": "rs_viewport_desktop_wrap",
        "label": "Vue bureau sur mobile (accueil)",
        "default": false,
        "info": "Désactivé par défaut : viewport classique (width=device-width), UX mobile responsive. Si activé sur l’accueil uniquement : meta viewport large + dézoom pour imiter un écran PC."
      },
      {
        "type": "range",
        "id": "rs_viewport_fixed_width",
        "min": 980,
        "max": 1280,
        "step": 20,
        "unit": "px",
        "label": "Largeur viewport mobile",
        "default": 1180
      },
      {
        "type": "checkbox",
        "id": "rs_trust_modern_ui",
        "label": "Esthétique moderne & confiance",
        "default": true,
        "info": "Surfaces claires, bords fins, typographie du thème (réglages Typographie), accent rose plus sobre, bandeau défilant masqué. À combiner avec la section « Hero runway (vidéos) » sur l’accueil."
      }
    ]
  },
  {
    "name": "Header & Navigation",
    "settings": [
      { "type": "header", "content": "Dimensions" },
      { "type": "range", "id": "header_height", "min": 48, "max": 100, "step": 2, "unit": "px", "label": "Hauteur header", "default": 64 },
      { "type": "header", "content": "Couleurs header" },
      { "type": "color", "id": "header_bg", "label": "Fond header", "default": "#ffffff" },
      { "type": "color", "id": "header_text", "label": "Texte header", "default": "#212529" },
      { "type": "color", "id": "header_border", "label": "Bordure bas header", "default": "#e2e8f0" },
      { "type": "header", "content": "Logo & liens" },
      { "type": "range", "id": "nav_font_size", "min": 11, "max": 16, "step": 1, "unit": "px", "label": "Taille liens nav", "default": 13 },
      { "type": "range", "id": "nav_gap", "min": 8, "max": 48, "step": 2, "unit": "px", "label": "Espacement liens nav", "default": 24 },
      { "type": "header", "content": "Panier" },
      { "type": "text", "id": "cart_label", "label": "Texte lien panier", "default": "Mon dossier" },
      { "type": "checkbox", "id": "show_cart_count", "label": "Afficher le nombre d'articles", "default": true },
      {
        "type": "checkbox",
        "id": "rs_header_jobboard",
        "label": "Header type « portail emploi » (Indeed, épuré)",
        "default": true,
        "info": "Fond blanc plat, titre en casse normale, onglets soulignés bleu #2557a7, boutons dossier / espace discrets. Désactiver pour retrouver le rendu précédent (rose / grille)."
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      { "type": "color", "id": "footer_bg", "label": "Fond footer", "default": "#ffffff" },
      { "type": "color", "id": "footer_text", "label": "Texte footer", "default": "#6c757d" },
      { "type": "color", "id": "footer_border", "label": "Bordure haut footer", "default": "#e2e8f0" },
      { "type": "range", "id": "footer_padding", "min": 12, "max": 60, "step": 4, "unit": "px", "label": "Espacement vertical footer", "default": 24 },
      { "type": "text", "id": "footer_tagline", "label": "Tagline", "default": "Collectif artistique — Paris" },
      { "type": "range", "id": "footer_font_size", "min": 10, "max": 14, "step": 1, "unit": "px", "label": "Taille texte footer", "default": 12 }
    ]
  },
  {
    "name": "Cartes & composants",
    "settings": [
      { "type": "header", "content": "Cartes offres (jobgrid)" },
      { "type": "range", "id": "card_border_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Arrondi global des cartes", "default": 12 },
      { "type": "color", "id": "card_border_color", "label": "Couleur bordure carte", "default": "#e9ecef" },
      { "type": "color", "id": "card_hover_border", "label": "Bordure carte au survol", "default": "#0033cc" },
      { "type": "header", "content": "Boutons globaux" },
      { "type": "range", "id": "btn_border_radius", "min": 0, "max": 50, "step": 2, "unit": "px", "label": "Arrondi boutons", "default": 6 },
      { "type": "range", "id": "btn_font_size", "min": 11, "max": 18, "step": 1, "unit": "px", "label": "Taille texte boutons", "default": 14 },
      { "type": "header", "content": "Champs de formulaire" },
      { "type": "range", "id": "input_border_radius", "min": 0, "max": 30, "step": 2, "unit": "px", "label": "Arrondi inputs", "default": 6 },
      { "type": "range", "id": "input_font_size", "min": 11, "max": 16, "step": 1, "unit": "px", "label": "Taille texte inputs", "default": 13 }
    ]
  },
  {
    "name": "Réseaux sociaux",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_linkedin", "label": "LinkedIn URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" }
    ]
  },
  {
    "name": "SEO & Analytics",
    "settings": [
      { "type": "text", "id": "meta_title_suffix", "label": "Suffixe des titres SEO", "default": "Recrute Stagiaire" },
      { "type": "textarea", "id": "custom_head_code", "label": "Code personnalisé <head>", "info": "Google Analytics, pixels, etc." }
    ]
  }
