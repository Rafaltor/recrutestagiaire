[
  {
    "name": "theme_info",
    "theme_name": "Recrute Stagiaire",
    "theme_version": "8.0",
    "theme_author": "RS Collectif",
    "theme_documentation_url": "https://recrute-stagiaire.fr",
    "theme_support_url": "https://recrute-stagiaire.fr"
  },
  {
    "name": "Pages candidatures (éviter le 404)",
    "settings": [
      {
        "type": "paragraph",
        "content": "Les liens du menu pointent vers /pages/profils-candidats et /pages/deposer-candidature. Vous devez créer ces pages dans la boutique : Administration → Boutique en ligne → Pages → Ajouter une page. Pour chaque page, ouvrez « Visibilité du moteur de recherche » / l’aperçu du lien pour définir l’URL (handle) exactement : profils-candidats puis deposer-candidature. Dans la barre latérale droite, sous « Modèle de thème », choisissez respectivement « profils-candidats » et « deposer-candidature » (noms des modèles fournis par ce thème). Enregistrez. Sans ces deux pages, Shopify renvoie une erreur 404."
      }
    ]
  },
  {
    "name": "Identité & Logo",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "range", "id": "logo_width", "min": 50, "max": 300, "step": 5, "unit": "px", "label": "Largeur du logo", "default": 140 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon" }
    ]
  },
  {
    "name": "Couleurs",
    "settings": [
