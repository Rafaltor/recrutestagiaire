// --- Supabase (obligatoire) ---------------------------------------------------
define('RS_SUPABASE_URL', 'https://VOTRE_REF.supabase.co');
define('RS_SUPABASE_SERVICE_KEY', 'VOTRE_CLE_SERVICE_ROLE');
// Nom exact de la table dans Supabase (sensible à la casse : ex. profiles, pas profils)
define('RS_SUPABASE_TABLE', 'profiles');

// Filtrer / insérer une colonne bool « publié » (true = visible). false si la table n’a pas cette colonne.
define('RS_SUPABASE_USE_APPROVED_FILTER', false);
// Si true plus haut : nom exact de la colonne (ex. approved, published, is_visible)
// define('RS_SUPABASE_COL_APPROVED', 'approved');

// Votes / classement (nom de colonne en base — en général `likes`)
define('RS_SUPABASE_COL_LIKES', 'likes');
// Ancienne base avec colonne `score` : define('RS_SUPABASE_COL_SCORE', 'score'); (priorité à RS_SUPABASE_COL_LIKES si les deux sont définis)

// Optionnel — endpoint public top profil
// define('RS_SUPABASE_COL_INSTAGRAM', 'instagram');
// define('RS_SUPABASE_COL_METIER', 'metier');
// define('RS_SUPABASE_COL_PUBLIC_TOKEN', 'token');

// Compteur accueil : approved = seulement lignes avec colonne bool = true (nécessite USE_APPROVED_FILTER true) | all = toutes les lignes
define('RS_SUPABASE_COUNT_MODE', 'all');

define('RS_SUPABASE_COL_NAME', 'full_name');
define('RS_SUPABASE_COL_EMAIL', 'email');
define('RS_SUPABASE_COL_ROLE', 'role');
define('RS_SUPABASE_COL_PROF', 'professions');
define('RS_SUPABASE_COL_CV', 'cv_url');
define('RS_SUPABASE_COL_PORTF', 'portfolio_url');

// --- Supabase Storage (dépôt des fichiers CV) — requis si envoi multipart avec fichier
// Créer un bucket dans le dashboard (Storage) ; le rendre public si le site doit afficher le lien du CV.
define('RS_SUPABASE_STORAGE_BUCKET', 'cvs');
// Sous-dossier optionnel dans le bucket, ex. "candidats" : les fichiers seront candidats/cv-xxxxx.pdf
// define('RS_SUPABASE_STORAGE_PREFIX', 'candidats');
// Si l’URL publique des objets n’est pas l’URL du projet (rare) — sinon laisser commenté
// define('RS_SUPABASE_OBJECT_PUBLIC_BASE', 'https://VOTRE_REF.supabase.co');

// --- CORS : origines exactes autorisées (schéma + hôte, sans chemin) ----------
define('RS_ALLOWED_ORIGINS', [
  'https://recrute-stagiaire.myshopify.com',
  'https://recrutestagiaire.eu',
  'https://www.recrutestagiaire.eu',
  'https://www.votredomaine.fr',
]);

// shopify theme dev (http://127.0.0.1:9292, etc.) — mettre false ou commenter en prod si vous préférez lister chaque origine
define('RS_CORS_ALLOW_LOCAL_DEV', true);

// Variante manuelle au lieu de la ligne ci-dessus : ajouter par ex. 'http://127.0.0.1:9292', 'http://localhost:9292'
// define('RS_ALLOWED_ORIGINS', ['*']); // tests uniquement

define('RS_RATE_LIMIT_PER_MIN', 60);

// --- Affinda (analyse de CV) — requis pour POST ?action=parse_cv ----------------
