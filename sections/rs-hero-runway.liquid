{%- assign scrim_a = section.settings.overlay_strength | times: 0.01 -%}
<section
  class="rs-hero-runway shopify-section"
  style="--rs-hr-min-h: {{ section.settings.min_height_desktop }}vh;--rs-hr-scrim-a: {{ scrim_a }};"
  {{ section.shopify_attributes }}>
  <div class="rs-hero-runway__shell">
    <div class="rs-hero-runway__media" aria-hidden="true">
      {%- comment -%} Grille 2×2 identique mobile / bureau ; texte en overlay {%- endcomment -%}
      <div class="rs-hero-runway__grid">
        {%- assign v1 = section.settings.video_d1 -%}
        <div class="rs-hero-runway__cell">
          {%- if v1 != blank -%}
            <div class="rs-hero-runway__video-wrap">
              {{
                v1
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  image_size: '1200x'
              }}
            </div>
          {%- else -%}
            <div class="rs-hero-runway__placeholder">
              <span>{{ section.settings.placeholder_label }}</span>
            </div>
          {%- endif -%}
        </div>
        {%- assign v2 = section.settings.video_d2 -%}
        <div class="rs-hero-runway__cell">
          {%- if v2 != blank -%}
            <div class="rs-hero-runway__video-wrap">
              {{
                v2
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  image_size: '1200x'
              }}
            </div>
          {%- else -%}
            <div class="rs-hero-runway__placeholder">
              <span>{{ section.settings.placeholder_label }}</span>
            </div>
          {%- endif -%}
        </div>
        {%- assign v3 = section.settings.video_d3 -%}
        <div class="rs-hero-runway__cell">
          {%- if v3 != blank -%}
            <div class="rs-hero-runway__video-wrap">
              {{
                v3
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  image_size: '1200x'
              }}
            </div>
          {%- else -%}
            <div class="rs-hero-runway__placeholder">
              <span>{{ section.settings.placeholder_label }}</span>
            </div>
          {%- endif -%}
        </div>
        {%- assign v4 = section.settings.video_d4 -%}
        <div class="rs-hero-runway__cell">
          {%- if v4 != blank -%}
            <div class="rs-hero-runway__video-wrap">
              {{
                v4
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  image_size: '1200x'
              }}
            </div>
          {%- else -%}
            <div class="rs-hero-runway__placeholder">
              <span>{{ section.settings.placeholder_label }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="rs-hero-runway__scrim"></div>
    </div>

    <div class="rs-hero-runway__content container">
      <div class="rs-hero-runway__copy">
        {%- assign _hr_badge = section.settings.badge_text | default: '' | strip -%}
        {%- if _hr_badge != '' -%}
          <p class="rs-hero-runway__badge">
            <span class="rs-hero-runway__badge-dot" aria-hidden="true"></span>
            <span>{{ _hr_badge | escape }}</span>
          </p>
        {%- endif -%}
        {%- if section.settings.kicker != blank -%}
          <p class="rs-hero-runway__kicker">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        {%- liquid
          assign t = section.settings.title | default: ''
          assign em = section.settings.title_emphasis | default: '' | strip
        -%}
        {%- if em != '' and t contains em -%}
          {%- assign _parts = t | split: em -%}
          <h1 class="rs-hero-runway__title">
            {{- _parts[0] | escape -}}
            <em class="rs-hero-runway__accent">{{ em | escape }}</em>
            {%- if _parts.size > 1 -%}
              {{- _parts[1] | escape -}}
            {%- endif -%}
          </h1>
        {%- else -%}
          <h1 class="rs-hero-runway__title">{{ t | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="rs-hero-runway__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
        <div class="rs-hero-runway__actions">
          {%- if section.settings.btn_primary_label != blank -%}
            <a
              class="rs-hero-runway__btn rs-hero-runway__btn--primary"
              href="{% if section.settings.btn_primary_url != blank %}{{ section.settings.btn_primary_url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
              {{- section.settings.btn_primary_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.btn_secondary_label != blank -%}
            <a
              class="rs-hero-runway__btn rs-hero-runway__btn--ghost"
              href="{% if section.settings.btn_secondary_url != blank %}{{ section.settings.btn_secondary_url }}{% else %}/pages/profils-candidats{% endif %}">
              {{- section.settings.btn_secondary_label | escape -}}
            </a>
          {%- endif -%}
        </div>
        {%- if section.settings.trust_line != blank -%}
          <p class="rs-hero-runway__trust">{{ section.settings.trust_line | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{{ 'rs-hero-runway.css' | asset_url | stylesheet_tag }}
<script>
  (function () {
    var rsHeaderResizeObs = null;

    function rsHomeHeaderUnderHero() {
      if (document.body.getAttribute('data-rs-page') !== 'index') return;
      var h = document.querySelector('.header-wrap');
      if (!h) return;
      var px = Math.ceil(h.getBoundingClientRect().height);
      if (px < 1) px = h.offsetHeight || 168;
      document.documentElement.style.setProperty('--rs-home-header-h', px + 'px');
    }

    function rsWireHeaderHeightObserver() {
      var h = document.querySelector('.header-wrap');
      if (!h || rsHeaderResizeObs || typeof ResizeObserver === 'undefined') return;
      try {
        rsHeaderResizeObs = new ResizeObserver(function () {
          rsHomeHeaderUnderHero();
        });
        rsHeaderResizeObs.observe(h);
      } catch (e) {}
    }

    function rsHeroRunwayPlay() {
      document.querySelectorAll('.rs-hero-runway video').forEach(function (v) {
        try {
          v.muted = true;
          v.defaultMuted = true;
          v.setAttribute('muted', '');
          v.setAttribute('playsinline', '');
          v.setAttribute('webkit-playsinline', '');
          v.loop = true;
          v.setAttribute('loop', '');
          var p = v.play();
          if (p && typeof p.catch === 'function') {
            p.catch(function () {});
          }
        } catch (e) {}
      });
    }

    function boot() {
      rsHomeHeaderUnderHero();
      rsHeroRunwayPlay();
      requestAnimationFrame(function () {
        rsHomeHeaderUnderHero();
        requestAnimationFrame(rsHomeHeaderUnderHero);
      });
    }

    boot();
    rsWireHeaderHeightObserver();
    document.addEventListener('DOMContentLoaded', function () {
      boot();
      rsWireHeaderHeightObserver();
    });
    window.addEventListener('load', boot);
    window.addEventListener('resize', function () {
      rsHomeHeaderUnderHero();
    });
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) {
        rsHeroRunwayPlay();
      }
    });
    document.addEventListener('shopify:section:load', boot);

    /* Mobile : première interaction débloque souvent la lecture auto */
    ['touchstart', 'pointerdown', 'click'].forEach(function (ev) {
      document.addEventListener(
        ev,
        function () {
          rsHeroRunwayPlay();
        },
        { capture: true, passive: true, once: true }
      );
    });
  })();
</script>

{% schema %}
{
  "name": "Hero runway (vidéos)",
  "tag": "section",
  "class": "section-rs-hero-runway",
  "settings": [
    {
      "type": "paragraph",
      "content": "Sur l’accueil, le hero suit l’en-tête (barre type portail). Texte centré au milieu de la grille 2×2. Autoplay renforcé (y compris après un toucher sur mobile)."
    },
    { "type": "header", "content": "Médias — 4 extraits runway" },
    { "type": "video", "id": "video_d1", "label": "Vidéo 1" },
    { "type": "video", "id": "video_d2", "label": "Vidéo 2" },
    { "type": "video", "id": "video_d3", "label": "Vidéo 3" },
    { "type": "video", "id": "video_d4", "label": "Vidéo 4" },
    { "type": "text", "id": "placeholder_label", "label": "Texte emplacement vide", "default": "Vidéo à ajouter" },
    { "type": "header", "content": "Texte" },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge (au-dessus du surtitre)",
      "info": "Optionnel : laisser vide pour masquer le badge."
    },
    { "type": "text", "id": "kicker", "label": "Surtitre", "default": "Collectif — Paris" },
    { "type": "text", "id": "title", "label": "Titre", "default": "On a commencé stagiaires. Pourquoi pas vous ?" },
    {
      "type": "text",
      "id": "title_emphasis",
      "label": "Mot du titre en accent (rose)",
      "default": "stagiaires",
      "info": "Doit apparaître tel quel dans le titre pour être mis en couleur accent."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Collections pensées comme des offres : clarté, parcours guidé, accompagnement humain."
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Ligne confiance (sous les boutons)",
      "default": "Paiements sécurisés · Livraison suivie · Support réactif"
    },
    { "type": "header", "content": "Boutons" },
    { "type": "text", "id": "btn_primary_label", "label": "Bouton principal — libellé", "default": "Voir les offres" },
    { "type": "url", "id": "btn_primary_url", "label": "Bouton principal — lien" },
    { "type": "text", "id": "btn_secondary_label", "label": "Bouton secondaire — libellé", "default": "Profils candidats" },
    { "type": "url", "id": "btn_secondary_url", "label": "Bouton secondaire — lien" },
    { "type": "header", "content": "Mise en forme" },
    {
      "type": "range",
      "id": "min_height_desktop",
      "min": 60,
      "max": 100,
      "step": 2,
      "unit": "vh",
      "label": "Hauteur min. du hero (mobile + bureau)",
      "default": 86,
      "info": "Bloc vidéo 2×2 + zone texte overlay : une valeur proche de 88–92 % de la hauteur fenêtre remplit bien l’écran sur ordinateur."
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "min": 35,
      "max": 85,
      "step": 5,
      "unit": "%",
      "label": "Assombrissement lecture texte",
      "default": 55
    }
  ],
  "presets": [{ "name": "Hero runway (vidéos)", "category": "Image" }]
}
{% endschema %}
