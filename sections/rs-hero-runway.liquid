{%- liquid
  assign hp1 = section.settings.preview_product_1
  assign hp2 = section.settings.preview_product_2
  assign preview_index = 0
  for p in collections.all.products limit: 4
    if hp1 == blank and preview_index == 0
      assign hp1 = p
    endif
    if hp2 == blank and preview_index == 1
      assign hp2 = p
    endif
    assign preview_index = preview_index | plus: 1
  endfor
  if hp2 == blank and hp1 != blank
    assign hp2 = hp1
  endif
  assign search_action = routes.search_url
  assign coll_all = routes.all_products_collection_url
-%}
<section
  class="rs-hero-jobboard shopify-section section-rs-hero-runway"
  {{ section.shopify_attributes }}>
  <div class="container">
    <div class="rs-hero-jobboard__grid">
      <div class="rs-hero-jobboard__left">
        {%- if section.settings.kicker != blank -%}
          <p class="rs-hero-jobboard__kicker">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        {%- liquid
          assign t1 = section.settings.title_line1 | default: 'Chaque vêtement' | escape
          assign t2 = section.settings.title_line2 | default: 'est une' | escape
          assign em = section.settings.title_emphasis | default: 'offre' | strip | escape
        -%}
        <h1 class="rs-hero-jobboard__title">
          {{ t1 }}<br>
          {{ t2 }} <em>{{ em }}</em>.
        </h1>
        {%- if section.settings.subtitle != blank -%}
          <p class="rs-hero-jobboard__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}

        <form class="rs-hero-jobboard__search" action="{{ search_action }}" method="get" role="search">
          <input type="hidden" name="type" value="product">
          <span class="text-muted" aria-hidden="true">🔍</span>
          <input
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.search_placeholder | default: 'Cherche un poste...' | escape }}"
            autocomplete="off">
          <button type="submit" class="rs-hero-jobboard__search-btn">{{ section.settings.search_btn_label | default: 'Voir les offres →' | escape }}</button>
        </form>

        <div class="rs-hero-jobboard__filters">
          {%- if section.settings.pill1_label != blank -%}
            <a class="rs-hero-jobboard__pill" href="{{ section.settings.pill1_url | default: coll_all }}">{{ section.settings.pill1_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.pill2_label != blank -%}
            <a class="rs-hero-jobboard__pill" href="{{ section.settings.pill2_url | default: coll_all }}">{{ section.settings.pill2_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.pill3_label != blank -%}
            <a class="rs-hero-jobboard__pill" href="{{ section.settings.pill3_url | default: coll_all }}">{{ section.settings.pill3_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.pill4_label != blank -%}
            <a class="rs-hero-jobboard__pill" href="{{ section.settings.pill4_url | default: coll_all }}">{{ section.settings.pill4_label | escape }}</a>
          {%- endif -%}
        </div>

        {%- if section.settings.stats_line != blank -%}
          <div class="rs-hero-jobboard__stats">
            <span class="rs-hero-jobboard__stats-dot">{{ section.settings.stats_line | escape }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="rs-hero-jobboard__right">
        <div class="rs-hero-jobboard__cards">
          {%- if hp1 != blank -%}
            {% render 'rs-indeed-job-row', product: hp1, collection: collections.all, compact: true %}
          {%- endif -%}
          {%- if hp2 != blank -%}
            {% render 'rs-indeed-job-row', product: hp2, collection: collections.all, compact: true %}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    function rsHomeHeaderUnderHero() {
      if (document.body.getAttribute('data-rs-page') !== 'index') return;
      var h = document.querySelector('.header-wrap');
      if (!h) return;
      var px = Math.ceil(h.getBoundingClientRect().height);
      if (px < 1) px = h.offsetHeight || 168;
      document.documentElement.style.setProperty('--rs-home-header-h', px + 'px');
    }
    rsHomeHeaderUnderHero();
    document.addEventListener('DOMContentLoaded', rsHomeHeaderUnderHero);
    window.addEventListener('resize', rsHomeHeaderUnderHero);
    document.addEventListener('shopify:section:load', rsHomeHeaderUnderHero);
  })();
</script>

{% schema %}
{
  "name": "Hero accueil (offres)",
  "tag": "section",
  "class": "section-rs-hero-runway",
  "settings": [
    { "type": "header", "content": "Colonne gauche" },
    {
      "type": "text",
      "id": "kicker",
      "label": "Label (uppercase)",
      "default": "OFFRES EN COURS · PARIS · SS26"
    },
    { "type": "text", "id": "title_line1", "label": "Titre — ligne 1", "default": "Chaque vêtement" },
    { "type": "text", "id": "title_line2", "label": "Titre — avant le mot accent", "default": "est une" },
    { "type": "text", "id": "title_emphasis", "label": "Mot accent (rose)", "default": "offre" },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Postule. Candidature non négociable. Les meilleurs CV finissent sur le packaging."
    },
    { "type": "text", "id": "search_placeholder", "label": "Placeholder recherche", "default": "Cherche un poste..." },
    { "type": "text", "id": "search_btn_label", "label": "Bouton recherche", "default": "Voir les offres →" },
    {
      "type": "text",
      "id": "stats_line",
      "label": "Ligne stats (texte libre)",
      "default": "● 2 offres actives  ·  ● Expédition 48h  ·  ● Collection SS26"
    },
    { "type": "header", "content": "Filtres rapides (pills)" },
    { "type": "text", "id": "pill1_label", "label": "Pill 1 — libellé", "default": "Tous les postes" },
    { "type": "url", "id": "pill1_url", "label": "Pill 1 — lien" },
    { "type": "text", "id": "pill2_label", "label": "Pill 2 — libellé", "default": "Édition limitée" },
    { "type": "url", "id": "pill2_url", "label": "Pill 2 — lien" },
    { "type": "text", "id": "pill3_label", "label": "Pill 3 — libellé", "default": "CDI" },
    { "type": "url", "id": "pill3_url", "label": "Pill 3 — lien" },
    { "type": "text", "id": "pill4_label", "label": "Pill 4 — libellé", "default": "Disponible maintenant" },
    { "type": "url", "id": "pill4_url", "label": "Pill 4 — lien" },
    { "type": "header", "content": "Aperçu cartes (droite)" },
    {
      "type": "product",
      "id": "preview_product_1",
      "label": "Produit 1 (optionnel, sinon 1er de la boutique)"
    },
    {
      "type": "product",
      "id": "preview_product_2",
      "label": "Produit 2 (optionnel, sinon 2e de la boutique)"
    }
  ],
  "presets": [{ "name": "Hero accueil (offres)", "category": "Bannière" }]
}
{% endschema %}
