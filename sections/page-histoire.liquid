{%- assign rs_profils = settings.rs_portail_url_profils | default: 'https://portail.recrutestagiaire.eu/profils' -%}
{%- assign rs_depot = settings.rs_portail_url_depot | default: 'https://portail.recrutestagiaire.eu/depot' -%}

<div class="gray py-4 border-bottom">
  <div class="container">
    <h1 class="fs-3 fw-semibold mb-1">
      {{ section.settings.heading | default: page.title }}
    </h1>
    {%- if section.settings.lead != blank -%}
      <p class="mb-0 text-muted" style="font-size: 15px; max-width: 42rem;">
        {{ section.settings.lead }}
      </p>
    {%- endif -%}
  </div>
</div>

<div class="container py-5" style="max-width: 820px;">
  {%- if section.settings.slogan != blank -%}
    <figure class="mb-5 p-4 rounded border-start border-4" style="border-color: #0033cc !important; background: #f8fafc;">
      <blockquote class="mb-0 fst-italic" style="font-size: 1.15rem; line-height: 1.5;">
        « {{ section.settings.slogan }} »
      </blockquote>
    </figure>
  {%- endif -%}

  {%- if section.settings.body_intro != blank -%}
    <div class="rte mb-5" style="font-size: 15px; line-height: 1.8;">
      {{ section.settings.body_intro }}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'chapter' -%}
      <section class="mb-5 pb-4 border-bottom border-light" {{ block.shopify_attributes }}>
        {%- if block.settings.kicker != blank -%}
          <p class="small text-uppercase fw-semibold text-muted mb-1" style="letter-spacing: 0.06em;">
            {{ block.settings.kicker }}
          </p>
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <h2 class="h4 fw-bold mb-3">{{ block.settings.title }}</h2>
        {%- endif -%}
        {%- if block.settings.body != blank -%}
          <div class="rte" style="font-size: 15px; line-height: 1.8;">
            {{ block.settings.body }}
          </div>
        {%- endif -%}
      </section>
    {%- endif -%}
  {%- endfor -%}

  {%- if section.settings.body_closing != blank -%}
    <div class="rte mb-5" style="font-size: 15px; line-height: 1.8;">
      {{ section.settings.body_closing }}
    </div>
  {%- endif -%}

  <div class="d-flex flex-wrap gap-2 align-items-center pt-2">
    {%- if section.settings.cta_boutique_label != blank -%}
      <a
        href="{{ section.settings.cta_boutique_url | default: routes.all_products_collection_url }}"
        class="btn btn-primary">
        {{ section.settings.cta_boutique_label }}
      </a>
    {%- endif -%}
    {%- if section.settings.cta_portail_profils_label != blank -%}
      <a href="{{ rs_profils }}" class="btn btn-outline-primary" target="_blank" rel="noopener noreferrer">
        {{ section.settings.cta_portail_profils_label }}
      </a>
    {%- endif -%}
    {%- if section.settings.cta_portail_depot_label != blank -%}
      <a href="{{ rs_depot }}" class="btn btn-outline-secondary" target="_blank" rel="noopener noreferrer">
        {{ section.settings.cta_portail_depot_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Page Histoire / Collectif",
  "tag": "section",
  "class": "section-page-histoire",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre principal",
      "default": "Le collectif"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Accroche sous le titre",
      "default": "Recrute Stagiaire n'est pas une marque de mode avec un site e-commerce : c'est une plateforme communautaire qui se finance via une boutique de mode."
    },
    {
      "type": "text",
      "id": "slogan",
      "label": "Slogan (citation)",
      "default": "On a commencé stagiaires. Pourquoi pas vous ?"
    },
    {
      "type": "richtext",
      "id": "body_intro",
      "label": "Introduction (rupture, conviction)",
      "default": "<p>Aucune marque de mode ne laisse sa communauté choisir ses propres collaborateurs. Nous, on externalise ce pouvoir vers la rue créative.</p><p>Le portail est <strong>gratuit par conviction</strong> : pas une ligne de revenu, mais la crédibilité du projet. On veut vivre de la boutique ; le portail est notre utilité publique créative.</p>"
    },
    {
      "type": "richtext",
      "id": "body_closing",
      "label": "Texte de fin (optionnel)",
      "default": "<p><strong>Règles fondatrices :</strong> pas de photo de profil, CV mono-page, la communauté décide, portail gratuit au lancement.</p>"
    },
    {
      "type": "text",
      "id": "cta_boutique_label",
      "label": "Bouton — Boutique",
      "default": "Voir la boutique"
    },
    {
      "type": "url",
      "id": "cta_boutique_url",
      "label": "Lien boutique (vide = toutes les collections)"
    },
    {
      "type": "text",
      "id": "cta_portail_profils_label",
      "label": "Bouton — Profils (portail)",
      "default": "Voir les profils"
    },
    {
      "type": "text",
      "id": "cta_portail_depot_label",
      "label": "Bouton — Déposer (portail)",
      "default": "Déposer son CV"
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapitre",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Surtitre (ex. 02 · Architecture)",
          "default": "02 · Deux espaces, une identité"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre du chapitre",
          "default": "La boutique et le portail"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Texte",
          "default": "<p><strong>La boutique</strong> : e-commerce Shopify, drops limités, packaging signature autour du CV.</p><p><strong>Le portail</strong> : dépôt de CV créatif, vote communautaire, classement public — gratuit au lancement.</p><p>Les deux se renforcent : réductions liées aux votes, contenus natifs entre les profils, événements physiques.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Page Histoire / Collectif",
      "blocks": [
        {
          "type": "chapter",
          "settings": {
            "kicker": "02 · Architecture",
            "title": "Deux espaces, une identité",
            "body": "<p><strong>La boutique</strong> : e-commerce Shopify, drops limités, packaging qui raconte le CV.</p><p><strong>Le portail</strong> : dépôt de CV créatif, vote, classement public — gratuit au départ.</p><p>Les deux se répondent : engagement sur le portail, achat sur la boutique, événements qui cimentent le collectif.</p>"
          }
        },
        {
          "type": "chapter",
          "settings": {
            "kicker": "03 · Acteurs",
            "title": "Candidats, votants, recruteurs",
            "body": "<p>Les <strong>candidats</strong> exposent leur CV et peuvent être mis en avant par la communauté. Les <strong>votants</strong> participent au classement. Les <strong>recruteurs</strong> accèdent à des profils validés socialement — un signal différent des réseaux classiques.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
