{% comment %} En-tête aligné sur portail-recrutestagiaire (ParisTicker + nav plate + drawer). {% endcomment %}
{% liquid
  assign rs_p_prof = settings.rs_portail_url_profils | default: 'https://portail.recrutestagiaire.eu/profils'
  assign rs_p_dep = settings.rs_portail_url_depot | default: 'https://portail.recrutestagiaire.eu/depot'
  assign rs_p_vote = settings.rs_portail_url_vote | default: 'https://portail.recrutestagiaire.eu/swipe'
  assign rs_p_login = settings.rs_portail_url_connexion | default: 'https://portail.recrutestagiaire.eu/connexion'

  assign rs_default_logo = 'rs-logo-eu.png'
  if section.settings.brand_image != blank
    assign brand_image = section.settings.brand_image
    assign brand_image_is_asset = false
  elsif settings.logo != blank
    assign brand_image = settings.logo
    assign brand_image_is_asset = false
  else
    assign brand_image = rs_default_logo
    assign brand_image_is_asset = true
  endif

  assign c1 = section.settings.menu_cand_1_link | default: '' | strip
  if c1 == blank or c1 contains '/pages/candidatures' or c1 contains 'pages/candidatures'
    assign c1 = 'https://portail.recrutestagiaire.eu'
  endif

  assign nav_portail_lbl = section.settings.menu_cand_1_label | default: 'Portail candidats' | strip

  assign c3 = section.settings.menu_cand_3_link | default: '' | strip
  if c3 == blank
    assign c3 = rs_p_vote
  endif

  assign k1 = section.settings.menu_coll_1_link
  if k1 == blank
    assign k1 = '/pages/about'
  endif
  assign k2 = section.settings.menu_coll_2_link
  if k2 == blank
    assign k2 = '/pages/contact'
  endif

  assign cart_lbl = section.settings.cart_label | default: 'Mon dossier'

  assign nav_vote_lbl = section.settings.menu_cand_3_label | default: 'Voter' | strip

  assign brand_logo_max = section.settings.brand_max_height | default: 80
  if brand_logo_max > 200
    assign brand_logo_max = 200
  endif

  assign rs_boutique_url = section.settings.boutique_link | default: '' | strip
  if rs_boutique_url == blank
    assign rs_boutique_url = '/collections/mes-basiques-damour'
    if collections['mes-basiques-damour'] != blank
      assign rs_boutique_url = collections['mes-basiques-damour'].url
    elsif collections['les-stagiaires-de-base'] != blank
      assign rs_boutique_url = collections['les-stagiaires-de-base'].url
    endif
  endif

  if section.settings.site_title != blank
    assign rs_brand_title = section.settings.site_title
  else
    assign rs_brand_title = shop.name
  endif
  assign rs_brand_title = rs_brand_title | strip | upcase
  assign rs_brand_line_one = rs_brand_title
  assign rs_brand_line_two = ''
  assign rs_brand_parts = rs_brand_title | split: ' '
  if rs_brand_parts.size > 1
    assign rs_brand_line_one = rs_brand_parts[0]
    assign rs_brand_line_two = rs_brand_parts[1]
    for rs_brand_part in rs_brand_parts offset: 2
      assign rs_brand_line_two = rs_brand_line_two | append: ' ' | append: rs_brand_part
    endfor
  endif
%}
{%- capture rs_ticker_phrases -%}<span class="rs-ticker__phrase rs-ticker__phrase--a">I <span class="rs-ticker__heart" aria-hidden="true">❤</span> STAGIAIRE</span><span class="rs-ticker__sep">✦</span><span class="rs-ticker__phrase rs-ticker__phrase--b">MES BASIQUES D'AMOUR</span><span class="rs-ticker__sep">✦</span>{%- endcapture -%}
<div
  class="header-wrap rs-header{% if section.settings.banner_image != blank %} rs-header--banner{% endif %}"
  {% if section.settings.banner_image != blank %}
    style="--rs-header-bg-img: url('{{ section.settings.banner_image | image_url: width: 2400 }}');"
  {% endif %}
  {{ section.shopify_attributes }}>
  <div class="rs-ticker" aria-hidden="true">
    <div class="rs-ticker__viewport">
      <div class="rs-ticker__track">
        <div class="rs-ticker__group">{{ rs_ticker_phrases }}</div>
        <div class="rs-ticker__group" aria-hidden="true">{{ rs_ticker_phrases }}</div>
      </div>
    </div>
  </div>
  {%- if section.settings.show_kitsch_pop -%}
    <div
      class="rs-header-kitsch-pop rs-header-kitsch-pop--brand"
      style="--rs-kitsch-pop-a: {{ section.settings.kitsch_pop_bg_a }}; --rs-kitsch-pop-b: {{ section.settings.kitsch_pop_bg_b }}; --rs-kitsch-pop-fg: {{ section.settings.kitsch_pop_fg | default: '#f472b6' }};"
      aria-hidden="true">
      <span class="rs-header-kitsch-pop__deco rs-header-kitsch-pop__deco--a" aria-hidden="true">✦</span>
      <span class="rs-header-kitsch-pop__deco rs-header-kitsch-pop__deco--b" aria-hidden="true">✦</span>
      <div class="rs-header-kitsch-pop__track">
        <span class="rs-header-kitsch-pop__chunk">{{ section.settings.kitsch_pop_text | escape }}&nbsp;•&nbsp;</span>
        <span class="rs-header-kitsch-pop__chunk">{{ section.settings.kitsch_pop_text | escape }}&nbsp;•&nbsp;</span>
        <span class="rs-header-kitsch-pop__chunk">{{ section.settings.kitsch_pop_text | escape }}&nbsp;•&nbsp;</span>
        <span class="rs-header-kitsch-pop__chunk">{{ section.settings.kitsch_pop_text | escape }}&nbsp;•&nbsp;</span>
        <span class="rs-header-kitsch-pop__chunk">{{ section.settings.kitsch_pop_text | escape }}&nbsp;•&nbsp;</span>
        <span class="rs-header-kitsch-pop__chunk">{{ section.settings.kitsch_pop_text | escape }}&nbsp;•&nbsp;</span>
      </div>
    </div>
  {%- endif -%}
  <div class="rs-header-body">
    <div class="container">
      <header class="rs-header-two-tier" aria-label="En-tête du site">
        <div class="rs-header-mobile-bar" data-rs-header-mobile-bar>
          <a class="rs-header-mobile-bar__brand rs-ph-mbrand" href="{{ routes.root_url }}">
            {%- if brand_image != blank -%}
              <img
                class="rs-header-mobile-bar__logo"
                src="{% if brand_image_is_asset %}{{ brand_image | asset_url }}{% else %}{{ brand_image | image_url: width: 320 }}{% endif %}"
                alt=""
                width="72"
                height="72"
                loading="eager"
                decoding="async">
            {%- endif -%}
          </a>
          <a class="rs-header-mobile-bar__title" href="{{ routes.root_url }}">
            <span class="rs-header-mobile-bar__title-line">{{ rs_brand_line_one | escape }}</span>
            {%- if rs_brand_line_two != blank -%}
              <span class="rs-header-mobile-bar__title-line">{{ rs_brand_line_two | escape }}</span>
            {%- endif -%}
          </a>
          <button
            type="button"
            class="rs-header-mobile-bar__menu-btn rs-header-burger-btn"
            id="rs-header-mobile-menu-btn"
            aria-expanded="false"
            aria-controls="rs-header-drawer-panel"
            data-rs-header-drawer-open>
            <span class="visually-hidden">Ouvrir le menu</span>
            <span class="rs-header-burger" aria-hidden="true">
              <span class="rs-header-burger__line"></span>
              <span class="rs-header-burger__line"></span>
              <span class="rs-header-burger__line"></span>
            </span>
          </button>
        </div>

        <div class="rs-header-main-row rs-header-main-row--desktop">
          <div class="rs-header-top-line">
            <div class="rs-banner-top rs-header-pole-brand rs-header-pole-title">
              <a
                class="nav-brand rs-nav-brand rs-nav-brand--title-row rs-ph-brandlink text-decoration-none"
                href="{{ routes.root_url }}"
                aria-label="{{ shop.name | escape }} — Accueil">
                {%- if brand_image != blank -%}
                  <span class="rs-ph-brandlink-logo-hit">
                    <img
                      class="rs-ph-brandlink-logo"
                      src="{% if brand_image_is_asset %}{{ brand_image | asset_url }}{% else %}{{ brand_image | image_url: width: 560 }}{% endif %}"
                      alt=""
                      width="{{ brand_logo_max }}"
                      height="{{ brand_logo_max }}"
                      style="max-height: {{ brand_logo_max }}px; width: auto;"
                      loading="eager"
                      decoding="async">
                  </span>
                {%- endif -%}
                {%- if section.settings.show_site_name -%}
                  <span class="rs-ph-brandlink-title-hit">
                    <span class="rs-nav-brand__name logo rs-nav-brand__name--headline rs-ph-brandlink-title">
                      <span class="rs-ph-brandlink-title-line">{{ rs_brand_line_one | escape }}</span>
                      {%- if rs_brand_line_two != blank -%}
                        <span class="rs-ph-brandlink-title-line">{{ rs_brand_line_two | escape }}</span>
                      {%- endif -%}
                    </span>
                  </span>
                {%- else -%}
                  <span class="visually-hidden">{{ shop.name | escape }}</span>
                {%- endif -%}
              </a>
            </div>

            <nav class="rs-ph-navdesk" aria-label="Navigation principale">
              <a href="{{ rs_boutique_url }}">Boutique</a>
              <a href="{{ c1 }}" rel="noopener noreferrer">{{ nav_portail_lbl | escape }}</a>
              <a href="{{ c3 }}" rel="noopener noreferrer">{{ nav_vote_lbl | escape }}</a>
              <a href="{{ k1 }}">Le collectif</a>
            </nav>

            <div class="rs-banner-top__actions d-inline-flex align-items-center">
              <a href="{{ rs_p_dep }}" rel="noopener noreferrer" class="rs-ph-cta rs-btn--primary text-decoration-none">
                Déposer mon CV
              </a>
              <a href="{{ routes.cart_url }}" class="rs-header-ghost-link abt-btn rs-caf-btn-dossier rs-banner-top__cart d-inline-flex align-items-center gap-2 text-decoration-none text-nowrap" aria-label="{{ cart_lbl | escape }}">
                {% render 'icon-cart', w: 16, h: 16 %}
                <span class="rs-caf-btn-dossier__label">
                  <span class="rs-caf-btn-dossier__text rs-caf-btn-dossier__text--full">{{ cart_lbl }}</span>
                  <span class="rs-caf-btn-dossier__text rs-caf-btn-dossier__text--short" aria-hidden="true">Dossier</span>
                </span>
                {% if section.settings.show_cart_count and cart.item_count > 0 %}
                  <span class="rs-cart-badge">{{ cart.item_count }}</span>
                {% endif %}
              </a>

              <a href="{{ rs_p_login }}" class="rs-header-ghost-link abt-btn rs-caf-btn-dossier rs-banner-top__account d-inline-flex align-items-center gap-2 text-decoration-none text-nowrap" rel="noopener noreferrer" aria-label="Mon espace">
                <svg class="rs-icon-account" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21a8 8 0 0 0-16 0"/>
                  <path d="M12 13a4 4 0 1 0-4-4 4 4 0 0 0 4 4Z"/>
                </svg>
                <span class="rs-caf-btn-dossier__label">
                  <span class="rs-caf-btn-dossier__text rs-caf-btn-dossier__text--full">Mon espace</span>
                  <span class="rs-caf-btn-dossier__text rs-caf-btn-dossier__text--short" aria-hidden="true">Espace</span>
                </span>
              </a>
            </div>
          </div>
        </div>
      </header>
    </div>
  </div>

  <div class="rs-header-drawer" id="rs-header-drawer" data-rs-header-drawer hidden>
    <div class="rs-header-drawer__overlay" data-rs-header-drawer-close tabindex="-1" aria-hidden="true"></div>
    <div
      class="rs-header-drawer__panel"
      id="rs-header-drawer-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="rs-header-drawer-title">
      <div class="rs-header-drawer__head">
        <span class="visually-hidden" id="rs-header-drawer-title">Menu</span>
        <button type="button" class="rs-header-drawer__close" data-rs-header-drawer-close aria-label="Fermer le menu">
          <span aria-hidden="true">✕</span>
        </button>
      </div>
      <nav class="rs-header-drawer__nav" aria-label="Navigation principale">
        <div class="rs-header-drawer__section">
          <div class="rs-header-drawer__sublinks">
            <a href="{{ rs_boutique_url }}">Boutique</a>
            <a href="{{ c1 }}" rel="noopener noreferrer">{{ nav_portail_lbl | escape }}</a>
            <a href="{{ c3 }}" rel="noopener noreferrer">{{ nav_vote_lbl | escape }}</a>
            <a href="{{ k1 }}">Le collectif</a>
            <a href="{{ k2 }}">Contact</a>
          </div>
        </div>
      </nav>
      <div class="rs-header-drawer__footer">
        <div class="rs-banner-top__actions rs-header-drawer__footer-actions d-inline-flex flex-column align-items-stretch gap-2 w-100">
          <a href="{{ rs_p_dep }}" rel="noopener noreferrer" class="rs-ph-drawer-cta rs-btn--primary rs-header-drawer__caf-btn text-center text-decoration-none">
            Déposer mon CV
          </a>
          <a
            href="{{ routes.cart_url }}"
            class="rs-header-ghost-link abt-btn rs-caf-btn-dossier rs-banner-top__cart rs-header-drawer__caf-btn d-inline-flex align-items-center justify-content-center gap-2 text-decoration-none text-nowrap"
            aria-label="{{ cart_lbl | escape }}">
            {% render 'icon-cart', w: 16, h: 16 %}
            <span class="rs-caf-btn-dossier__label">
              <span class="rs-caf-btn-dossier__text rs-caf-btn-dossier__text--full">{{ cart_lbl }}</span>
              <span class="rs-caf-btn-dossier__text rs-caf-btn-dossier__text--short" aria-hidden="true">Dossier</span>
            </span>
            {% if section.settings.show_cart_count and cart.item_count > 0 %}
              <span class="rs-cart-badge">{{ cart.item_count }}</span>
            {% endif %}
          </a>
          <a
            href="{{ rs_p_login }}"
            class="rs-header-ghost-link abt-btn rs-caf-btn-dossier rs-banner-top__account rs-header-drawer__caf-btn d-inline-flex align-items-center justify-content-center gap-2 text-decoration-none text-nowrap"
            rel="noopener noreferrer"
            aria-label="Mon espace">
            <svg class="rs-icon-account" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21a8 8 0 0 0-16 0"/>
              <path d="M12 13a4 4 0 1 0-4-4 4 4 0 0 0 4 4Z"/>
            </svg>
            <span class="rs-caf-btn-dossier__label">
              <span class="rs-caf-btn-dossier__text rs-caf-btn-dossier__text--full">Mon espace</span>
              <span class="rs-caf-btn-dossier__text rs-caf-btn-dossier__text--short" aria-hidden="true">Espace</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var wrap = document.querySelector('.header-wrap');
    if (!wrap) return;
    var drawer = wrap.querySelector('[data-rs-header-drawer]');
    var openBtn = wrap.querySelector('[data-rs-header-drawer-open]');
    if (!drawer || !openBtn) return;

    var closes = drawer.querySelectorAll('[data-rs-header-drawer-close]');
    var scrollY = 0;

    function isMobileDrawer() {
      try {
        return window.matchMedia('(max-width: 899.98px)').matches;
      } catch (e) {
        return (window.innerWidth || 0) <= 899;
      }
    }

    function lockScroll() {
      scrollY = window.scrollY || window.pageYOffset || 0;
      document.documentElement.classList.add('rs-header-drawer-open');
      document.body.style.position = 'fixed';
      document.body.style.top = -scrollY + 'px';
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
    }

    function unlockScroll() {
      document.documentElement.classList.remove('rs-header-drawer-open');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      window.scrollTo(0, scrollY);
    }

    function openDrawer() {
      if (!isMobileDrawer()) return;
      drawer.removeAttribute('hidden');
      openBtn.setAttribute('aria-expanded', 'true');
      lockScroll();
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          drawer.classList.add('rs-header-drawer--open');
          var c = drawer.querySelector('.rs-header-drawer__close');
          if (c) c.focus();
        });
      });
    }

    function closeDrawer() {
      drawer.classList.remove('rs-header-drawer--open');
      openBtn.setAttribute('aria-expanded', 'false');
      unlockScroll();
      window.setTimeout(function () {
        if (!drawer.classList.contains('rs-header-drawer--open')) {
          drawer.setAttribute('hidden', '');
        }
      }, 320);
    }

    openBtn.addEventListener('click', function (e) {
      e.preventDefault();
      if (drawer.classList.contains('rs-header-drawer--open')) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });

    closes.forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        closeDrawer();
      });
    });

    drawer.querySelectorAll('.rs-header-drawer__caf-btn').forEach(function (a) {
      a.addEventListener('click', function () {
        closeDrawer();
      });
    });
    drawer.querySelectorAll('.rs-header-drawer__sublinks a').forEach(function (a) {
      a.addEventListener('click', function () {
        closeDrawer();
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('rs-header-drawer--open')) {
        closeDrawer();
        openBtn.focus();
      }
    });

    window.addEventListener(
      'resize',
      function () {
        if (!isMobileDrawer() && drawer.classList.contains('rs-header-drawer--open')) {
          closeDrawer();
        }
      },
      { passive: true }
    );
  })();
</script>

<script>
  (function () {
    var wrap = document.querySelector('.header-wrap.rs-header');
    if (!wrap) return;

    function isMobileHeader() {
      try {
        return window.matchMedia('(max-width: 899.98px)').matches;
      } catch (e) {
        return (window.innerWidth || 0) <= 899;
      }
    }

    function updateMobileMainOffset() {
      var h = wrap.offsetHeight || 0;
      if (h > 0) {
        document.documentElement.style.setProperty('--rs-portal-header-h', h + 'px');
        document.documentElement.style.setProperty('--rs-mobile-header-offset', h + 'px');
      }
    }

    function updateIndexHeaderSolid() {
      if (document.body.getAttribute('data-rs-page') !== 'index') {
        wrap.classList.remove('rs-header--scroll-solid');
        return;
      }
      var y = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;
      var threshold = 72;
      wrap.classList.toggle('rs-header--scroll-solid', y > threshold);
    }

    function onWindowScroll() {
      updateIndexHeaderSolid();
      if (!isMobileHeader()) {
        wrap.classList.remove('rs-header-mobile-fixed--scrolled');
        return;
      }
      var y = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;
      wrap.classList.toggle('rs-header-mobile-fixed--scrolled', y > 2);
    }

    function syncTickerMarquee() {
      var track = wrap.querySelector('.rs-ticker__track');
      if (!track) return;
      var group = track.querySelector('.rs-ticker__group');
      if (!group) return;
      var width = Math.round(group.getBoundingClientRect().width);
      if (width > 0) {
        track.style.setProperty('--rs-ticker-shift', width + 'px');
      }
    }

    function sync() {
      syncTickerMarquee();
      updateMobileMainOffset();
      onWindowScroll();
    }

    sync();
    window.addEventListener('resize', sync, { passive: true });
    window.addEventListener('scroll', onWindowScroll, { passive: true });

    wrap.querySelectorAll('img').forEach(function (img) {
      if (!img.complete) {
        img.addEventListener('load', updateMobileMainOffset, { passive: true });
      }
    });

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(updateMobileMainOffset).catch(function () {});
    }

    if (typeof ResizeObserver !== 'undefined') {
      try {
        var ro = new ResizeObserver(sync);
        ro.observe(wrap);
        var tickerTrack = wrap.querySelector('.rs-ticker__track');
        if (tickerTrack) {
          ro.observe(tickerTrack);
        }
      } catch (e) {}
    }
  })();
</script>

{% schema %}
{
  "name": "En-tête du site",
  "tag": "header",
  "class": "section-header",
  "settings": [
    { "type": "header", "content": "Bandeau kitsch (au-dessus du header)" },
    { "type": "checkbox", "id": "show_kitsch_pop", "label": "Afficher la 2e bande animée (sous le ticker)", "default": false },
    { "type": "text", "id": "kitsch_pop_text", "label": "Texte défilant (bandeau kitsch, optionnel)", "default": "Collectif — Paris · Profils · Vote · Dépose ton CV" },
    { "type": "color", "id": "kitsch_pop_bg_a", "label": "Fond bandeau (côté A)", "default": "#f472b6" },
    { "type": "color", "id": "kitsch_pop_bg_b", "label": "Fond bandeau (côté B)", "default": "#e8e8f0" },
    { "type": "color", "id": "kitsch_pop_fg", "label": "Couleur du texte", "default": "#f472b6" },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "brand_image", "label": "Logo (barre mobile + marque bureau)", "info": "Vide = logo thème ou image par défaut." },
    {
      "type": "range",
      "id": "brand_max_height",
      "min": 48,
      "max": 220,
      "step": 2,
      "unit": "px",
      "label": "Hauteur max logo (bureau, repère éditeur)",
      "default": 80,
      "info": "Valeur max 220 pour compatibilité avec d’anciens réglages ; l’affichage réel est plafonné par le CSS du thème."
    },
    { "type": "image_picker", "id": "banner_image", "label": "Image de fond de la bannière haute (optionnel)" },
    { "type": "header", "content": "Titre" },
    { "type": "checkbox", "id": "show_site_name", "label": "Afficher le nom du site", "default": true },
    { "type": "text", "id": "site_title", "label": "Titre personnalisé (optionnel)" },
    { "type": "header", "content": "Liens navigation (portail / pages)" },
    { "type": "url", "id": "boutique_link", "label": "Boutique — URL (collection en vente)", "info": "Vide = collection « mes-basiques-damour », puis « les-stagiaires-de-base »." },
    { "type": "text", "id": "menu_cand_1_label", "label": "Portail candidats — libellé", "default": "Portail candidats" },
    { "type": "url", "id": "menu_cand_1_link", "label": "Portail candidats — URL (vide = portail.recrutestagiaire.eu)" },
    { "type": "text", "id": "menu_cand_3_label", "label": "Lien vote / swipe — libellé", "default": "Voter" },
    { "type": "url", "id": "menu_cand_3_link", "label": "Vote — URL (vide = portail swipe)" },
