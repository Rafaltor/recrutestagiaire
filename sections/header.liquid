{% comment %} En-tête type portail : bandeau kitsch, marque + panier, onglets (Offres / Candidatures / Collectif), menus au survol. {% endcomment %}
{% liquid
  assign rs_p_prof = settings.rs_portail_url_profils | default: 'https://portail.recrutestagiaire.eu/profils'
  assign rs_p_dep = settings.rs_portail_url_depot | default: 'https://portail.recrutestagiaire.eu/depot'
  assign rs_p_vote = settings.rs_portail_url_vote | default: 'https://portail.recrutestagiaire.eu/vote'
  assign rs_p_login = settings.rs_portail_url_connexion | default: 'https://portail.recrutestagiaire.eu/connexion'

  assign rs_default_logo = 'rs-logo-eu.png'
  if section.settings.brand_image != blank
    assign brand_image = section.settings.brand_image
    assign brand_image_is_asset = false
  elsif settings.logo != blank
    assign brand_image = settings.logo
    assign brand_image_is_asset = false
  else
    assign brand_image = rs_default_logo
    assign brand_image_is_asset = true
  endif

  assign o1 = section.settings.menu_offres_1_link
  if o1 == blank
    assign o1 = '/collections/abcdrs'
  endif
  assign o2 = section.settings.menu_offres_2_link
  if o2 == blank
    assign o2 = '/collections/les-stagiaires-de-base'
  endif

  assign c1 = section.settings.menu_cand_1_link | default: '' | strip
  if c1 == blank or c1 contains '/pages/candidatures' or c1 contains 'pages/candidatures'
    assign c1 = rs_p_prof
  endif
  assign c2 = section.settings.menu_cand_2_link | default: '' | strip
  if c2 == blank
    assign c2 = rs_p_dep
  endif
  assign c3 = section.settings.menu_cand_3_link | default: '' | strip
  if c3 == blank
    assign c3 = rs_p_vote
  endif

  assign k1 = section.settings.menu_coll_1_link
  if k1 == blank
    assign k1 = '/pages/about'
  endif
  assign k2 = section.settings.menu_coll_2_link
  if k2 == blank
    assign k2 = '/pages/contact'
  endif

  assign cart_lbl = section.settings.cart_label | default: 'Mon dossier'

  assign lbl_offres = section.settings.nav_offres_label | default: 'Offres'
  assign lbl_cand = section.settings.nav_candidatures_label | default: 'Candidatures'
  assign lbl_coll = section.settings.nav_collectif_label | default: 'Le collectif'

  assign l_o1 = section.settings.menu_offres_1_label | default: 'Collection ABCDRS'
  assign l_o2 = section.settings.menu_offres_2_label | default: 'Les stagiaires de base'
  assign l_c1 = section.settings.menu_cand_1_label | default: 'Profils candidats'
  assign l_c2 = section.settings.menu_cand_2_label | default: 'Déposer sa candidature'
  assign l_c3 = section.settings.menu_cand_3_label | default: 'Voter (Swipe)'
  assign l_k1 = section.settings.menu_coll_1_label | default: 'Histoire'
  assign l_k2 = section.settings.menu_coll_2_label | default: 'Contact'

  assign rs_nav_active = 'offres'
  if template.name == 'collection' or template.name == 'product' or template.name == 'list-collections' or template.name == 'index'
    assign rs_nav_active = 'offres'
  elsif template.name == 'page'
    if page.handle == 'candidatures'
      assign rs_nav_active = 'cand'
    elsif page.handle == 'about' or page.handle == 'contact'
      assign rs_nav_active = 'coll'
    endif
  elsif template.name == 'cart' or template.name == 'search'
    assign rs_nav_active = 'offres'
  endif

  assign brand_logo_max = section.settings.brand_max_height | default: 124
  if brand_logo_max > 140
    assign brand_logo_max = 140
  endif
  assign brand_logo_inset = 14
%}
<div class="header-wrap rs-header{% if section.settings.banner_image != blank %} rs-header--banner{% endif %}"
  {% if section.settings.banner_image != blank %}
    style="--rs-header-bg-img: url('{{ section.settings.banner_image | image_url: width: 2400 }}');"
  {% endif %}
  {{ section.shopify_attributes }}>
  {%- if section.settings.show_kitsch_pop -%}
    <div
      class="rs-header-kitsch-pop rs-header-kitsch-pop--brand"
      style="--rs-kitsch-pop-a: {{ section.settings.kitsch_pop_bg_a }}; --rs-kitsch-pop-b: {{ section.settings.kitsch_pop_bg_b }}; --rs-kitsch-pop-fg: {{ section.settings.kitsch_pop_fg }};"
      aria-hidden="true">
      <span class="rs-header-kitsch-pop__deco rs-header-kitsch-pop__deco--a" aria-hidden="true">✦</span>
      <span class="rs-header-kitsch-pop__deco rs-header-kitsch-pop__deco--b" aria-hidden="true">✦</span>
      <div class="rs-header-kitsch-pop__track">
        <span class="rs-header-kitsch-pop__chunk">{{ section.settings.kitsch_pop_text | escape }}&nbsp;•&nbsp;</span>
        <span class="rs-header-kitsch-pop__chunk">{{ section.settings.kitsch_pop_text | escape }}&nbsp;•&nbsp;</span>
        <span class="rs-header-kitsch-pop__chunk">{{ section.settings.kitsch_pop_text | escape }}&nbsp;•&nbsp;</span>
        <span class="rs-header-kitsch-pop__chunk">{{ section.settings.kitsch_pop_text | escape }}&nbsp;•&nbsp;</span>
        <span class="rs-header-kitsch-pop__chunk">{{ section.settings.kitsch_pop_text | escape }}&nbsp;•&nbsp;</span>
        <span class="rs-header-kitsch-pop__chunk">{{ section.settings.kitsch_pop_text | escape }}&nbsp;•&nbsp;</span>
      </div>
    </div>
  {%- endif -%}
  <div class="rs-header-body"{% if brand_image != blank %} style="--rs-header-logo-col: {{ brand_logo_max }}px; --rs-header-logo-inset: {{ brand_logo_inset }}px;"{% endif %}>
    {%- if brand_image != blank -%}
      <a
        class="rs-header-logo-tile nav-brand rs-nav-brand"
        href="{{ routes.root_url }}"
        aria-label="{{ shop.name | escape }}">
        <img
          class="rs-nav-brand__img rs-header-logo-tile__img"
          src="{% if brand_image_is_asset %}{{ brand_image | asset_url }}{% else %}{{ brand_image | image_url: width: 400 }}{% endif %}"
          alt=""
          width="{{ brand_logo_max }}"
          height="{{ brand_logo_max }}"
          style="max-height: {{ brand_logo_max }}px; width: auto;"
          loading="eager"
          decoding="async">
      </a>
    {%- endif -%}
    <div class="container">
      <header class="rs-header-two-tier" aria-label="En-tête du site">
        {%- comment -%} Barre & menu mobile uniquement (<768px), sans impacter le desktop {%- endcomment -%}
        <div class="rs-header-mobile-bar" data-rs-header-mobile-bar>
          <a class="rs-header-mobile-bar__brand" href="{{ routes.root_url }}">
            {%- if brand_image != blank -%}
              <img
                class="rs-header-mobile-bar__logo"
                src="{% if brand_image_is_asset %}{{ brand_image | asset_url }}{% else %}{{ brand_image | image_url: width: 200 }}{% endif %}"
                alt=""
                width="36"
                height="36"
                loading="eager"
                decoding="async">
            {%- endif -%}
            <span class="rs-header-mobile-bar__title">
              {%- if section.settings.site_title != blank -%}
                {{ section.settings.site_title | upcase }}
              {%- else -%}
                {{ shop.name | upcase }}
              {%- endif -%}
            </span>
          </a>
          <button
            type="button"
            class="rs-header-mobile-bar__menu-btn"
            id="rs-header-mobile-menu-btn"
            aria-expanded="false"
            aria-controls="rs-header-drawer-panel"
            data-rs-header-drawer-open>
            <span class="visually-hidden">Ouvrir le menu</span>
            <span class="rs-header-mobile-bar__burger" aria-hidden="true"></span>
          </button>
        </div>

        <div class="rs-header-main-row rs-header-main-row--desktop">
          <div class="rs-header-top-line">
            <div class="rs-banner-top rs-header-pole-brand rs-header-pole-title">
              <a class="nav-brand rs-nav-brand rs-nav-brand--title-row" href="{{ routes.root_url }}">
              {%- if section.settings.show_site_name -%}
                <span class="rs-nav-brand__name logo rs-nav-brand__name--headline">
                  {%- if section.settings.site_title != blank -%}
                    {{ section.settings.site_title | upcase }}
                  {%- else -%}
                    {{ shop.name | upcase }}
                  {%- endif -%}
                </span>
              {%- else -%}
                <span class="visually-hidden">{{ shop.name | escape }}</span>
              {%- endif -%}
            </a>
          </div>

          <div class="rs-banner-top__actions d-inline-flex align-items-center">
            <a href="{{ routes.cart_url }}" class="abt-btn rs-caf-btn-dossier rs-banner-top__cart d-inline-flex align-items-center gap-2 text-decoration-none text-nowrap" aria-label="{{ cart_lbl | escape }}">
              {% render 'icon-folder-dossier', w: 16, h: 16 %}
              <span class="rs-caf-btn-dossier__label">
                <span class="rs-caf-btn-dossier__text rs-caf-btn-dossier__text--full">{{ cart_lbl }}</span>
                <span class="rs-caf-btn-dossier__text rs-caf-btn-dossier__text--short" aria-hidden="true">Dossier</span>
              </span>
              {% if section.settings.show_cart_count and cart.item_count > 0 %}
                <span class="rs-cart-badge">{{ cart.item_count }}</span>
              {% endif %}
            </a>

            <a href="{{ rs_p_login }}" class="abt-btn rs-caf-btn-dossier rs-banner-top__account d-inline-flex align-items-center gap-2 text-decoration-none text-nowrap" rel="noopener noreferrer" aria-label="Mon espace">
              <svg class="rs-icon-account" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21a8 8 0 0 0-16 0"/>
                <path d="M12 13a4 4 0 1 0-4-4 4 4 0 0 0 4 4Z"/>
              </svg>
              <span class="rs-caf-btn-dossier__label">
                <span class="rs-caf-btn-dossier__text rs-caf-btn-dossier__text--full">Mon espace</span>
                <span class="rs-caf-btn-dossier__text rs-caf-btn-dossier__text--short" aria-hidden="true">Espace</span>
              </span>
            </a>
          </div>
        </div>

        <div class="rs-header-tabstrip">
          <nav class="rs-banner-nav rs-header-pole-tabs" aria-label="Navigation principale">
          <ul class="rs-subnav rs-subnav--buttons" role="menubar">
            <li class="rs-subnav__item{% if rs_nav_active == 'offres' %} is-active{% endif %}">
              <button type="button" class="rs-subnav__trigger">{{ lbl_offres }}</button>
              <ul class="rs-subnav__dropdown">
                <li><a href="{{ o1 }}">{{ l_o1 }}</a></li>
                <li><a href="{{ o2 }}">{{ l_o2 }}</a></li>
              </ul>
            </li>
            <li class="rs-subnav__item{% if rs_nav_active == 'cand' %} is-active{% endif %}">
              <button type="button" class="rs-subnav__trigger">{{ lbl_cand }}</button>
              <ul class="rs-subnav__dropdown">
                <li><a href="{{ c1 }}" rel="noopener noreferrer">{{ l_c1 }}</a></li>
                <li><a href="{{ c2 }}" rel="noopener noreferrer">{{ l_c2 }}</a></li>
                <li><a href="{{ c3 }}" rel="noopener noreferrer">{{ l_c3 }}</a></li>
              </ul>
            </li>
            <li class="rs-subnav__item{% if rs_nav_active == 'coll' %} is-active{% endif %}">
              <button type="button" class="rs-subnav__trigger">{{ lbl_coll }}</button>
              <ul class="rs-subnav__dropdown">
                <li><a href="{{ k1 }}">{{ l_k1 }}</a></li>
                <li><a href="{{ k2 }}">{{ l_k2 }}</a></li>
              </ul>
            </li>
          </ul>
        </nav>
        </div>
    </header>
    </div>
  </div>

  <div class="rs-header-drawer" id="rs-header-drawer" data-rs-header-drawer hidden>
    <div class="rs-header-drawer__overlay" data-rs-header-drawer-close tabindex="-1" aria-hidden="true"></div>
    <div
      class="rs-header-drawer__panel"
      id="rs-header-drawer-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="rs-header-drawer-title">
      <div class="rs-header-drawer__head">
        <span class="visually-hidden" id="rs-header-drawer-title">Menu</span>
        <button type="button" class="rs-header-drawer__close" data-rs-header-drawer-close aria-label="Fermer le menu">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <nav class="rs-header-drawer__nav" aria-label="Navigation principale">
        <details class="rs-header-drawer__section">
          <summary class="rs-header-drawer__summary">{{ lbl_offres }}</summary>
          <div class="rs-header-drawer__sublinks">
            <a href="{{ o1 }}">{{ l_o1 }}</a>
            <a href="{{ o2 }}">{{ l_o2 }}</a>
          </div>
        </details>
        <details class="rs-header-drawer__section">
          <summary class="rs-header-drawer__summary">{{ lbl_cand }}</summary>
          <div class="rs-header-drawer__sublinks">
            <a href="{{ c1 }}" rel="noopener noreferrer">{{ l_c1 }}</a>
            <a href="{{ c2 }}" rel="noopener noreferrer">{{ l_c2 }}</a>
            <a href="{{ c3 }}" rel="noopener noreferrer">{{ l_c3 }}</a>
          </div>
        </details>
        <details class="rs-header-drawer__section">
          <summary class="rs-header-drawer__summary">{{ lbl_coll }}</summary>
          <div class="rs-header-drawer__sublinks">
            <a href="{{ k1 }}">{{ l_k1 }}</a>
            <a href="{{ k2 }}">{{ l_k2 }}</a>
          </div>
        </details>
        <hr class="rs-header-drawer__sep" />
        <a class="rs-header-drawer__flat" href="{{ routes.cart_url }}">Dossier</a>
        <a class="rs-header-drawer__flat" href="{{ rs_p_login }}" rel="noopener noreferrer">Mon espace</a>
      </nav>
    </div>
  </div>
</div>

<script>
  (function () {
    var header = document.querySelector('.header-wrap');
    if (!header) return;

    var list = header.querySelector('.rs-subnav.rs-subnav--buttons');
    if (!list) return;

    /** Tap / tactile : pas de hover fiable (téléphone, tablette, accueil « viewport bureau »). */
    function prefersTapForSubnav() {
      try {
        if (window.matchMedia('(hover: none)').matches) return true;
        if (window.matchMedia('(pointer: coarse)').matches) return true;
      } catch (e) {}
      var w = window.innerWidth || document.documentElement.clientWidth || 0;
      if (w > 0 && w <= 991.98) return true;
      var isIndex = document.body && document.body.getAttribute('data-rs-page') === 'index';
      if (isIndex && (navigator.maxTouchPoints || 0) > 0) return true;
      return false;
    }

    var _rsNavLockedY = 0;

    function lockNavScroll() {
      if (document.documentElement.getAttribute('data-rs-nav-scroll-lock') === '1') return;
      document.documentElement.setAttribute('data-rs-nav-scroll-lock', '1');
      _rsNavLockedY = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;
      document.documentElement.classList.add('rs-nav-open');
      document.body.classList.add('rs-nav-open');
      document.body.style.position = 'fixed';
      document.body.style.top = -_rsNavLockedY + 'px';
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
    }

    function unlockNavScroll() {
      if (document.documentElement.getAttribute('data-rs-nav-scroll-lock') !== '1') return;
      document.documentElement.removeAttribute('data-rs-nav-scroll-lock');
      document.documentElement.classList.remove('rs-nav-open');
      document.body.classList.remove('rs-nav-open');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      window.scrollTo(0, _rsNavLockedY);
    }

    function closeAll() {
      list.querySelectorAll('.rs-subnav__item.is-open').forEach(function (li) {
        li.classList.remove('is-open');
        var b = li.querySelector('.rs-subnav__trigger');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
      unlockNavScroll();
    }

    list.querySelectorAll('.rs-subnav__item').forEach(function (li) {
      var btn = li.querySelector('.rs-subnav__trigger');
      if (!btn) return;
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('type', 'button');

      btn.addEventListener('click', function (e) {
        if (!prefersTapForSubnav()) return;
        e.preventDefault();
        e.stopPropagation();
        var wasOpen = li.classList.contains('is-open');
        closeAll();
        if (!wasOpen) {
          li.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          lockNavScroll();
        }
      });
    });

    document.addEventListener(
      'click',
      function (e) {
        if (!prefersTapForSubnav()) return;
        if (!header.contains(e.target)) closeAll();
      },
      false
    );

    document.addEventListener('keydown', function (e) {
      if (!prefersTapForSubnav()) return;
      if (e.key === 'Escape') closeAll();
    });

    window.addEventListener('resize', function () {
      if (!prefersTapForSubnav()) closeAll();
    });
  })();
</script>

<script>
  (function () {
    var wrap = document.querySelector('.header-wrap');
    if (!wrap) return;
    var drawer = wrap.querySelector('[data-rs-header-drawer]');
    var openBtn = wrap.querySelector('[data-rs-header-drawer-open]');
    if (!drawer || !openBtn) return;

    var panel = drawer.querySelector('.rs-header-drawer__panel');
    var closes = drawer.querySelectorAll('[data-rs-header-drawer-close]');
    var scrollY = 0;

    function isMobileDrawer() {
      try {
        return window.matchMedia('(max-width: 767.98px)').matches;
      } catch (e) {
        return (window.innerWidth || 0) <= 767;
      }
    }

    function lockScroll() {
      scrollY = window.scrollY || window.pageYOffset || 0;
      document.documentElement.classList.add('rs-header-drawer-open');
      document.body.style.position = 'fixed';
      document.body.style.top = -scrollY + 'px';
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
    }

    function unlockScroll() {
      document.documentElement.classList.remove('rs-header-drawer-open');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      window.scrollTo(0, scrollY);
    }

    function openDrawer() {
      if (!isMobileDrawer()) return;
      drawer.removeAttribute('hidden');
      drawer.classList.add('rs-header-drawer--open');
      openBtn.setAttribute('aria-expanded', 'true');
      lockScroll();
      var c = drawer.querySelector('.rs-header-drawer__close');
      if (c) c.focus();
    }

    function closeDrawer() {
      drawer.classList.remove('rs-header-drawer--open');
      openBtn.setAttribute('aria-expanded', 'false');
      unlockScroll();
      window.setTimeout(function () {
        if (!drawer.classList.contains('rs-header-drawer--open')) {
          drawer.setAttribute('hidden', '');
        }
      }, 260);
    }

    openBtn.addEventListener('click', function (e) {
      e.preventDefault();
      if (drawer.classList.contains('rs-header-drawer--open')) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });

    closes.forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        closeDrawer();
      });
    });

    drawer.querySelectorAll('.rs-header-drawer__flat').forEach(function (a) {
      a.addEventListener('click', function () {
        closeDrawer();
      });
    });
    drawer.querySelectorAll('.rs-header-drawer__sublinks a').forEach(function (a) {
      a.addEventListener('click', function () {
        closeDrawer();
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('rs-header-drawer--open')) {
        closeDrawer();
        openBtn.focus();
      }
    });

    window.addEventListener(
      'resize',
      function () {
        if (!isMobileDrawer() && drawer.classList.contains('rs-header-drawer--open')) {
          closeDrawer();
        }
      },
      { passive: true }
    );
  })();
</script>

{% schema %}
{
  "name": "En-tête du site",
  "tag": "header",
  "class": "section-header",
  "settings": [
    { "type": "header", "content": "Bandeau kitsch (au-dessus du header)" },
    { "type": "checkbox", "id": "show_kitsch_pop", "label": "Afficher la bande animée", "default": true },
    { "type": "text", "id": "kitsch_pop_text", "label": "Texte défilant", "default": "★ OFFRE FLASH ★ -30% SUR VOTRE 2E CANDIDATURE — AGISSEZ VITE !!! ★" },
    { "type": "color", "id": "kitsch_pop_bg_a", "label": "Fond bandeau (côté A)", "default": "#ffe8f0" },
    { "type": "color", "id": "kitsch_pop_bg_b", "label": "Fond bandeau (côté B)", "default": "#ffd6e8" },
    { "type": "color", "id": "kitsch_pop_fg", "label": "Couleur du texte", "default": "#be185d" },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "brand_image", "label": "Logo RS (carré à gauche des onglets)", "info": "Vide = masque le carré logo. Sinon logo Identité du thème ou image ; affiché en grand dans le carré à côté des onglets (le titre reste au-dessus)." },
    { "type": "range", "id": "brand_max_height", "min": 48, "max": 200, "step": 2, "unit": "px", "label": "Hauteur max logo (colonne gauche)", "default": 124 },
    { "type": "image_picker", "id": "banner_image", "label": "Image de fond de la bannière haute" },
    { "type": "header", "content": "Titre" },
    { "type": "checkbox", "id": "show_site_name", "label": "Afficher le nom du site", "default": true },
    { "type": "text", "id": "site_title", "label": "Titre personnalisé (optionnel)" },
    { "type": "header", "content": "Menu — Offres (libellé principal + sous-liens)" },
    { "type": "text", "id": "nav_offres_label", "label": "Libellé du bouton", "default": "Offres" },
    { "type": "text", "id": "menu_offres_1_label", "label": "Sous-lien 1 — libellé", "default": "Collection ABCDRS" },
    { "type": "url", "id": "menu_offres_1_link", "label": "Sous-lien 1 — URL (vide = /collections/abcdrs)" },
    { "type": "text", "id": "menu_offres_2_label", "label": "Sous-lien 2 — libellé", "default": "Les stagiaires de base" },
    { "type": "url", "id": "menu_offres_2_link", "label": "Sous-lien 2 — URL (vide = /collections/les-stagiaires-de-base)" },
    { "type": "header", "content": "Menu — Candidatures" },
    { "type": "text", "id": "nav_candidatures_label", "label": "Libellé du bouton", "default": "Candidatures" },
    { "type": "text", "id": "menu_cand_1_label", "label": "Sous-lien 1 — libellé", "default": "Profils candidats" },
