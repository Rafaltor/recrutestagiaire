    box-shadow: none !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-ticker {
    display: none !important;
  }

  @media (min-width: 768px) {
    body.rs-home-landing-active .rs-header-mobile-bar {
      display: none !important;
    }

    body.rs-home-landing-active .rs-header-top-line {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      width: 100%;
      gap: 1rem;
    }

    body.rs-home-landing-active .rs-header-pole-brand.rs-banner-top {
      grid-column: 1;
      justify-self: start;
    }

    body.rs-home-landing-active .rs-home-header-title {
      grid-column: 2;
      justify-self: center;
      margin: 0;
      padding: 0;
      color: #fff;
      font-family: var(--font-display), var(--rs-font-display), 'Syne', sans-serif;
      font-weight: 800;
      font-size: 18px;
      line-height: 1.2;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-align: center;
      white-space: nowrap;
      text-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 1px 3px rgba(0, 0, 0, 0.45);
      pointer-events: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-home-header-title {
      color: #fff;
      -webkit-text-fill-color: #fff;
    }

    body.rs-home-landing-active .header-wrap.rs-header.rs-header--scroll-solid .rs-home-header-title {
      color: var(--accent, #f472b6);
      -webkit-text-fill-color: var(--accent, #f472b6);
      text-shadow: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-ph-brandlink-logo {
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
    }
  }

  @media (max-width: 767.98px) {
    body.rs-home-landing-active .rs-header-mobile-bar {
      display: grid !important;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      min-height: 64px;
      padding: 0 12px;
      position: relative;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__brand {
      grid-column: 1;
      justify-self: start;
      z-index: 2;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title {
      display: block !important;
      visibility: visible !important;
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
      width: max-content !important;
      max-width: calc(100% - 96px) !important;
      margin: 0 !important;
      padding: 0 !important;
      text-align: center !important;
      font-family: var(--font-display), var(--rs-font-display), 'Syne', sans-serif;
      font-weight: 800;
      font-size: clamp(11px, 3.4vw, 17px);
      letter-spacing: 0.045em;
      line-height: 1.15;
      text-transform: uppercase;
      white-space: nowrap;
      z-index: 3;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title .rs-brand-title-break {
      display: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-mobile-bar__title {
      color: #fff;
      -webkit-text-fill-color: #fff;
      text-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 1px 3px rgba(0, 0, 0, 0.45);
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-mobile-bar__logo {
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
    }
  }

  /* Header toujours lisible sur l’accueil (clavier / scroll-solid) */
  body.rs-home-landing-active .header-wrap.rs-header .rs-header-mobile-bar__title,
  body.rs-home-landing-active .header-wrap.rs-header .rs-home-header-title {
    color: #fff !important;
    -webkit-text-fill-color: #fff !important;
    text-shadow:
      0 0 14px rgba(0, 0, 0, 0.55),
      0 1px 3px rgba(0, 0, 0, 0.5) !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header .rs-header-mobile-bar__logo,
  body.rs-home-landing-active .header-wrap.rs-header .rs-ph-brandlink-logo {
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.45)) !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  body.rs-home-landing-active.rs-home-landing-input-focus .header-wrap.rs-header {
    z-index: 10000 !important;
    visibility: visible !important;
    opacity: 1 !important;
    transform: translate3d(0, 0, 0) !important;
  }

  .shopify-section.section-rs-home-landing {
    position: relative;
    isolation: isolate;
  }

  /* Vue 360 Pannellum — plein viewport ; au-dessus du scroller (scroll piloté en JS) pour touches WebGL + hotspots */
  #rs-panorama,
  #rs-panorama.rs-landing-pannellum-root,
  #rs-panorama.pnlm-container {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    max-width: 100vw;
    height: 100vh !important;
    height: 100dvh !important;
    min-height: 100vh;
    min-height: -webkit-fill-available;
    margin: 0;
    padding: 0;
    z-index: 4;
    overflow: hidden;
    box-sizing: border-box;
    pointer-events: auto;
  }

  #rs-panorama .pnlm-render-container,
  #rs-panorama.pnlm-container .pnlm-render-container {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 100% !important;
  }

  #rs-panorama .pnlm-dragfix {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
  }

  #rs-panorama canvas {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
  }

  .pnlm-about-msg,
  .pnlm-load-button,
  .pnlm-lbar,
  .pnlm-lbar-fill,
  .pnlm-lmsg {
    display: none !important;
  }

  /* Pool : slots hors écran jusqu’au montage dans Pannellum */
  .rs-pnlm-hotspot-pool {
    position: fixed;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    pointer-events: none;
  }

  /* Scroller sous le canvas : scrollLeft piloté en JS ; les gestes touchent le panorama (z-index plus haut) */
  .rs-landing-scroller {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: auto;
    overflow: hidden;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .rs-landing-scroller::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .rs-landing-scroller__track {
    position: relative;
    height: 100%;
    height: 100dvh;
  }

  .rs-landing-scene,
  .rs-landing-scene--pan-hit {
    position: relative;
    width: 100%;
    height: 100%;
    height: 100dvh;
    min-height: 100dvh;
  }

  /* Hotspots Pannellum : contenu interactif au-dessus du canvas */
  #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs {
    pointer-events: auto;
    z-index: 5;
  }

  #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs a,
  #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs button,
  #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs input,
  #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs label {
    pointer-events: auto;
  }

  #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs--form {
    width: min(320px, 82vw);
    max-width: 320px;
  }

  @media (min-width: 768px) {
    #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs--form {
      width: min(360px, 32vw);
      max-width: 360px;
    }
  }

  @media (max-width: 767.98px) {
    .rs-landing-scroller {
      overflow-x: auto;
      overflow-y: hidden;
      touch-action: none;
      overscroll-behavior-x: contain;
      overscroll-behavior-y: none;
    }

    /* Safari / WebGL : le canvas peut composer au-dessus des divs sœurs — forcer les hotspots au-dessus. */
    #rs-panorama .pnlm-render-container {
      overflow: visible;
    }

    #rs-panorama canvas {
      position: relative;
      z-index: 0;
    }

    #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs {
      position: relative;
      z-index: 30 !important;
    }

    .rs-landing-scroller__track {
      width: 400vw;
      min-width: 400vw;
    }
  }

  @media (min-width: 768px) {
    .rs-landing-scroller {
      overflow: hidden;
      touch-action: auto;
      pointer-events: none;
    }

    /* Laisser la souris atteindre le canvas Pannellum (sinon la scène transparente capte les events). */
    .rs-landing-scroller__track,
    .rs-landing-scene,
    .rs-landing-scene--pan-hit {
      pointer-events: none;
    }

    .rs-landing-scroller__track {
      width: 100vw;
      min-width: 100vw;
    }
  }

  .rs-landing-overlay__waitlist.rs-hero-video__content {
    position: relative;
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
    transform: none;
    text-align: center;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__badge {
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 12px;
    color: #0a0a0a;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .rs-landing-overlay__waitlist .rs-hero-video__badge span {
    color: #0a0a0a;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 0;
    width: 100%;
    max-width: 100%;
    height: auto;
    min-height: 0;
    padding: 7px 8px 7px 12px;
