<script>
  (function () {
    var section = document.querySelector('.rs-home-landing');
    if (!section) return;

    var scroller = section.querySelector('[data-rs-scroller]');
    var track = section.querySelector('[data-rs-track]');
    if (!scroller || !track) return;

    document.documentElement.classList.add('rs-home-landing-active');
    document.body.classList.add('rs-home-landing-active');

    var heading = section.getAttribute('data-rs-heading') || 'RECRUTE STAGIAIRE';
    var mobileMq = window.matchMedia('(max-width: 767.98px)');

    var drag = {
      active: false,
      moved: false,
      startX: 0,
      startY: 0,
      lastX: 0,
      startPitch: 0
    };

    var viewer = null;
    /* Large ; Pannellum resserre encore selon le FOV vertical (plage utile > qu’avec ±42). */
    var RS_PITCH_MIN = -90;
    var RS_PITCH_MAX = 90;
    /* hfov : plus haut = plus large (dézoom). Valeurs « classiques » Pannellum (~86–90). */
    var RS_DESKTOP_HFOV = 86;
    var RS_MOBILE_HFOV = 90;
    /* Hotspot formulaire : aligné sur RS_HS_DEFS (addMount + proximité). */
    var RS_FORM_HS_YAW = -101;
    var RS_FORM_HS_PITCH = 15;
    /* Multiplicateur « plan » (× curseur section) : gros / moyen / petit pastilles & form */
    var RS_HS_SZ_GROS = 1.22;
    var RS_HS_SZ_MOYEN = 1;
    var RS_HS_SZ_PETIT = 0.78;
    /*
      Hotspots : positions par défaut sur la sphère (yaw / pitch) + mul plan. Modifier ici uniquement.
    */
    var RS_HS_DEFS = [
      { hsId: 'rs-hs-form', domId: 'rs-pnlm-slot-waitlist', extraClass: 'rs-pnlm-hs--form', mul: RS_HS_SZ_GROS },
      { hsId: 'rs-hs-portal', domId: 'rs-pnlm-slot-portal', yaw: 166, pitch: 2, extraClass: 'rs-pnlm-hs--portal', mul: RS_HS_SZ_GROS },
      { hsId: 'rs-hs-rdv', domId: 'rs-pnlm-slot-rdv', yaw: 198, pitch: 0, extraClass: 'rs-pnlm-hs--rdv', mul: RS_HS_SZ_MOYEN },
      { hsId: 'rs-hs-kit', domId: 'rs-pnlm-slot-kit', yaw: 172, pitch: -4, extraClass: 'rs-pnlm-hs--kit', mul: RS_HS_SZ_PETIT },
      { hsId: 'rs-hs-lookbook', domId: 'rs-pnlm-slot-lookbook', yaw: 188, pitch: -10, extraClass: 'rs-pnlm-hs--lookbook', mul: RS_HS_SZ_MOYEN }
    ];
    var rsHotspotProxTimer = null;
    /* Mobile : scroll horizontal = delta yaw ; strip recentré au centre aux bords → 360° sans butée. */
    var rsMobileYawUnb = RS_FORM_HS_YAW;
    var rsLastMobileSl = -1;
    var rsSkipNextScrollDelta = false;
    var sectionRoot = document.getElementById('shopify-section-{{ section.id }}');
    var RS_HOTSPOT_PLANE = 0.82;
    if (sectionRoot && sectionRoot.dataset.rsHotspotPlanePct) {
      var pct = parseInt(sectionRoot.dataset.rsHotspotPlanePct, 10);
      if (isFinite(pct)) {
        RS_HOTSPOT_PLANE = Math.min(1.2, Math.max(0.45, pct / 100));
      }
    }

    function isMobile() {
      return mobileMq.matches;
    }

    function isUI(target) {
      if (!target) return false;
      return !!target.closest(
        '[data-rs-ui] a, [data-rs-ui] button, [data-rs-ui] input, [data-rs-ui] textarea, [data-rs-ui] select, [data-rs-ui] label'
      );
    }

    function maxScrollLeft() {
      return Math.max(0, scroller.scrollWidth - scroller.clientWidth);
    }

    function clampScroll(x) {
      return Math.min(maxScrollLeft(), Math.max(0, x));
    }

    function normalizeMobileYaw(deg) {
      var x = ((deg % 360) + 360) % 360;
      if (x > 180) x -= 360;
      return x;
    }

    function mobilePanStripRecenterAfterLayout() {
      if (!isMobile() || !viewer) return;
      var max = maxScrollLeft();
      if (max < 1) return;
      if (typeof viewer.getYaw === 'function') {
        rsMobileYawUnb = viewer.getYaw();
      }
      rsSkipNextScrollDelta = true;
      scroller.scrollLeft = max * 0.5;
      rsLastMobileSl = max * 0.5;
      try {
        viewer.setYaw(normalizeMobileYaw(rsMobileYawUnb), 0);
      } catch (eR) {}
    }

    function setupHeaderTitle() {
      var topLine = document.querySelector('.header-wrap .rs-header-top-line');
      if (!topLine || topLine.querySelector('.rs-home-header-title')) return;

      var title = document.createElement('p');
      title.className = 'rs-home-header-title';
      title.textContent = heading;
      topLine.appendChild(title);
    }

    function normalizeMobileHeaderTitle() {
      var mobileTitle = document.querySelector('.rs-header-mobile-bar__title');
      if (!mobileTitle) return;
      mobileTitle.textContent = heading;
    }

    function syncPanScroll() {
      if (isMobile()) {
        var max = maxScrollLeft();
        if (max > 0) {
          if (rsLastMobileSl < 0) {
            rsMobileYawUnb =
              viewer && typeof viewer.getYaw === 'function' ? viewer.getYaw() : RS_FORM_HS_YAW;
            rsSkipNextScrollDelta = true;
            scroller.scrollLeft = max * 0.5;
            rsLastMobileSl = max * 0.5;
          }
        } else {
          scroller.scrollLeft = 0;
        }
        syncYawFromScroll();
        return;
      }
      rsLastMobileSl = -1;
      scroller.scrollLeft = 0;
      syncYawFromScroll();
    }

    function syncYawFromScroll() {
      if (!viewer || typeof viewer.setYaw !== 'function') return;
      if (!isMobile()) return;
      var max = maxScrollLeft();
      if (max < 1) {
        viewer.setYaw(RS_FORM_HS_YAW, 0);
        return;
      }
      var sl = scroller.scrollLeft;
      if (rsSkipNextScrollDelta) {
        rsSkipNextScrollDelta = false;
        rsLastMobileSl = sl;
        try {
          viewer.setYaw(normalizeMobileYaw(rsMobileYawUnb), 0);
        } catch (eS) {}
        return;
      }
      /* Proche des bords : recentrer le strip (sans changer le yaw) pour continuer à tourner. */
      var margin = Math.max(32, max * 0.14);
      if (sl < margin || sl > max - margin) {
        rsSkipNextScrollDelta = true;
        scroller.scrollLeft = max * 0.5;
        rsLastMobileSl = max * 0.5;
        try {
          viewer.setYaw(normalizeMobileYaw(rsMobileYawUnb), 0);
        } catch (eE) {}
        return;
      }
      var dSl = sl - rsLastMobileSl;
      rsLastMobileSl = sl;
      var degPerPx = 360 / max;
      rsMobileYawUnb += dSl * degPerPx;
      try {
        viewer.setYaw(normalizeMobileYaw(rsMobileYawUnb), 0);
      } catch (eD) {}
    }

    function yawShortestDeg(fromDeg, toDeg) {
      return ((fromDeg - toDeg + 540) % 360) - 180;
    }

    function updateRsHotspotProximityUi() {
      if (!viewer || typeof viewer.getYaw !== 'function' || typeof viewer.getPitch !== 'function') {
        return;
      }
      var vy = viewer.getYaw();
      var vp = viewer.getPitch();
      for (var i = 0; i < RS_HS_DEFS.length; i++) {
        var def = RS_HS_DEFS[i];
        var slot = document.getElementById(def.domId);
        if (!slot) continue;
        var hy = def.hsId === 'rs-hs-form' ? RS_FORM_HS_YAW : def.yaw;
        var hp = def.hsId === 'rs-hs-form' ? RS_FORM_HS_PITCH : def.pitch;
        var dy = yawShortestDeg(vy, hy);
        var dp = vp - hp;
        var dist = Math.sqrt(dy * dy + dp * dp);
        /* Léger ajustement quand la vue s’aligne sur le hotspot (évite effet « tout passe au-dessus » trop marqué). */
        var near = Math.max(0, Math.min(1, 1 - dist / 55));
        var scale = 0.98 + near * 0.04;
        slot.style.setProperty('--rs-hotspot-prox-scale', scale.toFixed(4));
      }
    }

    function startRsHotspotProximityTracking() {
      if (rsHotspotProxTimer) {
        clearInterval(rsHotspotProxTimer);
        rsHotspotProxTimer = null;
      }
      updateRsHotspotProximityUi();
      rsHotspotProxTimer = window.setInterval(function () {
        if (!document.body.classList.contains('rs-home-landing-active')) {
          clearInterval(rsHotspotProxTimer);
          rsHotspotProxTimer = null;
          return;
        }
        updateRsHotspotProximityUi();
      }, 90);
    }

    function applyPannellumViewportMode() {
      if (!viewer) return;
      var m = isMobile();
      try {
        if (typeof viewer.setYawBounds === 'function') {
          viewer.setYawBounds([-180, 180]);
        }
        if (typeof viewer.setHfovBounds === 'function') {
          viewer.setHfovBounds(m ? [RS_MOBILE_HFOV, RS_MOBILE_HFOV] : [RS_DESKTOP_HFOV, RS_DESKTOP_HFOV]);
        }
        if (typeof viewer.setHfov === 'function') {
          viewer.setHfov(m ? RS_MOBILE_HFOV : RS_DESKTOP_HFOV, 0);
        }
      } catch (err) {}
      try {
        if (typeof viewer.resize === 'function') viewer.resize();
      } catch (e2) {}
    }

    function registerRsPannellumHotspots(v) {
      if (!v || typeof v.addHotSpot !== 'function') return;
      try {
        if (typeof v.removeHotSpot === 'function') {
          v.removeHotSpot('rs-hs-portal');
          v.removeHotSpot('rs-hs-form');
          v.removeHotSpot('rs-hs-rdv');
          v.removeHotSpot('rs-hs-kit');
          v.removeHotSpot('rs-hs-lookbook');
        }
      } catch (e0) {}

      function addMount(hsId, yaw, pitch, slot, extraClass, localPlaneMul) {
        if (!slot) return;
        var mul =
          typeof localPlaneMul === 'number' && isFinite(localPlaneMul) ? localPlaneMul : 1;
        v.addHotSpot({
          id: hsId,
          yaw: yaw,
          pitch: pitch,
          type: 'info',
          scale: true,
          cssClass: 'pnlm-pointer rs-pnlm-hs ' + (extraClass || ''),
          createTooltipFunc: function (wrapper) {
            var plane = RS_HOTSPOT_PLANE * mul;
            wrapper.style.setProperty('--rs-hotspot-plane', String(plane));
            if (slot.parentNode !== wrapper) wrapper.appendChild(slot);
          }
        });
      }

      /*
        Hotspots : RS_HS_DEFS (yaw/pitch + taille) ; proximité caméra → --rs-hotspot-prox-scale sur chaque slot.
        Mobile : strip de scroll centré ; yaw par deltas + recentrage → 360° infini.
      */
      for (var hi = 0; hi < RS_HS_DEFS.length; hi++) {
        var def = RS_HS_DEFS[hi];
        var yaw = def.hsId === 'rs-hs-form' ? RS_FORM_HS_YAW : def.yaw;
        var pitch = def.hsId === 'rs-hs-form' ? RS_FORM_HS_PITCH : def.pitch;
        var slotEl = document.getElementById(def.domId);
        addMount(def.hsId, yaw, pitch, slotEl, def.extraClass, def.mul);
      }
    }

    function scheduleRsPannellumHotspots(v) {
      if (!v || typeof v.on !== 'function') return;
      v.on('load', function () {
        try {
          applyPannellumViewportMode();
          syncPanScroll();
          syncYawFromScroll();
        } catch (e1) {}
        try {
          if (typeof v.resize === 'function') v.resize();
        } catch (e2) {}
        registerRsPannellumHotspots(v);
        startRsHotspotProximityTracking();
        try {
          if (typeof v.resize === 'function') v.resize();
        } catch (e3) {}
        window.requestAnimationFrame(function () {
          try {
            syncYawFromScroll();
            if (v && typeof v.resize === 'function') v.resize();
          } catch (e4) {}
        });
      });
    }

    function initPannellum() {
      if (typeof window.pannellum === 'undefined') {
        setTimeout(initPannellum, 50);
        return;
      }
      if (viewer) return;
      if (!document.getElementById('rs-panorama')) return;

      var m0 = isMobile();

      viewer = window.pannellum.viewer('rs-panorama', {
        type: 'equirectangular',
        panorama: 'https://cdn.shopify.com/s/files/1/0997/4821/7214/files/360bg.png?v=1779182961',
        autoLoad: true,
        autoRotate: 0,
        autoRotateInactivityDelay: 0,
        compass: false,
        showZoomCtrl: false,
        showFullscreenCtrl: false,
        mouseZoom: false,
        hfov: m0 ? RS_MOBILE_HFOV : RS_DESKTOP_HFOV,
        /* Vue initiale alignée sur le hotspot formulaire (même yaw/pitch que addMount rs-hs-form). */
        pitch: RS_FORM_HS_PITCH,
        yaw: RS_FORM_HS_YAW,
        minYaw: -180,
        maxYaw: 180,
        minHfov: m0 ? RS_MOBILE_HFOV : RS_DESKTOP_HFOV,
        maxHfov: m0 ? RS_MOBILE_HFOV : RS_DESKTOP_HFOV,
        minPitch: RS_PITCH_MIN,
        maxPitch: RS_PITCH_MAX,
        draggable: !isMobile(),
        touchPanSpeedCoeffFactor: 1.5
      });

      scheduleRsPannellumHotspots(viewer);

      scroller.addEventListener('scroll', syncYawFromScroll, { passive: true });

