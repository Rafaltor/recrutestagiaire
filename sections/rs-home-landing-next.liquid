{%- comment -%}
  Accueil 360° (Pannellum) : scroller large (yaw mobile sur 360°), pitch + yaw en diagonal au doigt,
  CTAs + formulaire en hotspots Pannellum (yaw/pitch) pour qu’ils suivent le fond. Prévisualisation : index.next (?view=next).
{%- endcomment -%}
{%- liquid
  assign portal_url = section.settings.portal_url | default: 'https://portail.recrutestagiaire.eu'
  assign cal_booking_url = section.settings.cal_booking_url | default: '' | strip
  if cal_booking_url == blank
    assign cal_booking_url = 'https://cal.com/recrutestagiaire-avpmen/grillz'
  endif
  assign lookbook_url = section.settings.lookbook_url | default: '' | strip
  if lookbook_url == blank
    if collections['abcdrs'] != blank
      assign lookbook_url = collections['abcdrs'].url
    else
      assign lookbook_url = '/collections/abcdrs'
    endif
  endif
  assign kit_url = section.settings.kit_url | default: '' | strip
  if kit_url == blank
    assign kit_subject = 'Kit grillz' | url_param_escape
    assign kit_url = 'mailto:' | append: shop.email | append: '?subject=' | append: kit_subject
  endif
  assign heading_text = section.settings.heading | default: 'RECRUTE STAGIAIRE'
-%}

<link rel="stylesheet" href="{{ 'pannellum.css' | asset_url }}">
<script src="{{ 'pannellum.js' | asset_url }}" defer></script>

{{ 'rs-hero-video.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap" rel="stylesheet">

<section
  class="rs-home-landing shopify-section section-rs-home-landing"
  id="shopify-section-{{ section.id }}"
  data-rs-heading="{{ heading_text | escape }}"
  data-rs-hotspot-plane-pct="{{ section.settings.hotspot_plane_scale_pct | default: 82 }}"
  {{ section.shopify_attributes }}>
  <div id="rs-panorama" class="rs-landing-pannellum-root"></div>

  <div class="rs-landing-scroller" data-rs-scroller tabindex="-1">
    <div class="rs-landing-scroller__track" data-rs-track>
      <div class="rs-landing-scene rs-landing-scene--pan-hit" aria-hidden="true"></div>
    </div>
  </div>

  {%- comment -%} Slots montés dans les hotspots Pannellum au load (coords yaw/pitch dans le JS). {%- endcomment -%}
  <div id="rs-pnlm-hotspot-pool" class="rs-pnlm-hotspot-pool" aria-hidden="true">
    <a
      id="rs-pnlm-slot-portal"
      class="rs-landing-hotspot rs-landing-hotspot--prox-ui rs-landing-hotspot--portal rs-landing-overlay__cta rs-landing-overlay__cta--pill"
      href="{{ portal_url }}"
      rel="noopener noreferrer"
      data-rs-ui>
      {{ section.settings.portal_label | default: '← LE BUREAU' | escape }}
    </a>

    <div id="rs-pnlm-slot-waitlist" class="rs-landing-hotspot rs-landing-hotspot--prox-ui rs-landing-hotspot--form" data-rs-ui>
      <div class="rs-hero-video__content rs-landing-overlay__waitlist">
        {%- form 'customer', id: 'rs-waitlist-form', class: 'rs-landing-overlay__form-inner' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,waiting-list">
          {%- if form.posted_successfully? -%}
            <p class="rs-hero-video__subtitle rs-landing-overlay__success" role="status">
              {{ section.settings.success_message | default: 'Tu es sur la liste.' | escape }}
            </p>
            <script>
              window.setTimeout(function () {
                window.location.replace({{ portal_url | json }});
              }, 1400);
            </script>
          {%- else -%}
            {%- if form.errors -%}
              <p class="rs-landing-overlay__error" role="alert">{{ form.errors | default_errors }}</p>
            {%- endif -%}

            <div class="rs-hero-video__badge">
              <span class="rs-hero-video__badge-dot"></span>
              <span>{{ section.settings.form_label | default: 'accés anticipé drop' | escape }}</span>
            </div>

            <div class="rs-hero-video__search">
              <span class="rs-hero-video__search-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="10.5" cy="10.5" r="6.25" stroke="currentColor" stroke-width="2" fill="none"/>
                  <path d="M15.2 15.2 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
                </svg>
              </span>
              <label class="visually-hidden" for="rs-waitlist-email">{{ section.settings.form_label | default: 'accés anticipé drop' | escape }}</label>
              <input
                id="rs-waitlist-email"
                class="rs-hero-video__search-input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ section.settings.email_placeholder | default: 'ton@email.com' | escape }}"
                autocomplete="email"
                required
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                {% endif %}>
              <button
                type="submit"
                class="rs-hero-video__search-btn rs-landing-search-btn--arrow"
                aria-label="{{ section.settings.submit_label | default: 'REJOINDRE' | escape }}">
                <span aria-hidden="true">→</span>
              </button>
            </div>
            <p class="rs-landing-drop-tagline">DROP - I LOVE STAGIAIRE</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <a
      id="rs-pnlm-slot-rdv"
      class="rs-landing-hotspot rs-landing-hotspot--prox-ui rs-landing-hotspot--rdv rs-landing-overlay__cta rs-landing-overlay__cta--pill"
      href="{{ cal_booking_url }}"
      target="_blank"
      rel="noopener noreferrer"
      data-rs-ui>
      {{ section.settings.rdv_label | default: 'PRENDRE RENDEZ-VOUS' | escape }}
    </a>
    <button
      type="button"
      id="rs-pnlm-slot-kit"
      class="rs-landing-hotspot rs-landing-hotspot--prox-ui rs-landing-hotspot--kit rs-landing-overlay__cta rs-landing-overlay__cta--pill"
      data-rs-ui
      aria-haspopup="dialog"
      aria-controls="rs-home-kit-overlay"
      aria-expanded="false">
      {{ section.settings.kit_postal_label | default: 'KIT POSTAL EMPREINTE' | escape }}
    </button>
    <a
      id="rs-pnlm-slot-lookbook"
      class="rs-landing-hotspot rs-landing-hotspot--prox-ui rs-landing-hotspot--lookbook rs-landing-overlay__cta rs-landing-overlay__cta--pill"
      href="{{ lookbook_url }}"
      data-rs-ui>
      {{ section.settings.lookbook_label | default: 'LOOKBOOK ABCDRS' | escape }}
    </a>
  </div>

  <div
    class="rs-landing-swipe-hint"
    id="rs-landing-swipe-hint"
    aria-hidden="true"
    aria-label="{{ section.settings.swipe_hint | default: 'Glisse pour explorer' | escape }}">
    <span class="rs-landing-swipe-hint__arrows" aria-hidden="true">← →</span>
  </div>

  <div
    class="rs-home-kit-overlay"
    id="rs-home-kit-overlay"
    data-rs-ui
    aria-hidden="true">
    <div
      class="rs-home-kit-overlay__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="rs-home-kit-overlay-kicker">
      <button type="button" class="rs-home-kit-overlay__close" aria-label="Fermer">✕</button>

      <p class="rs-home-kit-overlay__kicker" id="rs-home-kit-overlay-kicker">
        {{ section.settings.kit_overlay_kicker | default: 'KIT POSTAL EMPREINTE' | escape }}
      </p>

      <div class="rs-home-kit-overlay__body">
        {%- if section.settings.kit_overlay_body != blank -%}
          {{ section.settings.kit_overlay_body }}
        {%- else -%}
          <p>T'es pas sur Paris ?</p>
          <p>On t'envoie un kit de prise d'empreinte chez toi.</p>
          <p>
            Tu fais tes empreintes,<br>
            tu nous les renvoies,<br>
            on fabrique tes grillz à Paris.
          </p>
          <p><strong>+30 € sur le tarif choisi.</strong></p>
        {%- endif -%}
      </div>

      <a
        class="rs-home-kit-overlay__cta"
        href="{{ kit_url }}"
        {% if kit_url contains 'http' %}
          target="_blank" rel="noopener noreferrer"
        {% endif %}>
        {{ section.settings.kit_overlay_cta | default: 'COMMANDER LE KIT →' | escape }}
      </a>
    </div>
  </div>
</section>

<style>
  .section-rs-home-landing {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    min-height: 100dvh;
  }

  @media (max-width: 767.98px) {
    html.rs-home-landing-active,
    body.rs-home-landing-active {
      overflow: hidden;
      height: 100%;
      overscroll-behavior: none;
    }

    body.rs-home-landing-active > main {
      overflow: hidden;
      min-height: 100dvh;
      height: 100dvh;
    }

    .section-rs-home-landing {
      overflow: hidden;
      height: 100dvh;
      max-height: 100dvh;
    }
  }

  body.rs-home-landing-active .rs-site-footer,
  body.rs-home-landing-active footer.footer {
    display: none !important;
  }

  body.rs-home-landing-active .rs-header-mobile-bar__menu-btn,
  body.rs-home-landing-active .rs-header-burger-btn,
  body.rs-home-landing-active #rs-header-mobile-menu-btn {
    display: none !important;
  }

  body.rs-home-landing-active .rs-ticker,
  body.rs-home-landing-active .rs-header-kitsch-pop,
  body.rs-home-landing-active .rs-ph-navdesk,
  body.rs-home-landing-active .rs-banner-top__actions,
  body.rs-home-landing-active .rs-ph-brandlink-title,
  body.rs-home-landing-active .rs-ph-brandlink-title-hit,
  body.rs-home-landing-active .rs-nav-brand__name.logo {
    display: none !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header {
    z-index: 100 !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-two-tier,
  body.rs-home-landing-active .header-wrap.rs-header.rs-header--scroll-solid .rs-header-two-tier {
    background: transparent !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
    border-bottom-color: rgba(255, 255, 255, 0.12) !important;
    box-shadow: none !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-ticker {
    display: none !important;
  }

  @media (min-width: 768px) {
    body.rs-home-landing-active .rs-header-mobile-bar {
      display: none !important;
    }

    body.rs-home-landing-active .rs-header-top-line {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      width: 100%;
      gap: 1rem;
    }

    body.rs-home-landing-active .rs-header-pole-brand.rs-banner-top {
      grid-column: 1;
      justify-self: start;
    }

    body.rs-home-landing-active .rs-home-header-title {
      grid-column: 2;
      justify-self: center;
      margin: 0;
      padding: 0;
      color: #fff;
      font-family: var(--font-display), var(--rs-font-display), 'Syne', sans-serif;
      font-weight: 800;
      font-size: 18px;
      line-height: 1.2;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-align: center;
      white-space: nowrap;
      text-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 1px 3px rgba(0, 0, 0, 0.45);
      pointer-events: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-home-header-title {
      color: #fff;
      -webkit-text-fill-color: #fff;
    }

    body.rs-home-landing-active .header-wrap.rs-header.rs-header--scroll-solid .rs-home-header-title {
      color: var(--accent, #f472b6);
      -webkit-text-fill-color: var(--accent, #f472b6);
      text-shadow: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-ph-brandlink-logo {
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
    }
  }

  @media (max-width: 767.98px) {
    body.rs-home-landing-active .rs-header-mobile-bar {
      display: grid !important;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      min-height: 64px;
      padding: 0 12px;
      position: relative;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__brand {
      grid-column: 1;
      justify-self: start;
      z-index: 2;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title {
      display: block !important;
      visibility: visible !important;
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
      width: max-content !important;
      max-width: calc(100% - 96px) !important;
      margin: 0 !important;
      padding: 0 !important;
      text-align: center !important;
      font-family: var(--font-display), var(--rs-font-display), 'Syne', sans-serif;
      font-weight: 800;
      font-size: clamp(11px, 3.4vw, 17px);
      letter-spacing: 0.045em;
      line-height: 1.15;
      text-transform: uppercase;
      white-space: nowrap;
      z-index: 3;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title .rs-brand-title-break {
      display: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-mobile-bar__title {
      color: #fff;
      -webkit-text-fill-color: #fff;
      text-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 1px 3px rgba(0, 0, 0, 0.45);
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-mobile-bar__logo {
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
    }
  }

  /* Header toujours lisible sur l’accueil (clavier / scroll-solid) */
  body.rs-home-landing-active .header-wrap.rs-header .rs-header-mobile-bar__title,
  body.rs-home-landing-active .header-wrap.rs-header .rs-home-header-title {
    color: #fff !important;
    -webkit-text-fill-color: #fff !important;
    text-shadow:
      0 0 14px rgba(0, 0, 0, 0.55),
      0 1px 3px rgba(0, 0, 0, 0.5) !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header .rs-header-mobile-bar__logo,
  body.rs-home-landing-active .header-wrap.rs-header .rs-ph-brandlink-logo {
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.45)) !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  body.rs-home-landing-active.rs-home-landing-input-focus .header-wrap.rs-header {
    z-index: 10000 !important;
    visibility: visible !important;
    opacity: 1 !important;
    transform: translate3d(0, 0, 0) !important;
  }

  .shopify-section.section-rs-home-landing {
    position: relative;
    isolation: isolate;
  }

  /* Vue 360 Pannellum — plein viewport ; au-dessus du scroller (scroll piloté en JS) pour touches WebGL + hotspots */
  #rs-panorama,
  #rs-panorama.rs-landing-pannellum-root,
  #rs-panorama.pnlm-container {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    max-width: 100vw;
    height: 100vh !important;
    height: 100dvh !important;
    min-height: 100vh;
    min-height: -webkit-fill-available;
    margin: 0;
    padding: 0;
    z-index: 4;
    overflow: hidden;
    box-sizing: border-box;
    pointer-events: auto;
  }

  #rs-panorama .pnlm-render-container,
  #rs-panorama.pnlm-container .pnlm-render-container {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 100% !important;
  }

  #rs-panorama .pnlm-dragfix {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
  }

  #rs-panorama canvas {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
  }

  .pnlm-about-msg,
  .pnlm-load-button,
  .pnlm-lbar,
  .pnlm-lbar-fill,
  .pnlm-lmsg {
    display: none !important;
  }

  /* Pool : slots hors écran jusqu’au montage dans Pannellum */
  .rs-pnlm-hotspot-pool {
    position: fixed;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    pointer-events: none;
  }

  /* Scroller sous le canvas : scrollLeft piloté en JS ; les gestes touchent le panorama (z-index plus haut) */
  .rs-landing-scroller {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: auto;
    overflow: hidden;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .rs-landing-scroller::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .rs-landing-scroller__track {
    position: relative;
    height: 100%;
    height: 100dvh;
  }

  .rs-landing-scene,
  .rs-landing-scene--pan-hit {
    position: relative;
    width: 100%;
    height: 100%;
    height: 100dvh;
    min-height: 100dvh;
  }

  /* Hotspots Pannellum : contenu interactif au-dessus du canvas */
  /* --rs-hotspot-plane : échelle « dans la sphère » (réglage section + option Pannellum scale). */
  #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs {
    pointer-events: auto;
    z-index: 5;
    --rs-hotspot-plane: 1;
  }

  #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs a,
  #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs button,
  #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs input,
  #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs label {
    pointer-events: auto;
  }

  /* Échelle plan + proximité (très douce, voir updateRsHotspotProximityUi). */
  #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs > .rs-landing-hotspot--prox-ui {
    --rs-hotspot-prox-scale: 1;
    transform-origin: center center;
    transform: scale(calc(var(--rs-hotspot-plane, 1) * var(--rs-hotspot-prox-scale, 1)));
    transition: transform 0.2s ease-out;
  }

  #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs--form {
    width: min(320px, 82vw);
    max-width: 320px;
  }

  @media (min-width: 768px) {
    #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs--form {
      width: min(360px, 32vw);
      max-width: 360px;
    }
  }

  @media (max-width: 767.98px) {
    .rs-landing-scroller {
      overflow-x: auto;
      overflow-y: hidden;
      touch-action: none;
      overscroll-behavior-x: contain;
      overscroll-behavior-y: none;
    }

    /* Safari / WebGL : le canvas peut composer au-dessus des divs sœurs — forcer les hotspots au-dessus. */
    #rs-panorama .pnlm-render-container {
      overflow: visible;
    }

    #rs-panorama canvas {
      position: relative;
      z-index: 0;
    }

    #rs-panorama .pnlm-hotspot-base.rs-pnlm-hs {
      position: relative;
      z-index: 30 !important;
    }

    .rs-landing-scroller__track {
      width: 400vw;
      min-width: 400vw;
    }
  }

  @media (min-width: 768px) {
    .rs-landing-scroller {
      overflow: hidden;
      touch-action: auto;
      pointer-events: none;
    }

    /* Laisser la souris atteindre le canvas Pannellum (sinon la scène transparente capte les events). */
    .rs-landing-scroller__track,
    .rs-landing-scene,
    .rs-landing-scene--pan-hit {
      pointer-events: none;
    }

    .rs-landing-scroller__track {
      width: 100vw;
      min-width: 100vw;
    }
  }

  .rs-landing-overlay__waitlist.rs-hero-video__content {
    position: relative;
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
    transform: none;
    text-align: center;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__badge {
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 12px;
    color: #0a0a0a;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .rs-landing-overlay__waitlist .rs-hero-video__badge span {
    color: #0a0a0a;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 0;
    width: 100%;
    max-width: 100%;
    height: auto;
    min-height: 0;
    padding: 7px 8px 7px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search:focus-within {
    background: rgba(0, 0, 0, 0.52);
    border-color: rgba(255, 255, 255, 0.85);
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search-icon {
    flex: 0 0 auto;
    opacity: 1;
    color: rgba(255, 255, 255, 0.65);
    line-height: 0;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search-icon svg {
    display: block;
    width: 16px;
    height: 16px;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search input[type='email'],
  .rs-landing-overlay__waitlist .rs-hero-video__search-input {
    flex: 1 1 auto;
    min-width: 0;
    height: auto;
    min-height: 0;
    padding: 0;
    border: 0;
