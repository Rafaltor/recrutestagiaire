{%- comment -%}
  Accueil 360° (Pannellum) : scroller large (yaw mobile sur 360°), pitch + yaw en diagonal au doigt,
  CTAs + formulaire en hotspots Pannellum (yaw/pitch) pour qu’ils suivent le fond. Prévisualisation : index.next (?view=next).
{%- endcomment -%}
{%- liquid
  assign portal_url = section.settings.portal_url | default: 'https://portail.recrutestagiaire.eu'
  assign grillz_url = section.settings.grillz_url | default: '' | strip
  if grillz_url == blank
    if pages.grillz != blank
      assign grillz_url = pages.grillz.url
    else
      assign grillz_url = '/pages/grillz'
    endif
  endif
  assign heading_text = section.settings.heading | default: 'RECRUTE STAGIAIRE'
-%}

<link rel="stylesheet" href="{{ 'pannellum.css' | asset_url }}">
<script src="{{ 'pannellum.js' | asset_url }}" defer></script>

{{ 'rs-hero-video.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap" rel="stylesheet">

<section
  class="rs-home-landing shopify-section section-rs-home-landing"
  id="shopify-section-{{ section.id }}"
  data-rs-heading="{{ heading_text | escape }}"
  {{ section.shopify_attributes }}>
  <div id="rs-panorama" class="rs-landing-pannellum-root"></div>

  <div class="rs-landing-scroller" data-rs-scroller tabindex="-1">
    <div class="rs-landing-scroller__track" data-rs-track>
      <div class="rs-landing-scene rs-landing-scene--pan-hit" aria-hidden="true"></div>
    </div>
  </div>

  {%- comment -%} Slots montés dans les hotspots Pannellum au load (coords yaw/pitch dans le JS). {%- endcomment -%}
  <div id="rs-pnlm-hotspot-pool" class="rs-pnlm-hotspot-pool" aria-hidden="true">
    <a
      id="rs-pnlm-slot-portal"
      class="rs-landing-hotspot rs-landing-hotspot--portal rs-landing-overlay__cta"
      href="{{ portal_url }}"
      rel="noopener noreferrer"
      data-rs-ui>
      {{ section.settings.portal_label | default: '← LE BUREAU' | escape }}
    </a>

    <div id="rs-pnlm-slot-waitlist" class="rs-landing-hotspot rs-landing-hotspot--form" data-rs-ui>
      <div class="rs-hero-video__content rs-landing-overlay__waitlist">
        {%- form 'customer', id: 'rs-waitlist-form', class: 'rs-landing-overlay__form-inner' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,waiting-list">
          {%- if form.posted_successfully? -%}
            <p class="rs-hero-video__subtitle rs-landing-overlay__success" role="status">
              {{ section.settings.success_message | default: 'Tu es sur la liste.' | escape }}
            </p>
            <script>
              window.setTimeout(function () {
                window.location.replace({{ portal_url | json }});
              }, 1400);
            </script>
          {%- else -%}
            {%- if form.errors -%}
              <p class="rs-landing-overlay__error" role="alert">{{ form.errors | default_errors }}</p>
            {%- endif -%}

            <div class="rs-hero-video__badge">
              <span class="rs-hero-video__badge-dot"></span>
              <span>{{ section.settings.form_label | default: 'accés anticipé drop' | escape }}</span>
            </div>

            <div class="rs-hero-video__search">
              <span class="rs-hero-video__search-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="10.5" cy="10.5" r="6.25" stroke="currentColor" stroke-width="2" fill="none"/>
                  <path d="M15.2 15.2 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
                </svg>
              </span>
              <label class="visually-hidden" for="rs-waitlist-email">{{ section.settings.form_label | default: 'accés anticipé drop' | escape }}</label>
              <input
                id="rs-waitlist-email"
                class="rs-hero-video__search-input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ section.settings.email_placeholder | default: 'ton@email.com' | escape }}"
                autocomplete="email"
                required
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                {% endif %}>
              <button
                type="submit"
                class="rs-hero-video__search-btn rs-landing-search-btn--arrow"
                aria-label="{{ section.settings.submit_label | default: 'REJOINDRE' | escape }}">
                <span aria-hidden="true">→</span>
              </button>
            </div>
            <p class="rs-landing-drop-tagline">DROP - I LOVE STAGIAIRE</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <a
      id="rs-pnlm-slot-grillz"
      class="rs-landing-hotspot rs-landing-hotspot--grillz rs-landing-overlay__cta"
      href="{{ grillz_url }}"
      data-rs-ui>
      {{ section.settings.grillz_label | default: 'LE CABINET A GRILLZ →' | escape }}
    </a>
  </div>

  <div
    class="rs-landing-swipe-hint"
    id="rs-landing-swipe-hint"
    aria-hidden="true"
    aria-label="{{ section.settings.swipe_hint | default: 'Glisse pour explorer' | escape }}">
    <span class="rs-landing-swipe-hint__arrows" aria-hidden="true">← →</span>
  </div>
</section>

<style>
