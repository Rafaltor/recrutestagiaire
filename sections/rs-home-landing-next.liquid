        if (viewer && typeof viewer.resize === 'function') {
          try {
            viewer.resize();
          } catch (err) {}
        }
      }

      setTimeout(function () {
        applyPannellumViewportMode();
        syncPanScroll();
        syncYawFromScroll();
        resizeViewer();
      }, 0);
      setTimeout(resizeViewer, 150);
      setTimeout(resizeViewer, 500);
    }

    function onTouchStart(e) {
      if (!isMobile() || !e.touches || e.touches.length !== 1) return;
      if (isUI(e.target)) return;

      var t = e.touches[0];
      drag.active = true;
      drag.moved = false;
      drag.startX = t.clientX;
      drag.startY = t.clientY;
      drag.lastX = t.clientX;
      drag.startPitch =
        viewer && typeof viewer.getPitch === 'function' ? viewer.getPitch() : 0;
    }

    function onTouchMove(e) {
      if (!isMobile() || !drag.active || !e.touches || e.touches.length !== 1) return;

      var t = e.touches[0];
      var dxTotal = t.clientX - drag.startX;
      var dy = t.clientY - drag.startY;

      if (!drag.moved) {
        if (Math.abs(dxTotal) < 6 && Math.abs(dy) < 6) return;
        drag.moved = true;
      }

      e.preventDefault();

      /* Incrément : compatible avec le recentrage « 360 infini » du scroll (sinon startScroll désynchronisé). */
      var ddx = t.clientX - drag.lastX;
      drag.lastX = t.clientX;
      scroller.scrollLeft = clampScroll(scroller.scrollLeft - ddx);
      syncYawFromScroll();

      if (viewer && typeof viewer.setPitch === 'function') {
        /* Même sens que Pannellum : doigt vers le bas → pitch +. */
        var np = drag.startPitch + dy * 0.11;
        np = Math.max(RS_PITCH_MIN, Math.min(RS_PITCH_MAX, np));
        viewer.setPitch(np, 0);
      }
    }

    function onTouchEnd() {
      drag.active = false;
      drag.moved = false;
    }

    document.addEventListener(
      'touchstart',
      function (e) {
        if (!isMobile() || !e.touches || e.touches.length !== 1) return;
        if (isUI(e.target)) return;
        if (e.target.closest('.header-wrap')) return;
        onTouchStart(e);
      },
      { passive: true, capture: true }
    );

    document.addEventListener(
      'touchmove',
      function (e) {
        onTouchMove(e);
      },
      { passive: false, capture: true }
    );

    document.addEventListener('touchend', onTouchEnd, { passive: true, capture: true });
    document.addEventListener('touchcancel', onTouchEnd, { passive: true, capture: true });

    window.addEventListener('resize', function () {
      window.requestAnimationFrame(function () {
        if (isMobile()) {
          mobilePanStripRecenterAfterLayout();
        }
        syncPanScroll();
        applyPannellumViewportMode();
        if (viewer && typeof viewer.resize === 'function') {
          try {
            viewer.resize();
          } catch (err) {}
        }
      });
    });

    if (typeof mobileMq.addEventListener === 'function') {
      mobileMq.addEventListener('change', function () {
        window.requestAnimationFrame(function () {
          if (isMobile()) {
            mobilePanStripRecenterAfterLayout();
          }
          syncPanScroll();
          applyPannellumViewportMode();
          if (viewer && typeof viewer.resize === 'function') {
            try {
              viewer.resize();
            } catch (err) {}
          }
        });
      });
    }

    initPannellum();

    setupHeaderTitle();
    normalizeMobileHeaderTitle();
    syncPanScroll();

    var emailInput = section.querySelector('#rs-waitlist-email');
    var headerWrap = document.querySelector('.header-wrap.rs-header');

    function resetWindowScroll() {
      window.scrollTo(0, 0);
      if (document.documentElement.scrollTop) document.documentElement.scrollTop = 0;
      if (document.body.scrollTop) document.body.scrollTop = 0;
    }

    function stabilizeHeader() {
      if (!headerWrap) return;
      headerWrap.classList.remove('rs-header--scroll-solid');
      headerWrap.classList.remove('rs-header-mobile-fixed--scrolled');
    }

    function onFormFocus() {
      document.body.classList.add('rs-home-landing-input-focus');
      stabilizeHeader();
      resetWindowScroll();
    }

    function onFormBlur() {
      document.body.classList.remove('rs-home-landing-input-focus');
      stabilizeHeader();
      resetWindowScroll();
    }

    if (emailInput) {
      emailInput.addEventListener('focus', onFormFocus);
      emailInput.addEventListener('blur', function () {
        setTimeout(onFormBlur, 80);
      });
    }

    window.addEventListener(
      'scroll',
      function () {
        if (!document.body.classList.contains('rs-home-landing-input-focus')) return;
        resetWindowScroll();
        stabilizeHeader();
      },
      { passive: true }
    );

    if (window.visualViewport) {
      window.visualViewport.addEventListener(
        'resize',
        function () {
          if (!document.body.classList.contains('rs-home-landing-input-focus')) return;
          resetWindowScroll();
          stabilizeHeader();
        },
        { passive: true }
      );
    }

    document.addEventListener('shopify:section:load', function (ev) {
      if (ev.target && ev.target.contains && ev.target.contains(section)) {
        setupHeaderTitle();
        normalizeMobileHeaderTitle();
      }
    });

    function initSwipeHint() {
      var hint = section.querySelector('#rs-landing-swipe-hint');
      if (!hint) return;

      if (hint.parentElement !== document.body) {
        document.body.appendChild(hint);
      }

      if (!isMobile()) return;

      var dismissed = false;
      var hideTimer = null;

      function dismissHint() {
        if (dismissed) return;
        dismissed = true;
        hint.classList.remove('is-visible');
        hint.setAttribute('aria-hidden', 'true');
        if (hideTimer) window.clearTimeout(hideTimer);
        scroller.removeEventListener('scroll', onHintScroll);
      }

      function onHintScroll() {
        if (!hint.classList.contains('is-visible')) return;
        dismissHint();
      }

      function revealHint() {
        if (!isMobile() || dismissed) return;
        hint.classList.add('is-visible');
        hint.setAttribute('aria-hidden', 'false');
        scroller.addEventListener('scroll', onHintScroll, { passive: true });
        hideTimer = window.setTimeout(dismissHint, 2000);
      }

      window.setTimeout(revealHint, 600);
    }

    function initHomeKitOverlay() {
      if (window.__rsHomeKitUiInit) return;
      window.__rsHomeKitUiInit = true;

      function getOverlay() {
        return document.getElementById('rs-home-kit-overlay');
      }

      function getKitBtn() {
        return document.getElementById('rs-pnlm-slot-kit');
      }

      function openKit() {
        var overlay = getOverlay();
        if (!overlay) return;
        overlay.classList.add('is-open');
        overlay.setAttribute('aria-hidden', 'false');
        var b = getKitBtn();
        if (b) b.setAttribute('aria-expanded', 'true');
        document.documentElement.classList.add('rs-home-kit-overlay-open');
        document.body.classList.add('rs-home-kit-overlay-open');
      }

      function closeKit() {
        var overlay = getOverlay();
        if (!overlay) return;
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        var b = getKitBtn();
        if (b) b.setAttribute('aria-expanded', 'false');
        document.documentElement.classList.remove('rs-home-kit-overlay-open');
        document.body.classList.remove('rs-home-kit-overlay-open');
      }

      document.addEventListener(
        'click',
        function (e) {
          if (!document.body.classList.contains('rs-home-landing-active')) return;
          var overlay = getOverlay();
          if (!overlay) return;

          var kitBtn = e.target.closest && e.target.closest('#rs-pnlm-slot-kit');
          if (kitBtn) {
            e.preventDefault();
            e.stopPropagation();
            openKit();
            return;
          }

          if (e.target.closest && e.target.closest('.rs-home-kit-overlay__close')) {
            e.preventDefault();
            e.stopPropagation();
            closeKit();
            return;
          }

          if (e.target === overlay && overlay.classList.contains('is-open')) {
            closeKit();
          }
        },
        true
      );

      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        var overlay = getOverlay();
        if (!overlay || !overlay.classList.contains('is-open')) return;
        closeKit();
      });
    }

    initHomeKitOverlay();
    initSwipeHint();
  })();
</script>

