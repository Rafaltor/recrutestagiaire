    height: 16px;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search input[type='email'],
  .rs-landing-overlay__waitlist .rs-hero-video__search-input {
    flex: 1 1 auto;
    min-width: 0;
    height: auto;
    min-height: 0;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    font-size: clamp(12px, 3.45vw, 14.5px);
    letter-spacing: 0.06em;
    color: #fff;
    outline: none;
    box-shadow: none;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search input[type='email']::placeholder {
    color: rgba(255, 255, 255, 0.5);
    font-weight: 600;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: auto;
    min-height: auto;
    margin: 0;
    padding: 4px 6px !important;
    border-radius: 0 !important;
    border: 0 !important;
    background: transparent !important;
    color: #fff !important;
    font-family: 'Syne', sans-serif !important;
    font-size: clamp(14px, 3.8vw, 16px) !important;
    font-weight: 600 !important;
    letter-spacing: 0.08em;
    line-height: 1;
    cursor: pointer;
    box-shadow: none !important;
    transition: opacity 0.2s ease;
  }

  .rs-landing-overlay__waitlist .rs-landing-search-btn--arrow {
    padding: 4px 6px !important;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search-btn:hover,
  .rs-landing-overlay__waitlist .rs-hero-video__search-btn:focus-visible {
    background: transparent !important;
    border-color: transparent !important;
    color: #fff !important;
    opacity: 0.75;
    text-decoration: none !important;
  }

  .rs-landing-drop-tagline {
    margin: 14px auto 0;
    padding: 0;
    width: max-content;
    max-width: none;
    white-space: nowrap;
    overflow: visible;
    font-family: var(--font-display), var(--rs-font-display), 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(13px, 3.8vw, 17px);
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    color: #fff;
    text-shadow:
      0 0 14px rgba(0, 0, 0, 0.45),
      0 1px 3px rgba(0, 0, 0, 0.4);
  }

  .rs-landing-hotspot--form,
  .rs-landing-overlay__waitlist {
    overflow: visible;
  }

  .rs-landing-overlay__form-inner {
    width: 100%;
    margin: 0;
  }

  .rs-landing-overlay__success {
    margin: 0;
    color: #fff;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 15px;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
  }

  .rs-landing-overlay__error {
    margin: 0 0 10px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12px;
    color: #ffb4b4;
    background: rgba(80, 0, 0, 0.35);
    border: 1px solid rgba(255, 120, 120, 0.35);
    text-align: center;
  }

  /* Boutons pilule — portail / cabinet grillz */
  .rs-home-landing a.rs-landing-overlay__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    padding: 4px 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    background: rgba(0, 0, 0, 0.35);
    color: #fff !important;
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    font-size: clamp(12px, 3.45vw, 14.5px);
    letter-spacing: 0.14em;
    text-decoration: none !important;
    text-transform: uppercase;
    white-space: nowrap;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .rs-home-landing a.rs-landing-overlay__cta:hover,
  .rs-home-landing a.rs-landing-overlay__cta:focus-visible {
    background: rgba(0, 0, 0, 0.52);
    border-color: rgba(255, 255, 255, 0.85);
    color: #fff !important;
    text-decoration: none !important;
  }

  .rs-landing-swipe-hint {
    position: fixed;
    left: 50%;
    bottom: max(18%, calc(12px + env(safe-area-inset-bottom, 0px)));
    z-index: 150;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 8px);
    transition:
      opacity 0.35s ease,
      visibility 0.35s ease,
      transform 0.35s ease;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .rs-landing-swipe-hint.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .rs-landing-swipe-hint__arrows {
    font-family: var(--rs-font-display), var(--font-display), 'Syne', sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.28em;
    animation: rs-swipe-hint-pulse 1s ease-in-out infinite alternate;
  }

  @keyframes rs-swipe-hint-pulse {
    from {
      opacity: 0.55;
      transform: translateX(-3px);
    }
    to {
      opacity: 1;
      transform: translateX(3px);
    }
  }

  @media (min-width: 768px) {
    .rs-landing-swipe-hint {
      display: none !important;
    }
  }
</style>

<script>
  (function () {
    var section = document.querySelector('.rs-home-landing');
    if (!section) return;

    var scroller = section.querySelector('[data-rs-scroller]');
    var track = section.querySelector('[data-rs-track]');
    if (!scroller || !track) return;

    document.documentElement.classList.add('rs-home-landing-active');
    document.body.classList.add('rs-home-landing-active');

    var heading = section.getAttribute('data-rs-heading') || 'RECRUTE STAGIAIRE';
    var mobileMq = window.matchMedia('(max-width: 767.98px)');

    var drag = {
      active: false,
      moved: false,
      startX: 0,
      startY: 0,
      startScroll: 0,
      startPitch: 0
    };

    var viewer = null;
    /* Large ; Pannellum resserre encore selon le FOV vertical (plage utile > qu’avec ±42). */
    var RS_PITCH_MIN = -90;
    var RS_PITCH_MAX = 90;
    /*
      Desktop : hfov un peu plus bas que le mobile pour un peu plus de marge pitch (clamp interne Pannellum).
      Yaw : même plage complète que le mobile (-180 / 180) pour pouvoir tourner dans la pièce à la souris.
    */
    var RS_DESKTOP_HFOV = 72;

    function isMobile() {
      return mobileMq.matches;
    }

    function isUI(target) {
      if (!target) return false;
      return !!target.closest(
        '[data-rs-ui] a, [data-rs-ui] button, [data-rs-ui] input, [data-rs-ui] textarea, [data-rs-ui] select, [data-rs-ui] label'
      );
    }

    function maxScrollLeft() {
      return Math.max(0, scroller.scrollWidth - scroller.clientWidth);
    }

    function clampScroll(x) {
      return Math.min(maxScrollLeft(), Math.max(0, x));
    }

    function setupHeaderTitle() {
      var topLine = document.querySelector('.header-wrap .rs-header-top-line');
      if (!topLine || topLine.querySelector('.rs-home-header-title')) return;

      var title = document.createElement('p');
      title.className = 'rs-home-header-title';
      title.textContent = heading;
      topLine.appendChild(title);
    }

    function normalizeMobileHeaderTitle() {
      var mobileTitle = document.querySelector('.rs-header-mobile-bar__title');
      if (!mobileTitle) return;
      mobileTitle.textContent = heading;
    }

    function syncPanScroll() {
      if (isMobile()) {
        var max = maxScrollLeft();
        scroller.scrollLeft = max > 0 ? max / 2 : 0;
        syncYawFromScroll();
        return;
      }
      scroller.scrollLeft = 0;
      syncYawFromScroll();
    }

    function syncYawFromScroll() {
      if (!viewer || typeof viewer.setYaw !== 'function') return;
      if (!isMobile()) return;
      var max = maxScrollLeft();
      if (max < 1) {
        viewer.setYaw(180, 0);
        return;
      }
      var t = scroller.scrollLeft / max;
      /* 360° sur toute la largeur scrollable ; t=0.5 → 180° (comme l’ancien centre). */
      var yawDeg = 180 + (t - 0.5) * 360;
      viewer.setYaw(yawDeg, 0);
    }

    function applyPannellumViewportMode() {
      if (!viewer) return;
      var m = isMobile();
      try {
        if (typeof viewer.setYawBounds === 'function') {
          viewer.setYawBounds([-180, 180]);
        }
        if (typeof viewer.setHfovBounds === 'function') {
          viewer.setHfovBounds(m ? [90, 90] : [RS_DESKTOP_HFOV, RS_DESKTOP_HFOV]);
        }
        if (typeof viewer.setHfov === 'function') {
          viewer.setHfov(m ? 90 : RS_DESKTOP_HFOV, 0);
        }
      } catch (err) {}
      try {
        if (typeof viewer.resize === 'function') viewer.resize();
      } catch (e2) {}
    }

    function registerRsPannellumHotspots(v) {
      if (!v || typeof v.addHotSpot !== 'function') return;
      try {
        if (typeof v.removeHotSpot === 'function') {
          v.removeHotSpot('rs-hs-portal');
          v.removeHotSpot('rs-hs-form');
          v.removeHotSpot('rs-hs-grillz');
        }
      } catch (e0) {}

      var portal = document.getElementById('rs-pnlm-slot-portal');
      var waitlist = document.getElementById('rs-pnlm-slot-waitlist');
      var grillz = document.getElementById('rs-pnlm-slot-grillz');

      function addMount(hsId, yaw, pitch, slot, extraClass) {
        if (!slot) return;
        v.addHotSpot({
          id: hsId,
          yaw: yaw,
          pitch: pitch,
          type: 'info',
          cssClass: 'pnlm-pointer rs-pnlm-hs ' + (extraClass || ''),
          createTooltipFunc: function (wrapper) {
            if (slot.parentNode !== wrapper) wrapper.appendChild(slot);
          }
        });
      }

      /* Yaw / pitch dans la texture 360° (voisin de la vue initiale ~180° / -180° pour rester dans l’arc desktop). */
      addMount('rs-hs-portal', -205, 5, portal, 'rs-pnlm-hs--portal');
      addMount('rs-hs-form', -178, -2, waitlist, 'rs-pnlm-hs--form');
      addMount('rs-hs-grillz', -150, -18, grillz, 'rs-pnlm-hs--grillz');
    }

    function scheduleRsPannellumHotspots(v) {
      if (!v || typeof v.on !== 'function') return;
      v.on('load', function () {
        try {
          applyPannellumViewportMode();
          syncPanScroll();
          syncYawFromScroll();
        } catch (e1) {}
        try {
          if (typeof v.resize === 'function') v.resize();
        } catch (e2) {}
        registerRsPannellumHotspots(v);
        try {
          if (typeof v.resize === 'function') v.resize();
        } catch (e3) {}
        window.requestAnimationFrame(function () {
          try {
            syncYawFromScroll();
            if (v && typeof v.resize === 'function') v.resize();
          } catch (e4) {}
        });
      });
    }

    function initPannellum() {
      if (typeof window.pannellum === 'undefined') {
        setTimeout(initPannellum, 50);
        return;
      }
      if (viewer) return;
      if (!document.getElementById('rs-panorama')) return;

      var m0 = isMobile();

      viewer = window.pannellum.viewer('rs-panorama', {
        type: 'equirectangular',
        panorama: 'https://cdn.shopify.com/s/files/1/0997/4821/7214/files/360bg.png?v=1779182961',
        autoLoad: true,
        autoRotate: 0,
        autoRotateInactivityDelay: 0,
        compass: false,
        showZoomCtrl: false,
        showFullscreenCtrl: false,
        mouseZoom: false,
        hfov: m0 ? 90 : RS_DESKTOP_HFOV,
        pitch: 0,
        yaw: 180,
        minYaw: -180,
        maxYaw: 180,
        minHfov: m0 ? 90 : RS_DESKTOP_HFOV,
        maxHfov: m0 ? 90 : RS_DESKTOP_HFOV,
        minPitch: RS_PITCH_MIN,
        maxPitch: RS_PITCH_MAX,
        draggable: !isMobile(),
        touchPanSpeedCoeffFactor: 1.5
      });

      scheduleRsPannellumHotspots(viewer);

      scroller.addEventListener('scroll', syncYawFromScroll, { passive: true });

      function resizeViewer() {
        if (viewer && typeof viewer.resize === 'function') {
          try {
            viewer.resize();
          } catch (err) {}
        }
      }

      setTimeout(function () {
        applyPannellumViewportMode();
        syncPanScroll();
        syncYawFromScroll();
        resizeViewer();
      }, 0);
      setTimeout(resizeViewer, 150);
      setTimeout(resizeViewer, 500);
    }

    function onTouchStart(e) {
      if (!isMobile() || !e.touches || e.touches.length !== 1) return;
      if (isUI(e.target)) return;

      var t = e.touches[0];
      drag.active = true;
      drag.moved = false;
      drag.startX = t.clientX;
      drag.startY = t.clientY;
      drag.startScroll = scroller.scrollLeft;
      drag.startPitch =
        viewer && typeof viewer.getPitch === 'function' ? viewer.getPitch() : 0;
    }

    function onTouchMove(e) {
      if (!isMobile() || !drag.active || !e.touches || e.touches.length !== 1) return;

      var t = e.touches[0];
      var dx = t.clientX - drag.startX;
      var dy = t.clientY - drag.startY;

      if (!drag.moved) {
        if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return;
        drag.moved = true;
      }

      e.preventDefault();

      scroller.scrollLeft = clampScroll(drag.startScroll - dx);
      syncYawFromScroll();

      if (viewer && typeof viewer.setPitch === 'function') {
        /* Même sens que Pannellum : doigt vers le bas → pitch +. */
        var np = drag.startPitch + dy * 0.11;
        np = Math.max(RS_PITCH_MIN, Math.min(RS_PITCH_MAX, np));
        viewer.setPitch(np, 0);
      }
    }

    function onTouchEnd() {
      drag.active = false;
      drag.moved = false;
    }

    document.addEventListener(
      'touchstart',
      function (e) {
        if (!isMobile() || !e.touches || e.touches.length !== 1) return;
        if (isUI(e.target)) return;
        if (e.target.closest('.header-wrap')) return;
        onTouchStart(e);
      },
      { passive: true, capture: true }
    );

    document.addEventListener(
      'touchmove',
      function (e) {
        onTouchMove(e);
      },
      { passive: false, capture: true }
    );

    document.addEventListener('touchend', onTouchEnd, { passive: true, capture: true });
    document.addEventListener('touchcancel', onTouchEnd, { passive: true, capture: true });

    window.addEventListener('resize', function () {
      syncPanScroll();
      applyPannellumViewportMode();
      if (viewer && typeof viewer.resize === 'function') {
        try {
          viewer.resize();
        } catch (err) {}
      }
    });

    if (typeof mobileMq.addEventListener === 'function') {
      mobileMq.addEventListener('change', function () {
        syncPanScroll();
        applyPannellumViewportMode();
        if (viewer && typeof viewer.resize === 'function') {
          try {
            viewer.resize();
          } catch (err) {}
        }
      });
    }

    initPannellum();

    setupHeaderTitle();
    normalizeMobileHeaderTitle();
    syncPanScroll();

    var emailInput = section.querySelector('#rs-waitlist-email');
    var headerWrap = document.querySelector('.header-wrap.rs-header');

    function resetWindowScroll() {
      window.scrollTo(0, 0);
      if (document.documentElement.scrollTop) document.documentElement.scrollTop = 0;
      if (document.body.scrollTop) document.body.scrollTop = 0;
    }

    function stabilizeHeader() {
      if (!headerWrap) return;
      headerWrap.classList.remove('rs-header--scroll-solid');
      headerWrap.classList.remove('rs-header-mobile-fixed--scrolled');
    }

    function onFormFocus() {
      document.body.classList.add('rs-home-landing-input-focus');
      stabilizeHeader();
      resetWindowScroll();
    }

    function onFormBlur() {
      document.body.classList.remove('rs-home-landing-input-focus');
      stabilizeHeader();
      resetWindowScroll();
    }

    if (emailInput) {
      emailInput.addEventListener('focus', onFormFocus);
      emailInput.addEventListener('blur', function () {
        setTimeout(onFormBlur, 80);
      });
    }

    window.addEventListener(
      'scroll',
      function () {
        if (!document.body.classList.contains('rs-home-landing-input-focus')) return;
        resetWindowScroll();
        stabilizeHeader();
      },
      { passive: true }
    );

    if (window.visualViewport) {
      window.visualViewport.addEventListener(
        'resize',
        function () {
          if (!document.body.classList.contains('rs-home-landing-input-focus')) return;
          resetWindowScroll();
          stabilizeHeader();
        },
        { passive: true }
      );
    }

    document.addEventListener('shopify:section:load', function (ev) {
      if (ev.target && ev.target.contains && ev.target.contains(section)) {
        setupHeaderTitle();
        normalizeMobileHeaderTitle();
      }
    });

    function initSwipeHint() {
      var hint = section.querySelector('#rs-landing-swipe-hint');
      if (!hint) return;

      if (hint.parentElement !== document.body) {
        document.body.appendChild(hint);
      }

      if (!isMobile()) return;

      var dismissed = false;
      var hideTimer = null;

      function dismissHint() {
        if (dismissed) return;
        dismissed = true;
        hint.classList.remove('is-visible');
        hint.setAttribute('aria-hidden', 'true');
        if (hideTimer) window.clearTimeout(hideTimer);
        scroller.removeEventListener('scroll', onHintScroll);
      }

      function onHintScroll() {
        if (!hint.classList.contains('is-visible')) return;
        dismissHint();
      }

      function revealHint() {
        if (!isMobile() || dismissed) return;
        hint.classList.add('is-visible');
        hint.setAttribute('aria-hidden', 'false');
        scroller.addEventListener('scroll', onHintScroll, { passive: true });
        hideTimer = window.setTimeout(dismissHint, 2000);
      }

      window.setTimeout(revealHint, 600);
    }

    initSwipeHint();
  })();
</script>

