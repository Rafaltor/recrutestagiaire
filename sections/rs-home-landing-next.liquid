  .rs-landing-overlay-root button,
  .rs-landing-overlay-root input,
  .rs-landing-overlay-root label,
  .rs-landing-overlay-root textarea,
  .rs-landing-overlay-root select {
    pointer-events: auto;
  }

  .rs-landing-hotspot {
    position: absolute;
    z-index: 1;
  }

  .rs-landing-hotspot--portal {
    left: 20%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .rs-landing-hotspot--form {
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(320px, 82vw);
    max-width: 320px;
  }

  .rs-landing-hotspot--grillz {
    top: 80%;
    right: 20%;
    bottom: auto;
    transform: translate(50%, -50%);
  }

  @media (min-width: 768px) {
    .rs-landing-hotspot--form {
      width: min(360px, 32vw);
      max-width: 360px;
    }
  }

  .rs-landing-overlay__waitlist.rs-hero-video__content {
    position: relative;
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
    transform: none;
    text-align: center;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__badge {
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 12px;
    color: #0a0a0a;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .rs-landing-overlay__waitlist .rs-hero-video__badge span {
    color: #0a0a0a;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 0;
    width: 100%;
    max-width: 100%;
    height: auto;
    min-height: 0;
    padding: 7px 8px 7px 12px;
    border-radius: 999px;
