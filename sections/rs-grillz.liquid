{%- liquid
  assign bg = section.settings.background_image
  assign heading_text = section.settings.heading | default: 'RECRUTE STAGIAIRE'
  assign cal_link = section.settings.cal_link | default: 'recrutestagiaire-avpmen/grillz' | strip
  assign cal_booking_url = section.settings.cal_booking_url | default: '' | strip
  if cal_booking_url == blank
    assign cal_booking_url = 'https://cal.com/' | append: cal_link
  endif
  if cal_booking_url contains '?'
    assign cal_embed_url = cal_booking_url | append: '&embed=true'
  else
    assign cal_embed_url = cal_booking_url | append: '?embed=true'
  endif
  assign home_url = routes.root_url
  assign kit_url = section.settings.kit_url | default: '' | strip
  if kit_url == blank
    assign kit_subject = 'Kit grillz' | url_param_escape
    assign kit_url = 'mailto:' | append: shop.email | append: '?subject=' | append: kit_subject
  endif
-%}

<section
  class="rs-grillz-landing rs-home-landing shopify-section section-rs-grillz-landing"
  id="shopify-section-{{ section.id }}"
  data-rs-heading="{{ heading_text | escape }}"
  data-rs-cal-url="{{ cal_booking_url | escape }}"
  data-rs-kit-url="{{ kit_url | escape }}"
  {{ section.shopify_attributes }}>
  <div class="rs-landing-scroller" data-rs-scroller tabindex="-1">
    <div class="rs-landing-scroller__track" data-rs-track>
      <div class="rs-landing-scene">
        {%- if bg != blank -%}
          {{
            bg
            | image_url: width: 3840
            | image_tag:
              class: 'rs-landing-bg',
              widths: '750, 1100, 1500, 1920, 2400, 3200, 3840',
              sizes: '250vw',
              loading: 'eager',
              alt: ''
          }}
        {%- else -%}
          <img
            class="rs-landing-bg"
            src="{{ 'dentist.png' | asset_url }}"
            alt=""
            width="2400"
            height="1600"
            loading="eager"
            decoding="async">
        {%- endif -%}

        <div class="rs-landing-hotspots" data-rs-ui>
          <a
            class="rs-landing-hotspot rs-grillz-hotspot--atelier rs-landing-overlay__cta"
            href="{{ home_url }}">
            {{ section.settings.atelier_label | default: "← L'ATELIER" | escape }}
          </a>

          <div class="rs-landing-hotspot rs-grillz-hotspot--rdv">
            <button
              type="button"
              class="rs-landing-overlay__cta rs-grillz-rdv-btn"
              aria-label="{{ section.settings.rdv_label | default: 'PRENDRE RENDEZ-VOUS' | escape }}">
              {{ section.settings.rdv_label | default: 'PRENDRE RENDEZ-VOUS' | escape }}
            </button>
          </div>

          <button
            type="button"
            class="rs-landing-hotspot rs-grillz-hotspot--kit rs-landing-overlay__cta rs-grillz-kit-btn"
            aria-label="{{ section.settings.kit_label | default: 'KIT POSTAL EMPREINTE' | escape }}">
            {{ section.settings.kit_label | default: 'KIT POSTAL EMPREINTE' | escape }}
          </button>
        </div>
      </div>
    </div>
  </div>
  <div class="rs-grillz-overlay rs-grillz-overlay--rdv" id="rs-grillz-overlay" aria-hidden="true">
    <div
      class="rs-grillz-overlay__panel rs-grillz-overlay__panel--cal"
      role="dialog"
      aria-modal="true"
      aria-label="Prendre rendez-vous">
      <button type="button" class="rs-grillz-overlay__close" aria-label="Fermer">✕</button>

      <p class="rs-grillz-overlay__kicker">
        {{ section.settings.overlay_kicker | default: 'PRENDRE RENDEZ-VOUS' | escape }}
      </p>

      <div class="rs-grillz-cal-embed">
        <iframe
          class="rs-grillz-cal-embed__frame"
          title="Calendrier de réservation"
          data-src="{{ cal_embed_url | escape }}"
          loading="lazy"
          allow="payment *; clipboard-write"
          referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
    </div>
  </div>

  <div class="rs-grillz-kit-overlay" id="rs-grillz-kit-overlay" aria-hidden="true">
    <div
      class="rs-grillz-overlay__panel rs-grillz-kit-overlay__panel rs-grillz-kit-overlay__panel--light"
      role="dialog"
      aria-modal="true"
      aria-label="Kit postal empreinte">
      <button type="button" class="rs-grillz-overlay__close rs-grillz-kit-close" aria-label="Fermer">✕</button>

      <p class="rs-grillz-overlay__kicker rs-grillz-kit-overlay__kicker">
        {{ section.settings.kit_overlay_kicker | default: 'KIT POSTAL EMPREINTE' | escape }}
      </p>

      <div class="rs-grillz-overlay__text rs-grillz-overlay__body">
        {%- if section.settings.kit_overlay_body != blank -%}
          {{ section.settings.kit_overlay_body }}
        {%- else -%}
          <p>T'es pas sur Paris ?</p>
          <p>On t'envoie un kit de prise d'empreinte chez toi.</p>
          <p>
            Tu fais tes empreintes,<br>
            tu nous les renvoies,<br>
            on fabrique tes grillz à Paris.
          </p>
          <p><strong>+30 € sur le tarif choisi.</strong></p>
        {%- endif -%}
      </div>

      <a
        class="rs-grillz-overlay__cta rs-grillz-kit-overlay__cta"
        href="{{ kit_url }}"
        {% if kit_url contains 'http' %}
          target="_blank" rel="noopener noreferrer"
        {% endif %}>
        {{ section.settings.kit_overlay_cta | default: 'COMMANDER LE KIT →' | escape }}
      </a>
    </div>
  </div>
</section>

<style>
