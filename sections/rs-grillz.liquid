    box-sizing: border-box;
  }

  .rs-grillz-kit-overlay.is-open {
    display: flex !important;
  }
</style>

<script>
  (function () {
    var section = document.querySelector('.rs-grillz-landing');
    if (!section) return;

    var scroller = section.querySelector('[data-rs-scroller]');
    if (!scroller) return;

    document.documentElement.classList.add('rs-home-landing-active', 'rs-grillz-landing-active');
    document.body.classList.add('rs-home-landing-active', 'rs-grillz-landing-active');

    var heading = section.getAttribute('data-rs-heading') || 'RECRUTE STAGIAIRE';
    var mobileMq = window.matchMedia('(max-width: 767.98px)');

    var drag = {
      active: false,
      startX: 0,
      startY: 0,
      startScroll: 0,
      lock: null
    };

    function isMobile() {
      return mobileMq.matches;
    }

    function isUI(target) {
      if (!target) return false;
      return !!target.closest('[data-rs-ui] a, [data-rs-ui] button');
    }

    function maxScrollLeft() {
      return Math.max(0, scroller.scrollWidth - scroller.clientWidth);
    }

    function clampScroll(x) {
      return Math.min(maxScrollLeft(), Math.max(0, x));
    }

    function setupHeaderTitle() {
      var topLine = document.querySelector('.header-wrap .rs-header-top-line');
      if (!topLine || topLine.querySelector('.rs-home-header-title')) return;
      var title = document.createElement('p');
      title.className = 'rs-home-header-title';
      title.textContent = heading;
      topLine.appendChild(title);
    }

    function normalizeMobileHeaderTitle() {
      var mobileTitle = document.querySelector('.rs-header-mobile-bar__title');
      if (!mobileTitle) return;
      mobileTitle.textContent = heading;
    }

    function resetDesktopScroll() {
      if (isMobile()) return;
      scroller.scrollLeft = 0;
    }

    function onTouchStart(e) {
      if (!isMobile() || !e.touches || e.touches.length !== 1) return;
      if (isUI(e.target)) return;
      drag.lock = null;
      if (e.target.closest('[data-rs-scroller]')) {
        drag.active = false;
        return;
      }
      var t = e.touches[0];
      drag.active = true;
      drag.startX = t.clientX;
      drag.startY = t.clientY;
      drag.startScroll = scroller.scrollLeft;
    }

    function onTouchMove(e) {
      if (!isMobile() || !drag.active || !e.touches || e.touches.length !== 1) return;
      var t = e.touches[0];
      var dx = t.clientX - drag.startX;
      var adx = Math.abs(dx);
      var ady = Math.abs(t.clientY - drag.startY);
      if (drag.lock === null && (adx > 6 || ady > 6)) {
        drag.lock = adx > ady ? 'x' : 'y';
      }
      if (drag.lock === 'y') {
        drag.active = false;
        return;
      }
      if (drag.lock === 'x') {
        e.preventDefault();
        scroller.scrollLeft = clampScroll(drag.startScroll - dx);
      }
    }

    function onTouchEnd() {
      drag.active = false;
      drag.lock = null;
    }

    document.addEventListener(
      'touchstart',
      function (e) {
        if (!isMobile() || !e.touches || e.touches.length !== 1) return;
        if (isUI(e.target)) return;
        if (e.target.closest('.header-wrap')) return;
        onTouchStart(e);
      },
      { passive: true, capture: true }
    );

    document.addEventListener(
      'touchmove',
      function (e) {
        onTouchMove(e);
      },
      { passive: false, capture: true }
    );

    document.addEventListener('touchend', onTouchEnd, { passive: true, capture: true });
    document.addEventListener('touchcancel', onTouchEnd, { passive: true, capture: true });

    window.addEventListener('resize', function () {
      scroller.scrollLeft = clampScroll(scroller.scrollLeft);
      resetDesktopScroll();
    });

    if (typeof mobileMq.addEventListener === 'function') {
      mobileMq.addEventListener('change', resetDesktopScroll);
    }

    setupHeaderTitle();
    normalizeMobileHeaderTitle();
    resetDesktopScroll();

    var bg = section.querySelector('.rs-landing-bg');
    if (bg) {
      var onBgReady = function () {
        scroller.scrollLeft = clampScroll(scroller.scrollLeft);
      };
      if (bg.complete) onBgReady();
      bg.addEventListener('load', onBgReady);
    }

    document.addEventListener('shopify:section:load', function (ev) {
      if (ev.target && ev.target.contains && ev.target.contains(section)) {
        setupHeaderTitle();
        normalizeMobileHeaderTitle();
      }
    });
  })();
</script>

<script>
  (function () {
    function initGrillzOverlay() {
      var section = document.querySelector('.rs-grillz-landing');
      if (!section) return;
      if (section.dataset.rsGrillzOverlaysInit === '1') return;
      section.dataset.rsGrillzOverlaysInit = '1';

      var btn = section.querySelector('.rs-grillz-rdv-btn');
      var overlay = document.getElementById('rs-grillz-overlay');
      var kitBtn = section.querySelector('.rs-grillz-kit-btn');
      var kitOverlay = document.getElementById('rs-grillz-kit-overlay');

      if (overlay && overlay.parentElement !== document.body) {
        document.body.appendChild(overlay);
      }
      if (kitOverlay && kitOverlay.parentElement !== document.body) {
        document.body.appendChild(kitOverlay);
      }

      function lockScroll() {
        document.documentElement.classList.add('rs-grillz-overlay-open');
        document.body.classList.add('rs-grillz-overlay-open');
      }

      function unlockScroll() {
        var rdvOpen = overlay && overlay.classList.contains('is-open');
        var kitOpen = kitOverlay && kitOverlay.classList.contains('is-open');
        if (!rdvOpen && !kitOpen) {
          document.documentElement.classList.remove('rs-grillz-overlay-open');
          document.body.classList.remove('rs-grillz-overlay-open');
        }
      }

      if (btn && overlay) {
        var close = overlay.querySelector('.rs-grillz-overlay__close');
        var panel = overlay.querySelector('.rs-grillz-overlay__panel');

        function openOverlay(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          overlay.classList.add('is-open');
          overlay.setAttribute('aria-hidden', 'false');
          lockScroll();
        }

        function closeOverlay(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          overlay.classList.remove('is-open');
          overlay.setAttribute('aria-hidden', 'true');
          unlockScroll();
        }

        btn.addEventListener('click', openOverlay);

        if (close) {
          close.addEventListener('click', closeOverlay);
        }

        overlay.addEventListener('click', function (e) {
          if (e.target === overlay) {
            closeOverlay(e);
          }
        });

        if (panel) {
          panel.addEventListener('click', function (e) {
            e.stopPropagation();
          });
        }
      }

      if (kitBtn && kitOverlay) {
        var kitClose = kitOverlay.querySelector('.rs-grillz-kit-close');
        var kitPanel = kitOverlay.querySelector('.rs-grillz-kit-overlay__panel');

        function openKitOverlay(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          kitOverlay.classList.add('is-open');
          kitOverlay.setAttribute('aria-hidden', 'false');
          lockScroll();
        }

        function closeKitOverlay(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          kitOverlay.classList.remove('is-open');
          kitOverlay.setAttribute('aria-hidden', 'true');
          unlockScroll();
        }

        kitBtn.addEventListener('click', openKitOverlay);

        if (kitClose) {
          kitClose.addEventListener('click', closeKitOverlay);
        }

        kitOverlay.addEventListener('click', function (e) {
          if (e.target === kitOverlay) {
            closeKitOverlay(e);
          }
        });

        if (kitPanel) {
          kitPanel.addEventListener('click', function (e) {
            e.stopPropagation();
          });
        }
      }

      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        if (kitOverlay && kitOverlay.classList.contains('is-open')) {
          kitOverlay.classList.remove('is-open');
          kitOverlay.setAttribute('aria-hidden', 'true');
          unlockScroll();
          return;
        }
        if (overlay && overlay.classList.contains('is-open')) {
          overlay.classList.remove('is-open');
          overlay.setAttribute('aria-hidden', 'true');
          unlockScroll();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGrillzOverlay);
    } else {
      initGrillzOverlay();
    }

    document.addEventListener('shopify:section:load', function (ev) {
      if (ev.target && ev.target.querySelector && ev.target.querySelector('.rs-grillz-landing')) {
        initGrillzOverlay();
      }
    });
  })();
</script>

