    margin: 0 0 12px;
  }

  .rs-grillz-overlay__body p:last-child {
    margin-bottom: 0;
  }

  .rs-grillz-overlay__body strong {
    color: var(--rs-color-brand-pale, #f9a8d4);
    font-weight: 700;
  }

  a.rs-grillz-overlay__cta {
    display: inline-block;
    padding: 14px 32px;
    border-radius: var(--rs-radius-md, 8px);
    background: var(--rs-color-brand, #f472b6);
    color: var(--rs-color-bg, #fff) !important;
    font-family: var(--rs-font-display), var(--font-display), 'Syne', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none !important;
    text-transform: uppercase;
    transition: background 0.2s ease;
  }

  a.rs-grillz-overlay__cta:hover,
  a.rs-grillz-overlay__cta:focus-visible {
    background: var(--rs-color-brand-hover, #db2777);
    color: var(--rs-color-bg, #fff) !important;
  }

  html.rs-grillz-overlay-open,
  body.rs-grillz-overlay-open {
    overflow: hidden !important;
  }

  /* Overlay RDV — calendrier (mobile) */
  .rs-grillz-overlay__panel--cal {
    display: flex;
    flex-direction: column;
    width: min(96vw, 440px);
    max-width: 440px;
    max-height: min(92dvh, 720px);
    padding: 16px 16px 12px;
    overflow: hidden;
  }

  .rs-grillz-overlay__panel--cal .rs-grillz-overlay__kicker {
    flex-shrink: 0;
    margin-bottom: 12px;
  }

  .rs-grillz-cal-embed {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--rs-radius-md, 8px);
    background: #fff;
  }

  .rs-grillz-cal-embed__frame {
    display: block;
    width: 100%;
    height: min(72dvh, 580px);
    min-height: 420px;
    border: 0;
    background: #fff;
  }

  /* Overlay kit — fond clair (desktop) */
  .rs-grillz-kit-overlay__panel--light {
    width: min(90vw, 420px);
    max-width: 420px;
    padding: 28px 24px 24px;
    border: 1px solid var(--rs-color-border, #e8e8e4);
    border-radius: var(--rs-radius-lg, 12px);
    background: var(--rs-color-bg, #fff);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.12);
  }

  .rs-grillz-kit-overlay__panel--light .rs-grillz-overlay__close {
    color: var(--rs-color-muted, #6b6b6b);
  }

  .rs-grillz-kit-overlay__panel--light .rs-grillz-overlay__kicker {
    margin-bottom: 12px;
    text-shadow: none;
  }

  .rs-grillz-kit-overlay__panel--light .rs-grillz-overlay__body {
    margin-bottom: 22px;
    color: var(--rs-color-ink, #0a0a0a);
    text-shadow: none;
  }

  .rs-grillz-kit-overlay__panel--light .rs-grillz-overlay__body strong {
    color: var(--rs-color-brand-hover, #db2777);
    font-weight: 700;
  }

  a.rs-grillz-kit-overlay__cta {
    padding: 12px 28px;
    border-radius: var(--rs-radius-md, 8px);
    background: var(--rs-color-brand, #f472b6);
    box-shadow: none;
    text-shadow: none;
  }

  a.rs-grillz-kit-overlay__cta:hover,
  a.rs-grillz-kit-overlay__cta:focus-visible {
    background: var(--rs-color-brand-hover, #db2777);
    color: var(--rs-color-bg, #fff) !important;
  }

  @media (min-width: 768px) {
    .rs-grillz-overlay--rdv {
      display: none !important;
    }
  }

  @media (max-width: 767.98px) {
    .rs-grillz-kit-overlay {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }
  }
</style>

<script>
  (function () {
    var section = document.querySelector('.rs-grillz-landing');
    if (!section) return;

    var scroller = section.querySelector('[data-rs-scroller]');
    if (!scroller) return;

    document.documentElement.classList.add('rs-home-landing-active', 'rs-grillz-landing-active');
    document.body.classList.add('rs-home-landing-active', 'rs-grillz-landing-active');

    var heading = section.getAttribute('data-rs-heading') || 'RECRUTE STAGIAIRE';
    var mobileMq = window.matchMedia('(max-width: 767.98px)');

    var drag = {
      active: false,
      startX: 0,
      startY: 0,
      startScroll: 0,
      lock: null
    };

    function isMobile() {
      return mobileMq.matches;
    }

    function isUI(target) {
      if (!target) return false;
      return !!target.closest('[data-rs-ui] a, [data-rs-ui] button');
    }

    function maxScrollLeft() {
      return Math.max(0, scroller.scrollWidth - scroller.clientWidth);
    }

    function clampScroll(x) {
      return Math.min(maxScrollLeft(), Math.max(0, x));
    }

    function setupHeaderTitle() {
      var topLine = document.querySelector('.header-wrap .rs-header-top-line');
      if (!topLine || topLine.querySelector('.rs-home-header-title')) return;
      var title = document.createElement('p');
      title.className = 'rs-home-header-title';
      title.textContent = heading;
      topLine.appendChild(title);
    }

    function normalizeMobileHeaderTitle() {
      var mobileTitle = document.querySelector('.rs-header-mobile-bar__title');
      if (!mobileTitle) return;
      mobileTitle.textContent = heading;
    }

    function syncPanScroll() {
      if (isMobile()) {
        var max = maxScrollLeft();
        scroller.scrollLeft = max > 0 ? max / 2 : 0;
        return;
      }
      scroller.scrollLeft = 0;
    }

    function onTouchStart(e) {
      if (!isMobile() || !e.touches || e.touches.length !== 1) return;
      if (isUI(e.target)) return;
      drag.lock = null;
      if (e.target.closest('[data-rs-scroller]')) {
        drag.active = false;
        return;
      }
      var t = e.touches[0];
      drag.active = true;
      drag.startX = t.clientX;
      drag.startY = t.clientY;
      drag.startScroll = scroller.scrollLeft;
    }

    function onTouchMove(e) {
      if (!isMobile() || !drag.active || !e.touches || e.touches.length !== 1) return;
      var t = e.touches[0];
      var dx = t.clientX - drag.startX;
      var adx = Math.abs(dx);
      var ady = Math.abs(t.clientY - drag.startY);
      if (drag.lock === null && (adx > 6 || ady > 6)) {
        drag.lock = adx > ady ? 'x' : 'y';
      }
      if (drag.lock === 'y') {
        drag.active = false;
        return;
      }
      if (drag.lock === 'x') {
        e.preventDefault();
        scroller.scrollLeft = clampScroll(drag.startScroll - dx);
      }
    }

    function onTouchEnd() {
      drag.active = false;
      drag.lock = null;
    }

    document.addEventListener(
      'touchstart',
      function (e) {
        if (!isMobile() || !e.touches || e.touches.length !== 1) return;
        if (isUI(e.target)) return;
        if (e.target.closest('.header-wrap')) return;
        onTouchStart(e);
      },
      { passive: true, capture: true }
    );

    document.addEventListener(
      'touchmove',
      function (e) {
        onTouchMove(e);
      },
      { passive: false, capture: true }
    );

    document.addEventListener('touchend', onTouchEnd, { passive: true, capture: true });
    document.addEventListener('touchcancel', onTouchEnd, { passive: true, capture: true });

    window.addEventListener('resize', function () {
      syncPanScroll();
    });

    if (typeof mobileMq.addEventListener === 'function') {
      mobileMq.addEventListener('change', syncPanScroll);
    }

    setupHeaderTitle();
    normalizeMobileHeaderTitle();
    syncPanScroll();

    var bg = section.querySelector('.rs-landing-bg');
    if (bg) {
      var onBgReady = function () {
        syncPanScroll();
      };
      if (bg.complete) onBgReady();
      bg.addEventListener('load', onBgReady);
    }

    document.addEventListener('shopify:section:load', function (ev) {
      if (ev.target && ev.target.contains && ev.target.contains(section)) {
        setupHeaderTitle();
        normalizeMobileHeaderTitle();
      }
    });
  })();
</script>

<script>
  (function () {
    function initGrillzOverlay() {
      var section = document.querySelector('.rs-grillz-landing');
      if (!section) return;
      if (section.dataset.rsGrillzOverlaysInit === '1') return;
      section.dataset.rsGrillzOverlaysInit = '1';

      var mobileMq = window.matchMedia('(max-width: 767.98px)');
      var calUrl = section.getAttribute('data-rs-cal-url') || '';
      var kitUrl = section.getAttribute('data-rs-kit-url') || '';

      function isMobileOverlay() {
        return mobileMq.matches;
      }

      function openExternal(url) {
        if (!url) return;
        if (url.indexOf('mailto:') === 0) {
          window.location.href = url;
          return;
        }
        window.open(url, '_blank', 'noopener,noreferrer');
      }

      var btn = section.querySelector('.rs-grillz-rdv-btn');
      var overlay = document.getElementById('rs-grillz-overlay');
      var kitBtn = section.querySelector('.rs-grillz-hotspot--kit.rs-grillz-kit-btn');
      var kitOverlay = document.getElementById('rs-grillz-kit-overlay');

      if (overlay && overlay.parentElement !== document.body) {
        document.body.appendChild(overlay);
      }
      if (kitOverlay && kitOverlay.parentElement !== document.body) {
        document.body.appendChild(kitOverlay);
      }

      function lockScroll() {
        document.documentElement.classList.add('rs-grillz-overlay-open');
        document.body.classList.add('rs-grillz-overlay-open');
      }

      function unlockScroll() {
        var rdvOpen = overlay && overlay.classList.contains('is-open');
        var kitOpen = kitOverlay && kitOverlay.classList.contains('is-open');
        if (!rdvOpen && !kitOpen) {
          document.documentElement.classList.remove('rs-grillz-overlay-open');
          document.body.classList.remove('rs-grillz-overlay-open');
        }
      }

      if (btn && overlay) {
        var close = overlay.querySelector('.rs-grillz-overlay__close');
        var panel = overlay.querySelector('.rs-grillz-overlay__panel');

        function ensureCalEmbed() {
          var iframe = overlay.querySelector('.rs-grillz-cal-embed__frame');
          if (!iframe || iframe.getAttribute('src')) return;
          var src = iframe.getAttribute('data-src') || calUrl;
          if (!src) return;
          iframe.setAttribute('src', src);
        }

        function openOverlay(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          ensureCalEmbed();
          overlay.classList.add('is-open');
          overlay.setAttribute('aria-hidden', 'false');
          lockScroll();
        }

        function closeOverlay(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          overlay.classList.remove('is-open');
          overlay.setAttribute('aria-hidden', 'true');
          unlockScroll();
        }

        btn.addEventListener('click', function (e) {
          if (!isMobileOverlay()) {
            e.preventDefault();
            e.stopPropagation();
            openExternal(calUrl);
            return;
          }
          openOverlay(e);
        });

        if (close) {
          close.addEventListener('click', closeOverlay);
        }

        overlay.addEventListener('click', function (e) {
          if (e.target === overlay) {
            closeOverlay(e);
          }
        });

        if (panel) {
          panel.addEventListener('click', function (e) {
            e.stopPropagation();
          });
        }
      }

      if (kitBtn && kitOverlay) {
        var kitClose = kitOverlay.querySelector('.rs-grillz-kit-close');
        var kitPanel = kitOverlay.querySelector('.rs-grillz-overlay__panel');

        function openKitOverlay(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          kitOverlay.classList.add('is-open');
          kitOverlay.setAttribute('aria-hidden', 'false');
          lockScroll();
        }

        function closeKitOverlay(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          kitOverlay.classList.remove('is-open');
          kitOverlay.setAttribute('aria-hidden', 'true');
          unlockScroll();
        }

        kitBtn.addEventListener('click', function (e) {
          if (isMobileOverlay()) {
            e.preventDefault();
            e.stopPropagation();
            openExternal(kitUrl);
            return;
          }
          openKitOverlay(e);
        });

        if (kitClose) {
          kitClose.addEventListener('click', closeKitOverlay);
        }

        kitOverlay.addEventListener('click', function (e) {
          if (e.target === kitOverlay) {
            closeKitOverlay(e);
          }
        });

        if (kitPanel) {
          kitPanel.addEventListener('click', function (e) {
            e.stopPropagation();
          });
        }
      }

      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        if (kitOverlay && kitOverlay.classList.contains('is-open')) {
          kitOverlay.classList.remove('is-open');
          kitOverlay.setAttribute('aria-hidden', 'true');
          unlockScroll();
          return;
        }
        if (overlay && overlay.classList.contains('is-open')) {
          overlay.classList.remove('is-open');
          overlay.setAttribute('aria-hidden', 'true');
          unlockScroll();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGrillzOverlay);
    } else {
      initGrillzOverlay();
    }

    document.addEventListener('shopify:section:load', function (ev) {
      if (ev.target && ev.target.querySelector && ev.target.querySelector('.rs-grillz-landing')) {
        initGrillzOverlay();
      }
    });
  })();
</script>

