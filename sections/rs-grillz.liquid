  /* Overlay Cal.com */
  .rs-grillz-overlay {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(0, 0, 0, 0.85);
    box-sizing: border-box;
    opacity: 0;
    visibility: hidden;
