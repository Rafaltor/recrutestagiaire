  }

  .rs-grillz-landing .rs-landing-hotspot {
    position: absolute;
    z-index: 1;
  }

  .rs-grillz-landing .rs-grillz-hotspot--atelier {
    left: 10%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .rs-grillz-landing .rs-grillz-hotspot--rdv {
    left: 42%;
    top: 55%;
    transform: translate(-50%, -50%);
  }

  .rs-grillz-landing .rs-grillz-hotspot--rdv__stack {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .rs-grillz-landing .rs-grillz-kit-btn {
    white-space: nowrap;
  }

  .rs-grillz-landing .rs-grillz-hotspot--kit {
