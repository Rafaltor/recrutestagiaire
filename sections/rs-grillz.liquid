      text-shadow: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-ph-brandlink-logo {
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
    }
  }

  @media (max-width: 767.98px) {
    body.rs-home-landing-active .rs-header-mobile-bar {
      display: grid !important;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      min-height: 64px;
      padding: 0 12px;
      position: relative;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__brand {
      grid-column: 1;
      justify-self: start;
      z-index: 2;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title {
      display: block !important;
      visibility: visible !important;
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
      width: max-content !important;
      max-width: calc(100% - 96px) !important;
      margin: 0 !important;
      padding: 0 !important;
      text-align: center !important;
      font-family: var(--font-display), var(--rs-font-display), 'Syne', sans-serif;
      font-weight: 800;
      font-size: clamp(11px, 3.4vw, 17px);
      letter-spacing: 0.045em;
      line-height: 1.15;
      text-transform: uppercase;
      white-space: nowrap;
      z-index: 3;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title .rs-brand-title-break {
      display: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-mobile-bar__title {
      color: #fff;
      -webkit-text-fill-color: #fff;
      text-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 1px 3px rgba(0, 0, 0, 0.4);
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-mobile-bar__logo {
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
    }
  }

  body.rs-home-landing-active .header-wrap.rs-header .rs-header-mobile-bar__title,
  body.rs-home-landing-active .header-wrap.rs-header .rs-home-header-title {
    color: #fff !important;
    -webkit-text-fill-color: #fff !important;
    text-shadow:
      0 0 14px rgba(0, 0, 0, 0.55),
      0 1px 3px rgba(0, 0, 0, 0.5) !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header .rs-header-mobile-bar__logo,
  body.rs-home-landing-active .header-wrap.rs-header .rs-ph-brandlink-logo {
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.45)) !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .rs-grillz-landing .rs-landing-scroller {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: auto;
    overflow: hidden;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .rs-grillz-landing .rs-landing-scroller::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .rs-grillz-landing .rs-landing-scroller__track {
    position: relative;
    height: 100%;
    height: 100dvh;
  }

  .rs-grillz-landing .rs-landing-scene {
    position: relative;
    width: 100%;
    height: 100%;
    height: 100dvh;
  }

  .rs-grillz-landing .rs-landing-bg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    max-width: none !important;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .rs-grillz-landing .rs-landing-hotspots {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .rs-grillz-landing .rs-landing-hotspots * {
    pointer-events: none;
  }

  .rs-grillz-landing .rs-landing-hotspots a,
  .rs-grillz-landing .rs-landing-hotspots button {
    pointer-events: auto;
  }

  .rs-grillz-landing .rs-landing-hotspot {
    position: absolute;
    z-index: 1;
  }

  .rs-grillz-landing .rs-grillz-hotspot--atelier {
    left: 10%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .rs-grillz-landing .rs-grillz-hotspot--rdv {
    left: 42%;
    top: 55%;
    transform: translate(-50%, -50%);
  }

  .rs-grillz-landing .rs-grillz-hotspot--kit {
    right: 30%;
    left: auto;
    top: 65%;
    transform: translate(50%, -50%);
  }

  @media (max-width: 767.98px) {
    .rs-grillz-landing .rs-landing-scroller {
      overflow-x: auto;
      overflow-y: hidden;
      touch-action: pan-x;
      overscroll-behavior-x: contain;
      overscroll-behavior-y: none;
    }

    .rs-grillz-landing .rs-landing-scroller__track {
      width: 250vw;
      min-width: 250vw;
    }

    .rs-grillz-landing .rs-landing-bg {
      object-fit: cover;
      object-position: center center;
    }
  }

  @media (min-width: 768px) {
    .rs-grillz-landing .rs-landing-scroller {
      overflow: hidden;
      touch-action: auto;
    }

    .rs-grillz-landing .rs-landing-scroller__track {
      width: 100vw;
      min-width: 100vw;
    }
  }

  .rs-grillz-landing a.rs-landing-overlay__cta,
  .rs-grillz-landing button.rs-landing-overlay__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    padding: 4px 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    background: rgba(0, 0, 0, 0.35);
    color: #fff !important;
    font-family: var(--rs-font-display), var(--font-display), 'Syne', sans-serif;
    font-weight: 600;
    font-size: clamp(12px, 3.45vw, 14.5px);
    letter-spacing: 0.14em;
    text-decoration: none !important;
    text-transform: uppercase;
    white-space: nowrap;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .rs-grillz-landing a.rs-landing-overlay__cta:hover,
  .rs-grillz-landing a.rs-landing-overlay__cta:focus-visible,
  .rs-grillz-landing button.rs-landing-overlay__cta:hover,
  .rs-grillz-landing button.rs-landing-overlay__cta:focus-visible {
    background: rgba(0, 0, 0, 0.52);
    border-color: rgba(255, 255, 255, 0.85);
    color: #fff !important;
    text-decoration: none !important;
  }

  /* Overlays modales (RDV + kit postal) */
  .rs-grillz-overlay,
  .rs-grillz-kit-overlay {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(10, 10, 10, 0.88);
    box-sizing: border-box;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .rs-grillz-kit-overlay {
    z-index: 2147483001;
  }

  .rs-grillz-overlay.is-open,
  .rs-grillz-kit-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .rs-grillz-overlay__panel {
    position: relative;
    width: min(90vw, 480px);
    max-width: 480px;
    padding: 32px;
    border-radius: var(--rs-radius-lg, 12px);
    background: var(--rs-color-ink, #0a0a0a);
    text-align: center;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
  }

  .rs-grillz-overlay__close {
    position: absolute;
    top: 12px;
    right: 16px;
    z-index: 10;
    padding: 0;
    border: none;
    background: none;
    color: var(--rs-color-bg, #fff);
    font-family: var(--rs-font-body), var(--font-body), 'Manrope', sans-serif;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .rs-grillz-overlay__kicker {
    margin: 0 0 8px;
