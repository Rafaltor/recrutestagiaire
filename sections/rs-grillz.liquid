{%- liquid
  assign bg = section.settings.background_image
  assign heading_text = section.settings.heading | default: 'RECRUTE STAGIAIRE'
  assign cal_link = section.settings.cal_link | default: 'recrutestagiaire-avpmen/grillz' | strip
  assign cal_booking_url = section.settings.cal_booking_url | default: '' | strip
  if cal_booking_url == blank
    assign cal_booking_url = 'https://cal.com/' | append: cal_link
  endif
  assign home_url = routes.root_url
  assign kit_url = section.settings.kit_url | default: '' | strip
  if kit_url == blank
    assign kit_subject = 'Kit grillz' | url_param_escape
    assign kit_url = 'mailto:' | append: shop.email | append: '?subject=' | append: kit_subject
  endif
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">

<section
  class="rs-grillz-landing rs-home-landing shopify-section section-rs-grillz-landing"
  id="shopify-section-{{ section.id }}"
  data-rs-heading="{{ heading_text | escape }}"
  {{ section.shopify_attributes }}>
  <div class="rs-landing-scroller" data-rs-scroller tabindex="-1">
    <div class="rs-landing-scroller__track" data-rs-track>
      <div class="rs-landing-scene">
        {%- if bg != blank -%}
          {{
            bg
            | image_url: width: 3840
            | image_tag:
              class: 'rs-landing-bg',
              widths: '750, 1100, 1500, 1920, 2400, 3200, 3840',
              sizes: '250vw',
              loading: 'eager',
              alt: ''
          }}
        {%- else -%}
          <img
            class="rs-landing-bg"
            src="{{ 'dentist.png' | asset_url }}"
            alt=""
            width="2400"
            height="1600"
            loading="eager"
            decoding="async">
        {%- endif -%}

        <div class="rs-landing-hotspots" data-rs-ui>
          <a
            class="rs-landing-hotspot rs-grillz-hotspot--atelier rs-landing-overlay__cta"
            href="{{ home_url }}">
            {{ section.settings.atelier_label | default: "← L'ATELIER" | escape }}
          </a>

          <div class="rs-landing-hotspot rs-grillz-hotspot--rdv">
            <div class="rs-grillz-hotspot--rdv__stack">
              <button
                type="button"
                class="rs-landing-overlay__cta rs-grillz-rdv-btn"
                aria-label="{{ section.settings.rdv_label | default: 'PRENDRE RENDEZ-VOUS' | escape }}">
                {{ section.settings.rdv_label | default: 'PRENDRE RENDEZ-VOUS' | escape }}
              </button>
              <button
                type="button"
                class="rs-grillz-kit-btn"
                style="background:transparent;border:1px solid rgba(255,255,255,0.4);color:white;font-family:'Inter',sans-serif;font-weight:600;font-size:12px;padding:10px 24px;border-radius:6px;cursor:pointer;margin-top:10px;letter-spacing:1px;">
                {{ section.settings.kit_postal_btn_label | default: '📦 KIT POSTAL — PAS DE PARIS ?' | escape }}
              </button>
            </div>
          </div>

          <a
            class="rs-landing-hotspot rs-grillz-hotspot--kit rs-landing-overlay__cta"
            href="{{ kit_url }}"
            {% if kit_url contains 'http' %}
              target="_blank" rel="noopener noreferrer"
            {% endif %}>
            {{ section.settings.kit_label | default: 'ENVOIE KIT GRILLZ' | escape }}
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="rs-grillz-overlay" id="rs-grillz-overlay" aria-hidden="true">
    <div
      class="rs-grillz-overlay__panel"
      role="dialog"
      aria-modal="true"
      aria-label="Prendre rendez-vous"
      style="position:relative;width:90vw;max-width:480px;border-radius:12px;overflow:hidden;background:#0A0A0A;padding:32px;text-align:center;">
      <button
        type="button"
        class="rs-grillz-overlay__close"
        style="position:absolute;top:12px;right:16px;z-index:10;background:none;border:none;color:white;font-size:20px;cursor:pointer;"
        aria-label="Fermer">✕</button>

      <p style="color:#F472B6;font-family:'Inter',sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;margin:0 0 8px;">
        {{ section.settings.overlay_kicker | default: 'PRENDRE RENDEZ-VOUS' | escape }}
      </p>

      <p style="color:white;font-family:'Inter',sans-serif;font-size:14px;margin:0 0 24px;line-height:1.5;">
        {{ section.settings.overlay_text | default: 'RDV à Paris ou kit postal gratuit partout en France.' | escape }}
      </p>

      <a
        href="{{ cal_booking_url }}"
        target="_blank"
        rel="noopener noreferrer"
        style="display:inline-block;background:#F472B6;color:white;font-family:'Inter',sans-serif;font-weight:700;font-size:13px;padding:14px 32px;border-radius:6px;text-decoration:none;">
        {{ section.settings.overlay_cta | default: 'CHOISIR MON CRÉNEAU →' | escape }}
      </a>
    </div>
  </div>

  <div class="rs-grillz-kit-overlay" id="rs-grillz-kit-overlay" aria-hidden="true">
    <div
      class="rs-grillz-kit-overlay__panel"
      role="dialog"
      aria-modal="true"
      aria-label="Kit postal"
      style="position:relative;width:85vw;max-width:380px;background:#f5e6c8;border:3px solid #8B6914;border-radius:4px;padding:32px 28px;font-family:'Courier New',monospace;box-shadow:4px 4px 0px #8B6914,8px 8px 0px rgba(0,0,0,0.3);text-align:center;">
      <button
        type="button"
        class="rs-grillz-kit-close"
        style="position:absolute;top:8px;right:12px;background:none;border:none;font-size:18px;cursor:pointer;color:#8B6914;"
        aria-label="Fermer">✕</button>

      <p style="font-size:11px;color:#8B6914;letter-spacing:2px;text-transform:uppercase;margin:0 0 16px;">
        {{ section.settings.kit_overlay_kicker | default: '✦ KIT POSTAL ✦' | escape }}
      </p>

      <div style="font-size:14px;color:#3d2b00;line-height:1.8;margin:0 0 20px;">
        {%- if section.settings.kit_overlay_body != blank -%}
          {{ section.settings.kit_overlay_body }}
        {%- else -%}
          T'es pas sur Paris ?<br><br>
          On t'envoie un kit de prise d'empreinte chez toi.<br><br>
          Tu fais tes empreintes,<br>
          tu nous les renvoies,<br>
          on fabrique tes grillz à Paris.<br><br>
          <strong>+30 € sur le tarif choisi.</strong>
        {%- endif -%}
      </div>

      <a
        href="{{ cal_booking_url }}"
        target="_blank"
        rel="noopener noreferrer"
        style="display:inline-block;background:#8B6914;color:#f5e6c8;font-family:'Courier New',monospace;font-weight:700;font-size:12px;padding:12px 24px;border:2px solid #3d2b00;text-decoration:none;letter-spacing:1px;">
        {{ section.settings.kit_overlay_cta | default: '[ COMMANDER LE KIT ]' | escape }}
      </a>
    </div>
  </div>
</section>

<style>
  .section-rs-grillz-landing {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    min-height: 100dvh;
  }

