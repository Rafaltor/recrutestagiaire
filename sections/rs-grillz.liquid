{%- liquid
  assign bg = section.settings.background_image
  assign heading_text = section.settings.heading | default: 'RECRUTE STAGIAIRE'
  assign calendly_url = section.settings.calendly_url | default: 'https://calendly.com/bolvirg-recrutestagiaire/30min' | strip
  assign home_url = routes.root_url
  assign kit_url = section.settings.kit_url | default: '' | strip
  if kit_url == blank
    assign kit_subject = 'Kit grillz' | url_param_escape
    assign kit_url = 'mailto:' | append: shop.email | append: '?subject=' | append: kit_subject
  endif
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&display=swap" rel="stylesheet">

<section
  class="rs-grillz-landing rs-home-landing shopify-section section-rs-grillz-landing"
  id="shopify-section-{{ section.id }}"
  data-rs-heading="{{ heading_text | escape }}"
  data-rs-calendly="{{ calendly_url | escape }}"
  {{ section.shopify_attributes }}>
  <div class="rs-landing-scroller" data-rs-scroller tabindex="-1">
    <div class="rs-landing-scroller__track" data-rs-track>
      <div class="rs-landing-scene">
        {%- if bg != blank -%}
          {{
            bg
            | image_url: width: 3840
            | image_tag:
              class: 'rs-landing-bg',
              widths: '750, 1100, 1500, 1920, 2400, 3200, 3840',
              sizes: '250vw',
              loading: 'eager',
              alt: ''
          }}
        {%- else -%}
          <img
            class="rs-landing-bg"
            src="{{ 'dentist.png' | asset_url }}"
            alt=""
            width="2400"
            height="1600"
            loading="eager"
            decoding="async">
        {%- endif -%}

        <div class="rs-landing-hotspots" data-rs-ui>
          <a
            class="rs-landing-hotspot rs-grillz-hotspot--atelier rs-landing-overlay__cta"
            href="{{ home_url }}">
            {{ section.settings.atelier_label | default: "← L'ATELIER" | escape }}
          </a>

          <div class="rs-landing-hotspot rs-grillz-hotspot--rdv">
            <button
              type="button"
              class="rs-landing-overlay__cta"
              data-rs-grillz-calendly
              aria-label="{{ section.settings.rdv_label | default: 'PRENDRE RENDEZ-VOUS' | escape }}">
              {{ section.settings.rdv_label | default: 'PRENDRE RENDEZ-VOUS' | escape }}
            </button>
          </div>

          <a
            class="rs-landing-hotspot rs-grillz-hotspot--kit rs-landing-overlay__cta"
            href="{{ kit_url }}"
            {% if kit_url contains 'http' %}
              target="_blank" rel="noopener noreferrer"
            {% endif %}>
            {{ section.settings.kit_label | default: 'ENVOIE KIT GRILLZ' | escape }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>

<style>
  .section-rs-grillz-landing {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    min-height: 100dvh;
  }

  @media (max-width: 767.98px) {
    html.rs-home-landing-active,
    body.rs-home-landing-active {
      overflow: hidden;
      height: 100%;
      overscroll-behavior: none;
    }

    body.rs-home-landing-active > main {
      overflow: hidden;
      min-height: 100dvh;
      height: 100dvh;
    }

    .section-rs-grillz-landing {
      overflow: hidden;
      height: 100dvh;
      max-height: 100dvh;
    }
  }

  body.rs-home-landing-active .rs-site-footer,
  body.rs-home-landing-active footer.footer {
    display: none !important;
  }

  body.rs-home-landing-active .rs-header-mobile-bar__menu-btn,
  body.rs-home-landing-active .rs-header-burger-btn,
  body.rs-home-landing-active #rs-header-mobile-menu-btn {
    display: none !important;
  }

  body.rs-home-landing-active .rs-ticker,
  body.rs-home-landing-active .rs-header-kitsch-pop,
  body.rs-home-landing-active .rs-ph-navdesk,
  body.rs-home-landing-active .rs-banner-top__actions,
  body.rs-home-landing-active .rs-ph-brandlink-title,
  body.rs-home-landing-active .rs-ph-brandlink-title-hit,
  body.rs-home-landing-active .rs-nav-brand__name.logo {
    display: none !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header {
    z-index: 100 !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  body.rs-home-landing-active.rs-grillz-landing-active .header-wrap.rs-header .rs-header-two-tier,
  body.rs-home-landing-active.rs-grillz-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-two-tier,
  body.rs-home-landing-active.rs-grillz-landing-active .header-wrap.rs-header.rs-header--scroll-solid .rs-header-two-tier {
    background: transparent !important;
    background-color: transparent !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
    border-bottom: none !important;
    border-bottom-color: transparent !important;
    box-shadow: none !important;
  }

  body.rs-home-landing-active.rs-grillz-landing-active .header-wrap.rs-header,
  body.rs-home-landing-active.rs-grillz-landing-active .header-wrap.rs-header.rs-header--scroll-solid {
    background: transparent !important;
    background-color: transparent !important;
  }

  body.rs-home-landing-active.rs-grillz-landing-active .header-wrap.rs-header .rs-header-mobile-bar,
  body.rs-home-landing-active.rs-grillz-landing-active .header-wrap.rs-header.rs-header--scroll-solid .rs-header-mobile-bar {
    background: transparent !important;
    background-color: transparent !important;
    box-shadow: none !important;
  }

  body.rs-home-landing-active.rs-grillz-landing-active .header-wrap.rs-header .rs-header-two-tier::before,
  body.rs-home-landing-active.rs-grillz-landing-active .header-wrap.rs-header .rs-header-two-tier::after {
    display: none !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-ticker {
    display: none !important;
  }

  @media (min-width: 768px) {
    body.rs-home-landing-active .rs-header-mobile-bar {
      display: none !important;
    }

    body.rs-home-landing-active .rs-header-top-line {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      width: 100%;
      gap: 1rem;
    }

    body.rs-home-landing-active .rs-header-pole-brand.rs-banner-top {
      grid-column: 1;
      justify-self: start;
    }

    body.rs-home-landing-active .rs-home-header-title {
      grid-column: 2;
      justify-self: center;
      margin: 0;
      padding: 0;
      color: #fff;
      font-family: var(--font-display), var(--rs-font-display), 'Syne', sans-serif;
      font-weight: 800;
      font-size: 18px;
      line-height: 1.2;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-align: center;
      white-space: nowrap;
      text-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 1px 3px rgba(0, 0, 0, 0.45);
      pointer-events: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-home-header-title {
      color: #fff;
      -webkit-text-fill-color: #fff;
    }

    body.rs-home-landing-active .header-wrap.rs-header.rs-header--scroll-solid .rs-home-header-title {
      color: var(--accent, #f472b6);
      -webkit-text-fill-color: var(--accent, #f472b6);
      text-shadow: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-ph-brandlink-logo {
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
    }
  }

  @media (max-width: 767.98px) {
    body.rs-home-landing-active .rs-header-mobile-bar {
      display: grid !important;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      min-height: 64px;
      padding: 0 12px;
      position: relative;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__brand {
      grid-column: 1;
      justify-self: start;
      z-index: 2;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title {
      display: block !important;
      visibility: visible !important;
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
      width: max-content !important;
      max-width: calc(100% - 96px) !important;
      margin: 0 !important;
      padding: 0 !important;
      text-align: center !important;
      font-family: var(--font-display), var(--rs-font-display), 'Syne', sans-serif;
      font-weight: 800;
      font-size: clamp(11px, 3.4vw, 17px);
      letter-spacing: 0.045em;
      line-height: 1.15;
      text-transform: uppercase;
      white-space: nowrap;
      z-index: 3;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title .rs-brand-title-break {
      display: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-mobile-bar__title {
      color: #fff;
      -webkit-text-fill-color: #fff;
      text-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 1px 3px rgba(0, 0, 0, 0.4);
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-mobile-bar__logo {
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
    }
  }

  body.rs-home-landing-active .header-wrap.rs-header .rs-header-mobile-bar__title,
  body.rs-home-landing-active .header-wrap.rs-header .rs-home-header-title {
    color: #fff !important;
    -webkit-text-fill-color: #fff !important;
    text-shadow:
      0 0 14px rgba(0, 0, 0, 0.55),
      0 1px 3px rgba(0, 0, 0, 0.5) !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header .rs-header-mobile-bar__logo,
  body.rs-home-landing-active .header-wrap.rs-header .rs-ph-brandlink-logo {
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.45)) !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .rs-grillz-landing .rs-landing-scroller {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: auto;
    overflow: hidden;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .rs-grillz-landing .rs-landing-scroller::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .rs-grillz-landing .rs-landing-scroller__track {
    position: relative;
    height: 100%;
    height: 100dvh;
  }

  .rs-grillz-landing .rs-landing-scene {
    position: relative;
    width: 100%;
    height: 100%;
    height: 100dvh;
  }

  .rs-grillz-landing .rs-landing-bg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    max-width: none !important;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .rs-grillz-landing .rs-landing-hotspots {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .rs-grillz-landing .rs-landing-hotspots * {
    pointer-events: none;
  }

  .rs-grillz-landing .rs-landing-hotspots a,
  .rs-grillz-landing .rs-landing-hotspots button {
    pointer-events: auto;
  }

  .rs-grillz-landing .rs-landing-hotspot {
    position: absolute;
    z-index: 1;
  }

  .rs-grillz-landing .rs-grillz-hotspot--atelier {
    left: 10%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .rs-grillz-landing .rs-grillz-hotspot--rdv {
    left: 42%;
    top: 55%;
    transform: translate(-50%, -50%);
  }

  .rs-grillz-landing .rs-grillz-hotspot--kit {
    right: 30%;
    left: auto;
    top: 65%;
    transform: translate(50%, -50%);
  }

  @media (max-width: 767.98px) {
    .rs-grillz-landing .rs-landing-scroller {
      overflow-x: auto;
      overflow-y: hidden;
      touch-action: pan-x;
      overscroll-behavior-x: contain;
      overscroll-behavior-y: none;
    }

    .rs-grillz-landing .rs-landing-scroller__track {
      width: 250vw;
      min-width: 250vw;
    }
  }

  @media (min-width: 768px) {
    .rs-grillz-landing .rs-landing-scroller {
      overflow: hidden;
      touch-action: auto;
    }

    .rs-grillz-landing .rs-landing-scroller__track {
      width: 100vw;
      min-width: 100vw;
    }
  }

  .rs-grillz-landing a.rs-landing-overlay__cta,
  .rs-grillz-landing button.rs-landing-overlay__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    padding: 4px 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    background: rgba(0, 0, 0, 0.35);
    color: #fff !important;
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    font-size: clamp(12px, 3.45vw, 14.5px);
    letter-spacing: 0.14em;
    text-decoration: none !important;
    text-transform: uppercase;
    white-space: nowrap;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .rs-grillz-landing a.rs-landing-overlay__cta:hover,
  .rs-grillz-landing a.rs-landing-overlay__cta:focus-visible,
  .rs-grillz-landing button.rs-landing-overlay__cta:hover,
  .rs-grillz-landing button.rs-landing-overlay__cta:focus-visible {
    background: rgba(0, 0, 0, 0.52);
    border-color: rgba(255, 255, 255, 0.85);
    color: #fff !important;
    text-decoration: none !important;
  }
</style>

<script>
  (function () {
    var section = document.querySelector('.rs-grillz-landing');
    if (!section) return;

    var scroller = section.querySelector('[data-rs-scroller]');
    if (!scroller) return;

    document.documentElement.classList.add('rs-home-landing-active', 'rs-grillz-landing-active');
    document.body.classList.add('rs-home-landing-active', 'rs-grillz-landing-active');

    var heading = section.getAttribute('data-rs-heading') || 'RECRUTE STAGIAIRE';
    var calendlyUrl = section.getAttribute('data-rs-calendly') || '';
    var mobileMq = window.matchMedia('(max-width: 767.98px)');

    var drag = {
      active: false,
      startX: 0,
      startY: 0,
      startScroll: 0,
      lock: null
    };

    function isMobile() {
      return mobileMq.matches;
    }

    function isUI(target) {
      if (!target) return false;
      return !!target.closest('[data-rs-ui] a, [data-rs-ui] button');
    }

    function maxScrollLeft() {
      return Math.max(0, scroller.scrollWidth - scroller.clientWidth);
    }

    function clampScroll(x) {
      return Math.min(maxScrollLeft(), Math.max(0, x));
    }

    function setupHeaderTitle() {
      var topLine = document.querySelector('.header-wrap .rs-header-top-line');
      if (!topLine || topLine.querySelector('.rs-home-header-title')) return;
      var title = document.createElement('p');
      title.className = 'rs-home-header-title';
      title.textContent = heading;
      topLine.appendChild(title);
    }

    function normalizeMobileHeaderTitle() {
      var mobileTitle = document.querySelector('.rs-header-mobile-bar__title');
      if (!mobileTitle) return;
      mobileTitle.textContent = heading;
    }

    function resetDesktopScroll() {
      if (isMobile()) return;
      scroller.scrollLeft = 0;
    }

    function openCalendly() {
      if (window.Calendly && typeof window.Calendly.initPopupWidget === 'function') {
        window.Calendly.initPopupWidget({ url: calendlyUrl });
        return true;
      }
      return false;
    }

    section.querySelectorAll('[data-rs-grillz-calendly]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!openCalendly()) {
          var attempts = 0;
          var timer = window.setInterval(function () {
            attempts += 1;
            if (openCalendly() || attempts > 40) {
              window.clearInterval(timer);
            }
          }, 100);
        }
      });
    });

    function onTouchStart(e) {
      if (!isMobile() || !e.touches || e.touches.length !== 1) return;
      if (isUI(e.target)) return;
      drag.lock = null;
      if (e.target.closest('[data-rs-scroller]')) {
        drag.active = false;
        return;
      }
      var t = e.touches[0];
      drag.active = true;
      drag.startX = t.clientX;
      drag.startY = t.clientY;
      drag.startScroll = scroller.scrollLeft;
    }

    function onTouchMove(e) {
      if (!isMobile() || !drag.active || !e.touches || e.touches.length !== 1) return;
      var t = e.touches[0];
      var dx = t.clientX - drag.startX;
      var adx = Math.abs(dx);
      var ady = Math.abs(t.clientY - drag.startY);
      if (drag.lock === null && (adx > 6 || ady > 6)) {
        drag.lock = adx > ady ? 'x' : 'y';
      }
      if (drag.lock === 'y') {
        drag.active = false;
        return;
      }
      if (drag.lock === 'x') {
        e.preventDefault();
        scroller.scrollLeft = clampScroll(drag.startScroll - dx);
      }
    }

    function onTouchEnd() {
      drag.active = false;
      drag.lock = null;
    }

    document.addEventListener(
      'touchstart',
      function (e) {
        if (!isMobile() || !e.touches || e.touches.length !== 1) return;
        if (isUI(e.target)) return;
        if (e.target.closest('.header-wrap')) return;
        onTouchStart(e);
      },
      { passive: true, capture: true }
    );

    document.addEventListener(
      'touchmove',
      function (e) {
        onTouchMove(e);
      },
      { passive: false, capture: true }
    );

    document.addEventListener('touchend', onTouchEnd, { passive: true, capture: true });
    document.addEventListener('touchcancel', onTouchEnd, { passive: true, capture: true });

    window.addEventListener('resize', function () {
      scroller.scrollLeft = clampScroll(scroller.scrollLeft);
      resetDesktopScroll();
    });

    if (typeof mobileMq.addEventListener === 'function') {
      mobileMq.addEventListener('change', resetDesktopScroll);
    }

    setupHeaderTitle();
    normalizeMobileHeaderTitle();
    resetDesktopScroll();

    var bg = section.querySelector('.rs-landing-bg');
    if (bg) {
      var onBgReady = function () {
        scroller.scrollLeft = clampScroll(scroller.scrollLeft);
      };
      if (bg.complete) onBgReady();
      bg.addEventListener('load', onBgReady);
    }

    document.addEventListener('shopify:section:load', function (ev) {
      if (ev.target && ev.target.contains && ev.target.contains(section)) {
        setupHeaderTitle();
        normalizeMobileHeaderTitle();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Page Grillz",
  "tag": "section",
  "class": "section-rs-grillz-landing",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Wallpaper",
      "info": "Vide = asset dentist.png"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre header",
      "default": "RECRUTE STAGIAIRE"
    },
    {
      "type": "text",
      "id": "atelier_label",
      "label": "Bouton atelier",
      "default": "← L'ATELIER"
    },
    {
      "type": "text",
      "id": "rdv_label",
      "label": "Bouton rendez-vous",
      "default": "PRENDRE RENDEZ-VOUS"
    },
    {
      "type": "text",
      "id": "calendly_url",
      "label": "URL Calendly",
      "default": "https://calendly.com/bolvirg-recrutestagiaire/30min"
    },
    {
      "type": "text",
      "id": "kit_label",
      "label": "Bouton kit",
      "default": "ENVOIE KIT GRILLZ"
    },
    {
      "type": "url",
      "id": "kit_url",
      "label": "Lien kit grillz",
      "info": "Vide = e-mail boutique avec objet « Kit grillz »"
    }
  ],
  "presets": [{ "name": "Page Grillz" }]
}
{% endschema %}
