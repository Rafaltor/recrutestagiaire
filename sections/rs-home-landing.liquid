{%- liquid
  assign bg = section.settings.background_image
  assign portal_url = section.settings.portal_url | default: 'https://portail.recrutestagiaire.eu'
  assign lookbook_url = section.settings.lookbook_url | default: 'https://recrutestagiaire.eu/collections/abcdrs'
  assign heading_text = section.settings.heading | default: 'RECRUTE STAGIAIRE'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap" rel="stylesheet">

<section
  class="rs-home-landing shopify-section section-rs-home-landing"
  id="shopify-section-{{ section.id }}"
  data-rs-heading="{{ heading_text | escape }}"
  {{ section.shopify_attributes }}>
  <div
    class="rs-home-landing__bg-wrap"
    data-rs-home-bg-wrap
    aria-hidden="true">
    {%- if bg != blank -%}
      {{
        bg
        | image_url: width: 3840
        | image_tag:
          class: 'rs-home-landing__bg',
          widths: '750, 1100, 1500, 1920, 2400, 3200, 3840',
          sizes: '150vw',
          loading: 'eager',
          alt: ''
      }}
    {%- else -%}
      <img
        class="rs-home-landing__bg"
        data-rs-home-bg
        src="{{ 'pagedacceuil.jpg' | asset_url }}"
        alt=""
        width="2400"
        height="1600"
        loading="eager"
        decoding="async">
    {%- endif -%}
  </div>

  <div class="rs-home-landing__content">
    <div class="rs-home-landing__form-wrap">
      {%- form 'customer', id: 'rs-waitlist-form', class: 'rs-home-landing__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,waiting-list">
        {%- if form.posted_successfully? -%}
          <p class="rs-home-landing__success" role="status">{{ section.settings.success_message | default: 'Tu es sur la liste.' | escape }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="rs-home-landing__error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <label class="rs-home-landing__label" for="rs-waitlist-email">{{ section.settings.form_label | default: 'REJOINS LA LISTE' | escape }}</label>
          <div class="rs-home-landing__fields">
            <input
              id="rs-waitlist-email"
              class="rs-home-landing__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.email_placeholder | default: 'ton@email.com' | escape }}"
              autocomplete="email"
              required
              {% if form.errors contains 'email' %}
                aria-invalid="true"
              {% endif %}>
            <button type="submit" class="rs-home-landing__submit">
              {{ section.settings.submit_label | default: 'REJOINDRE' | escape }}
            </button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="rs-home-landing__ctas">
      <a class="rs-home-landing__cta rs-btn--primary text-decoration-none" href="{{ portal_url }}" rel="noopener noreferrer">
        {{ section.settings.portal_label | default: 'LE PORTAIL →' | escape }}
      </a>
      <a class="rs-home-landing__cta rs-btn--primary text-decoration-none" href="{{ lookbook_url }}">
        {{ section.settings.lookbook_label | default: 'LOOKBOOK ABCDRS →' | escape }}
      </a>
    </div>
  </div>
</section>

<style>
  .section-rs-home-landing {
    margin: 0;
    padding: 0;
  }

  body.rs-home-landing-active .rs-site-footer,
  body.rs-home-landing-active footer.footer {
    display: none !important;
  }

  body.rs-home-landing-active .rs-header-mobile-bar__menu-btn,
  body.rs-home-landing-active .rs-header-burger-btn,
  body.rs-home-landing-active #rs-header-mobile-menu-btn {
    display: none !important;
  }

  body.rs-home-landing-active .rs-ticker,
  body.rs-home-landing-active .rs-header-kitsch-pop,
  body.rs-home-landing-active .rs-ph-navdesk,
  body.rs-home-landing-active .rs-banner-top__actions,
  body.rs-home-landing-active .rs-header-mobile-bar__title,
  body.rs-home-landing-active .rs-ph-brandlink-title,
  body.rs-home-landing-active .rs-ph-brandlink-title-hit,
  body.rs-home-landing-active .rs-nav-brand__name.logo {
    display: none !important;
  }

  @media (min-width: 768px) {
    body.rs-home-landing-active .rs-header-mobile-bar {
      display: none !important;
    }
  }

  body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-two-tier,
  body.rs-home-landing-active .header-wrap.rs-header.rs-header--scroll-solid .rs-header-two-tier {
    background: transparent !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
    border-bottom-color: rgba(255, 255, 255, 0.12) !important;
    box-shadow: none !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-ticker {
    display: none !important;
  }

  @media (min-width: 768px) {
    body.rs-home-landing-active .rs-header-top-line {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      width: 100%;
      gap: 1rem;
    }

    body.rs-home-landing-active .rs-header-pole-brand.rs-banner-top {
      grid-column: 1;
      justify-self: start;
    }

    body.rs-home-landing-active .rs-home-header-title {
      grid-column: 2;
      justify-self: center;
      margin: 0;
      padding: 0;
      color: #fff;
      font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
      font-weight: 700;
      font-size: 14px;
      line-height: 1.2;
      letter-spacing: 3px;
      text-transform: uppercase;
      text-align: center;
      white-space: nowrap;
      text-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 1px 3px rgba(0, 0, 0, 0.45);
      pointer-events: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-home-header-title {
      color: #fff;
      -webkit-text-fill-color: #fff;
    }

    body.rs-home-landing-active .header-wrap.rs-header.rs-header--scroll-solid .rs-home-header-title {
      color: var(--accent, #f472b6);
      -webkit-text-fill-color: var(--accent, #f472b6);
      text-shadow: none;
    }
  }

  @media (max-width: 767.98px) {
    body.rs-home-landing-active .rs-home-header-title {
      display: none !important;
    }

    body.rs-home-landing-active .rs-header-mobile-bar {
      display: flex !important;
      grid-template-columns: none !important;
      justify-content: flex-start;
      align-items: center;
      gap: 0;
      min-height: 64px;
      padding: 0 12px;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title {
      display: none !important;
      visibility: hidden !important;
      width: 0 !important;
      height: 0 !important;
      overflow: hidden !important;
      position: absolute !important;
      pointer-events: none !important;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__brand {
      margin-right: 0;
    }
  }

  body.rs-portal-header.rs-home-landing-active main > .shopify-section.section-rs-home-landing:first-child {
    margin-top: calc(-1 * var(--rs-portal-header-h, 140px));
    position: relative;
    z-index: 0;
  }

  .rs-home-landing {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    touch-action: pan-y;
  }

  .rs-home-landing.rs-home-landing--panning {
    touch-action: none;
  }

  .rs-home-landing__bg-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    cursor: default;
    transform: none;
  }

  .rs-home-landing--mobile-pan .rs-home-landing__bg-wrap {
    cursor: grab;
  }

  .rs-home-landing--mobile-pan.rs-home-landing--panning .rs-home-landing__bg-wrap {
    cursor: grabbing;
  }

  .rs-home-landing__bg {
    position: absolute;
    top: 50%;
    left: 50%;
    height: 100%;
    min-height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center center;
    transform: translate(-50%, -50%);
    will-change: transform;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .rs-home-landing--desktop-fit .rs-home-landing__bg {
    width: 100%;
    min-width: 100%;
  }

  .rs-home-landing--mobile-pan .rs-home-landing__bg {
    width: 150%;
    min-width: 150%;
  }

  .rs-home-landing__content {
    position: fixed;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: calc(var(--rs-portal-header-h, 120px) + 1.5rem) 1.25rem 2.5rem;
    text-align: center;
    pointer-events: none;
    transform: none !important;
    will-change: auto;
  }

  .rs-home-landing__content a,
  .rs-home-landing__content button,
  .rs-home-landing__content input,
  .rs-home-landing__content label,
  .rs-home-landing__content .rs-home-landing__form,
  .rs-home-landing__content .rs-home-landing__form-wrap {
    pointer-events: auto;
  }

  .rs-home-landing__form-wrap {
    width: 100%;
    max-width: 360px;
    margin-top: 0.25rem;
  }

  .rs-home-landing__form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
  }

  .rs-home-landing__label {
    display: block;
    margin: 0;
    color: #fff;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .rs-home-landing__fields {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.65rem;
    width: min(280px, 100%);
  }

  @media (min-width: 768px) {
    .rs-home-landing__fields {
      width: 360px;
    }
  }

  .rs-home-landing__input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 16px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.15);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #fff;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    outline: none;
  }

  .rs-home-landing__input::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  .rs-home-landing__input:focus-visible {
    border-color: rgba(255, 255, 255, 0.55);
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.15);
  }

  .rs-home-landing__submit {
    align-self: center;
    padding: 12px 24px;
    border: none;
    border-radius: 4px;
    background: #fff;
    color: #0a0a0a;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.18s ease;
  }

  .rs-home-landing__submit:hover {
    opacity: 0.92;
  }

  .rs-home-landing__success,
  .rs-home-landing__error {
    margin: 0;
    color: #fff;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    letter-spacing: 0.02em;
  }

  .rs-home-landing__error {
    color: #ffb4b4;
    font-size: 12px;
  }

  .rs-home-landing__ctas {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  @media (min-width: 768px) {
    .rs-home-landing__ctas {
      flex-direction: row;
      justify-content: center;
      gap: 1rem;
    }
  }

  .rs-home-landing__cta.rs-btn--primary {
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 13px;
    white-space: nowrap;
  }
</style>

<script>
  (function () {
    var section = document.querySelector('.rs-home-landing');
    if (!section) return;

    var MOBILE_MQ = '(max-width: 767.98px)';
    var bgWrap = section.querySelector('[data-rs-home-bg-wrap]');
    var bg = section.querySelector('.rs-home-landing__bg');
    if (!bgWrap || !bg) return;

    document.body.classList.add('rs-home-landing-active');

    var heading = section.getAttribute('data-rs-heading') || 'RECRUTE STAGIAIRE';
    var offsetX = 0;
    var dragging = false;
    var pointerId = null;
    var startX = 0;
    var startOffset = 0;
    var mobileMq = window.matchMedia(MOBILE_MQ);

    function isMobile() {
      return mobileMq.matches;
    }

    function setupHeaderTitle() {
      var topLine = document.querySelector('.header-wrap .rs-header-top-line');
      if (!topLine || topLine.querySelector('.rs-home-header-title')) return;

      var title = document.createElement('p');
      title.className = 'rs-home-header-title';
      title.textContent = heading;
      topLine.appendChild(title);
    }

    function getMaxOffset() {
      var wrapW = bgWrap.clientWidth;
      var imgW = bg.getBoundingClientRect().width;
      return Math.max(0, (imgW - wrapW) / 2);
    }

    function clampOffset() {
      var max = getMaxOffset();
      if (offsetX > max) offsetX = max;
      if (offsetX < -max) offsetX = -max;
    }

    function applyTransform() {
      clampOffset();
      bg.style.transform = 'translate(calc(-50% + ' + offsetX + 'px), -50%)';
    }

    function setMode() {
      var mobile = isMobile();
      section.classList.toggle('rs-home-landing--mobile-pan', mobile);
      section.classList.toggle('rs-home-landing--desktop-fit', !mobile);

      if (!mobile) {
        offsetX = 0;
        dragging = false;
        section.classList.remove('rs-home-landing--panning');
        bg.style.transform = 'translate(-50%, -50%)';
      } else {
        applyTransform();
      }
    }

    function isInteractiveTarget(el) {
      if (!el || !section.contains(el)) return false;
      return !!el.closest('a, button, input, label, textarea, select, .rs-home-landing__form');
    }

    function onPointerDown(e) {
      if (!isMobile() || isInteractiveTarget(e.target)) return;

      dragging = true;
      pointerId = e.pointerId != null ? e.pointerId : 'touch';
      startX = e.clientX != null ? e.clientX : (e.touches && e.touches[0] ? e.touches[0].clientX : 0);
      startOffset = offsetX;
      section.classList.add('rs-home-landing--panning');

      if (section.setPointerCapture && e.pointerId != null) {
        try {
          section.setPointerCapture(e.pointerId);
        } catch (err) {}
      }
    }

    function onPointerMove(e) {
      if (!dragging || !isMobile()) return;
      if (e.pointerId != null && pointerId != null && e.pointerId !== pointerId) return;

      var x = e.clientX != null ? e.clientX : (e.touches && e.touches[0] ? e.touches[0].clientX : startX);
      offsetX = startOffset + (x - startX);
      applyTransform();
    }

    function onPointerUp(e) {
      if (!dragging) return;
      if (e.pointerId != null && pointerId != null && e.pointerId !== pointerId) return;

      dragging = false;
      pointerId = null;
      section.classList.remove('rs-home-landing--panning');
      clampOffset();
      applyTransform();

      if (section.releasePointerCapture && e.pointerId != null) {
        try {
          section.releasePointerCapture(e.pointerId);
        } catch (err) {}
      }
    }

    setupHeaderTitle();
    setMode();

    section.addEventListener('pointerdown', onPointerDown, { passive: true });
    section.addEventListener('pointermove', onPointerMove, { passive: true });
    section.addEventListener('pointerup', onPointerUp);
    section.addEventListener('pointercancel', onPointerUp);

    section.addEventListener(
      'touchstart',
      function (e) {
        if (!isMobile() || isInteractiveTarget(e.target)) return;
        onPointerDown({
          clientX: e.touches[0].clientX,
          touches: e.touches
        });
      },
      { passive: true }
    );

    section.addEventListener(
      'touchmove',
      function (e) {
        if (!dragging) return;
        e.preventDefault();
        onPointerMove({
          clientX: e.touches[0].clientX,
          touches: e.touches
        });
      },
      { passive: false }
    );

    section.addEventListener('touchend', onPointerUp);
    section.addEventListener('touchcancel', onPointerUp);

    if (typeof mobileMq.addEventListener === 'function') {
      mobileMq.addEventListener('change', setMode);
    } else if (typeof mobileMq.addListener === 'function') {
      mobileMq.addListener(setMode);
    }

    window.addEventListener('resize', function () {
      setMode();
      if (isMobile()) applyTransform();
    });

    if (bg.complete) {
      setMode();
    } else {
      bg.addEventListener('load', setMode, { once: true });
    }

    document.addEventListener('shopify:section:load', function (ev) {
      if (ev.target && ev.target.contains && ev.target.contains(section)) {
        setupHeaderTitle();
        setMode();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Accueil waiting list",
  "tag": "section",
  "class": "section-rs-home-landing",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Image de fond (parallax)",
      "info": "Uploader pagedacceuil.jpg dans Fichiers Shopify, puis sélectionner ici. Sinon : asset theme pagedacceuil.jpg."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre header (desktop)",
      "default": "RECRUTE STAGIAIRE"
    },
    {
      "type": "text",
      "id": "form_label",
      "label": "Label formulaire",
      "default": "REJOINS LA LISTE"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Placeholder email",
      "default": "ton@email.com"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Libellé bouton",
      "default": "REJOINDRE"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Message de confirmation",
      "default": "Tu es sur la liste."
    },
    {
      "type": "text",
      "id": "portal_label",
      "label": "Bouton portail",
      "default": "LE PORTAIL →"
    },
    {
      "type": "url",
      "id": "portal_url",
      "label": "URL portail"
    },
    {
      "type": "text",
      "id": "lookbook_label",
      "label": "Bouton lookbook",
      "default": "LOOKBOOK ABCDRS →"
    },
    {
      "type": "url",
      "id": "lookbook_url",
      "label": "URL lookbook"
    }
  ],
  "presets": [
    {
      "name": "Accueil waiting list"
    }
  ]
}
{% endschema %}
