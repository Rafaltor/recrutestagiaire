{%- liquid
  assign bg = section.settings.background_image
  assign portal_url = section.settings.portal_url | default: 'https://portail.recrutestagiaire.eu'
  assign lookbook_url = section.settings.lookbook_url | default: 'https://recrutestagiaire.eu/collections/abcdrs'
  assign heading_text = section.settings.heading | default: 'RECRUTE STAGIAIRE'
-%}

{{ 'rs-hero-video.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap" rel="stylesheet">

<section
  class="rs-home-landing shopify-section section-rs-home-landing"
  id="shopify-section-{{ section.id }}"
  data-rs-heading="{{ heading_text | escape }}"
  {{ section.shopify_attributes }}>
  <div class="rs-home-landing__viewport" data-rs-home-viewport>
    <div class="rs-home-landing__scene" data-rs-home-scene>
      <div class="rs-home-landing__media" aria-hidden="true">
        {%- if bg != blank -%}
          {{
            bg
            | image_url: width: 3840
            | image_tag:
              class: 'rs-home-landing__bg',
              widths: '750, 1100, 1500, 1920, 2400, 3200, 3840',
              sizes: '100vw',
              loading: 'eager',
              alt: ''
          }}
        {%- else -%}
          <img
            class="rs-home-landing__bg"
            data-rs-home-bg
            src="{{ 'pagedacceuil.jpg' | asset_url }}"
            alt=""
            width="2400"
            height="1600"
            loading="eager"
            decoding="async">
        {%- endif -%}
      </div>

      <div class="rs-home-landing__pan-layer" data-rs-home-pan aria-hidden="true"></div>

      <div class="rs-home-landing__scene-ui">
        <a
          class="rs-home-landing__hotspot rs-home-landing__hotspot--portal rs-btn--primary text-decoration-none"
          href="{{ portal_url }}"
          rel="noopener noreferrer">
          {{ section.settings.portal_label | default: 'LE PORTAIL →' | escape }}
        </a>

        <div class="rs-home-landing__hotspot rs-home-landing__hotspot--form">
          <div class="rs-hero-video__content rs-home-landing__waitlist-panel">
            {%- form 'customer', id: 'rs-waitlist-form', class: 'rs-home-landing__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter,waiting-list">
              {%- if form.posted_successfully? -%}
                <p class="rs-hero-video__subtitle rs-home-landing__waitlist-success" role="status">
                  {{ section.settings.success_message | default: 'Tu es sur la liste.' | escape }}
                </p>
              {%- else -%}
                {%- if form.errors -%}
                  <p class="rs-home-landing__waitlist-error" role="alert">{{ form.errors | default_errors }}</p>
                {%- endif -%}

                <div class="rs-hero-video__badge">
                  <span class="rs-hero-video__badge-dot"></span>
                  <span>{{ section.settings.form_label | default: 'REJOINS LA LISTE' | escape }}</span>
                </div>

                <div class="rs-hero-video__search">
                  <span class="rs-hero-video__search-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <circle cx="10.5" cy="10.5" r="6.25" stroke="currentColor" stroke-width="2" fill="none"/>
                      <path d="M15.2 15.2 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
                    </svg>
                  </span>
                  <label class="visually-hidden" for="rs-waitlist-email">{{ section.settings.form_label | default: 'REJOINS LA LISTE' | escape }}</label>
                  <input
                    id="rs-waitlist-email"
                    class="rs-hero-video__search-input"
                    type="email"
                    name="contact[email]"
                    value="{{ form.email }}"
                    placeholder="{{ section.settings.email_placeholder | default: 'ton@email.com' | escape }}"
                    autocomplete="email"
                    required
                    {% if form.errors contains 'email' %}
                      aria-invalid="true"
                    {% endif %}>
                  <button type="submit" class="rs-hero-video__search-btn">
                    <span class="rs-btn-full">{{ section.settings.submit_label | default: 'REJOINDRE' | escape }}</span>
                    <span class="rs-btn-short" aria-hidden="true">→</span>
                  </button>
                </div>
              {%- endif -%}
            {%- endform -%}
          </div>
        </div>

        <a class="rs-home-landing__hotspot rs-home-landing__hotspot--lookbook rs-btn--primary text-decoration-none" href="{{ lookbook_url }}">
          {{ section.settings.lookbook_label | default: 'LOOKBOOK ABCDRS →' | escape }}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .section-rs-home-landing {
    margin: 0;
    padding: 0;
  }

  body.rs-home-landing-active .rs-site-footer,
  body.rs-home-landing-active footer.footer {
    display: none !important;
  }

  body.rs-home-landing-active .rs-header-mobile-bar__menu-btn,
  body.rs-home-landing-active .rs-header-burger-btn,
  body.rs-home-landing-active #rs-header-mobile-menu-btn {
    display: none !important;
  }

  body.rs-home-landing-active .rs-ticker,
  body.rs-home-landing-active .rs-header-kitsch-pop,
  body.rs-home-landing-active .rs-ph-navdesk,
  body.rs-home-landing-active .rs-banner-top__actions,
  body.rs-home-landing-active .rs-ph-brandlink-title,
  body.rs-home-landing-active .rs-ph-brandlink-title-hit,
  body.rs-home-landing-active .rs-nav-brand__name.logo {
    display: none !important;
  }

  @media (min-width: 768px) {
    body.rs-home-landing-active .rs-header-mobile-bar {
      display: none !important;
    }
  }

  @media (max-width: 767.98px) {
    body.rs-home-landing-active .rs-header-mobile-bar {
      display: grid !important;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 0;
      min-height: 64px;
      padding: 0 12px;
      position: relative;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__brand {
      grid-column: 1;
      justify-self: start;
      z-index: 2;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title {
      display: block !important;
      visibility: visible !important;
      width: max-content !important;
      max-width: calc(100% - 96px) !important;
      height: auto !important;
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
      margin: 0 !important;
      padding: 0 !important;
      text-align: center !important;
      justify-self: center;
      font-family: var(--font-display), var(--rs-font-display), 'Syne', sans-serif;
      font-weight: 800;
      font-size: clamp(11px, 3.4vw, 17px);
      letter-spacing: 0.045em;
      line-height: 1.15;
      text-transform: uppercase;
      pointer-events: auto;
      z-index: 3;
      white-space: nowrap;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title .rs-brand-title-break {
      display: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-mobile-bar__title {
      color: #fff;
      -webkit-text-fill-color: #fff;
      text-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 1px 3px rgba(0, 0, 0, 0.45);
    }
  }

  body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-two-tier,
  body.rs-home-landing-active .header-wrap.rs-header.rs-header--scroll-solid .rs-header-two-tier {
    background: transparent !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
    border-bottom-color: rgba(255, 255, 255, 0.12) !important;
    box-shadow: none !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-ticker {
    display: none !important;
  }

  @media (min-width: 768px) {
    body.rs-home-landing-active .rs-header-top-line {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      width: 100%;
      gap: 1rem;
    }

    body.rs-home-landing-active .rs-header-pole-brand.rs-banner-top {
      grid-column: 1;
      justify-self: start;
    }

    body.rs-home-landing-active .rs-home-header-title {
      grid-column: 2;
      justify-self: center;
      margin: 0;
      padding: 0;
      color: #fff;
      font-family: var(--font-display), var(--rs-font-display), 'Syne', sans-serif;
      font-weight: 800;
      font-size: 14px;
      line-height: 1.2;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-align: center;
      white-space: nowrap;
      text-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 1px 3px rgba(0, 0, 0, 0.45);
      pointer-events: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-home-header-title {
      color: #fff;
      -webkit-text-fill-color: #fff;
    }

    body.rs-home-landing-active .header-wrap.rs-header.rs-header--scroll-solid .rs-home-header-title {
      color: var(--accent, #f472b6);
      -webkit-text-fill-color: var(--accent, #f472b6);
      text-shadow: none;
    }
  }

  body.rs-portal-header.rs-home-landing-active main > .shopify-section.section-rs-home-landing:first-child {
    margin-top: calc(-1 * var(--rs-portal-header-h, 140px));
    position: relative;
    z-index: 0;
  }

  .rs-home-landing {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
  }

  .rs-home-landing--mobile-pan {
    touch-action: none;
    overscroll-behavior: none;
  }

  .rs-home-landing--mobile-pan.rs-home-landing--panning {
    touch-action: none;
    overscroll-behavior: none;
  }

  .rs-home-landing--mobile-pan .rs-home-landing__viewport {
    overscroll-behavior: none;
  }

  .rs-home-landing__viewport {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .rs-home-landing__pan-layer {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 1;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .rs-home-landing--mobile-pan .rs-home-landing__pan-layer {
    display: block;
    cursor: grab;
  }

  .rs-home-landing--mobile-pan.rs-home-landing--panning .rs-home-landing__pan-layer {
    cursor: grabbing;
  }

  .rs-home-landing__scene {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    will-change: transform;
  }

  .rs-home-landing__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .rs-home-landing__bg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* Calque UI = même repère que le wallpaper (scène panoramique) */
  .rs-home-landing__scene-ui {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }

  .rs-home-landing__hotspot {
    position: absolute;
    pointer-events: none;
    z-index: 2;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 13px;
    margin: 0;
  }

  .rs-home-landing__hotspot a,
  .rs-home-landing__hotspot button,
  .rs-home-landing__hotspot input,
  .rs-home-landing__hotspot label,
  .rs-home-landing__hotspot .rs-hero-video__search,
  .rs-home-landing__hotspot .rs-hero-video__content,
  .rs-home-landing__hotspot form {
    pointer-events: auto;
  }

  /* Coordonnées % du wallpaper — portail gauche / milieu */
  .rs-home-landing__hotspot--portal {
    left: 6%;
    top: 50%;
    transform: translateY(-50%);
  }

  /* Formulaire : centre wallpaper, un peu sous le milieu */
  .rs-home-landing__hotspot--form {
    left: 50%;
    top: 58%;
    transform: translate(-50%, -50%);
    width: min(280px, 72%);
    max-width: 360px;
  }

  /* Lookbook : bas droite du wallpaper */
  .rs-home-landing__hotspot--lookbook {
    left: 94%;
    top: 90%;
    transform: translate(-50%, -50%);
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .rs-home-landing__hotspot--form {
      width: 360px;
    }

    .rs-home-landing__hotspot--portal {
      left: 8%;
      top: 50%;
    }

    .rs-home-landing__hotspot--lookbook {
      left: 92%;
      top: 88%;
    }
  }

  /* Module hero vidéo (index.backup) — waiting list */
  .rs-home-landing__waitlist-panel.rs-hero-video__content {
    position: relative;
    z-index: auto;
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
    transform: none;
    overflow: visible;
    text-align: center;
  }

  .rs-home-landing__waitlist-panel .rs-hero-video__badge {
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 12px;
  }

  .rs-home-landing__waitlist-panel .rs-hero-video__search {
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 0;
    width: 100%;
    max-width: 100%;
  }

  .rs-home-landing__waitlist-panel .rs-hero-video__search input[type='email'],
  .rs-home-landing__waitlist-panel .rs-hero-video__search-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    border: 0;
    background: transparent;
    font-size: 15px;
    color: var(--rs-color-ink);
    outline: none;
  }

  .rs-home-landing__waitlist-panel .rs-hero-video__search input[type='email']::placeholder {
    color: var(--rs-color-muted);
  }

  .rs-home-landing__form {
    width: 100%;
    margin: 0;
  }

  .rs-home-landing__waitlist-success {
    margin: 0;
    text-align: center;
    color: #fff;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
  }

  .rs-home-landing__waitlist-error {
    margin: 0 0 10px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12px;
    color: #ffb4b4;
    background: rgba(80, 0, 0, 0.35);
    border: 1px solid rgba(255, 120, 120, 0.35);
    text-align: center;
  }
</style>

<script>
  (function () {
    var section = document.querySelector('.rs-home-landing');
    if (!section) return;

    var MOBILE_MQ = '(max-width: 767.98px)';
    var viewport = section.querySelector('[data-rs-home-viewport]');
    var scene = section.querySelector('[data-rs-home-scene]');
    var panLayer = section.querySelector('[data-rs-home-pan]');
    var bg = section.querySelector('.rs-home-landing__bg');
    if (!viewport || !scene || !panLayer || !bg) return;

    document.body.classList.add('rs-home-landing-active');

    var heading = section.getAttribute('data-rs-heading') || 'RECRUTE STAGIAIRE';
    var panX = 0;
    var dragging = false;
    var activePointer = null;
    var startX = 0;
    var startPanX = 0;
    var mobileMq = window.matchMedia(MOBILE_MQ);

    function isMobile() {
      return mobileMq.matches;
    }

    function setupHeaderTitle() {
      var topLine = document.querySelector('.header-wrap .rs-header-top-line');
      if (!topLine || topLine.querySelector('.rs-home-header-title')) return;

      var title = document.createElement('p');
      title.className = 'rs-home-header-title';
      title.textContent = heading;
      topLine.appendChild(title);
    }

    function normalizeMobileHeaderTitle() {
      var mobileTitle = document.querySelector('.rs-header-mobile-bar__title');
      if (!mobileTitle) return;
      mobileTitle.textContent = heading;
    }

    function getViewportWidth() {
      return viewport.clientWidth || window.innerWidth;
    }

    function getSceneWidth() {
      return scene.offsetWidth || getViewportWidth();
    }

    function getPanBounds() {
      var vw = getViewportWidth();
      var sceneW = getSceneWidth();
      var minX = Math.min(0, vw - sceneW);
      return { min: minX, max: 0 };
    }

    function clampPan() {
      var bounds = getPanBounds();
      if (panX < bounds.min) panX = bounds.min;
      if (panX > bounds.max) panX = bounds.max;
    }

    function applyScenePosition() {
      clampPan();
      scene.style.transform = 'translate3d(' + panX + 'px, 0, 0)';
    }

    function centerScene() {
      var vw = getViewportWidth();
      var sceneW = getSceneWidth();
      panX = (vw - sceneW) / 2;
      applyScenePosition();
    }

    function updateSceneSize() {
      var vw = getViewportWidth();
      var vh = viewport.clientHeight || window.innerHeight;

      if (!isMobile()) {
        scene.style.width = vw + 'px';
        panX = 0;
        scene.style.transform = 'translate3d(0, 0, 0)';
        return;
      }

      var nw = bg.naturalWidth;
      var nh = bg.naturalHeight;
      if (!nw || !nh) {
        nw = 2400;
        nh = 1600;
      }

      var coverW = vh * (nw / nh);
      var sceneW = Math.max(vw * 1.75, coverW);
      scene.style.width = Math.ceil(sceneW) + 'px';
      centerScene();
    }

    function setMode() {
      var mobile = isMobile();
      section.classList.toggle('rs-home-landing--mobile-pan', mobile);
      updateSceneSize();
    }

    function onPanStart(e) {
      if (!isMobile() || dragging) return;
      dragging = true;
      activePointer = e.pointerId;
      startX = e.clientX;
      startPanX = panX;
      section.classList.add('rs-home-landing--panning');
      if (panLayer.setPointerCapture) {
        try {
          panLayer.setPointerCapture(e.pointerId);
        } catch (err) {}
      }
    }

    function onPanMove(e) {
      if (!dragging || !isMobile()) return;
      if (e.pointerId !== activePointer) return;
      e.preventDefault();
      panX = startPanX + (e.clientX - startX);
      applyScenePosition();
    }

    function onPanEnd(e) {
      if (!dragging) return;
      if (e && e.pointerId !== activePointer) return;
      dragging = false;
      activePointer = null;
      section.classList.remove('rs-home-landing--panning');
      clampPan();
      applyScenePosition();
      if (panLayer.releasePointerCapture && e) {
        try {
          panLayer.releasePointerCapture(e.pointerId);
        } catch (err) {}
      }
    }

    setupHeaderTitle();
    normalizeMobileHeaderTitle();
    setMode();

    panLayer.addEventListener('pointerdown', onPanStart, { passive: false });
    panLayer.addEventListener('pointermove', onPanMove, { passive: false });
    panLayer.addEventListener('pointerup', onPanEnd);
    panLayer.addEventListener('pointercancel', onPanEnd);
    panLayer.addEventListener('lostpointercapture', onPanEnd);

    if (typeof mobileMq.addEventListener === 'function') {
      mobileMq.addEventListener('change', setMode);
    } else if (typeof mobileMq.addListener === 'function') {
      mobileMq.addListener(setMode);
    }

    window.addEventListener('resize', setMode);

    if (bg.complete) {
      setMode();
    }
    bg.addEventListener('load', setMode);

    document.addEventListener('shopify:section:load', function (ev) {
      if (ev.target && ev.target.contains && ev.target.contains(section)) {
        setupHeaderTitle();
        normalizeMobileHeaderTitle();
        setMode();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Accueil waiting list",
  "tag": "section",
  "class": "section-rs-home-landing",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Image de fond (parallax)",
      "info": "Uploader pagedacceuil.jpg dans Fichiers Shopify, puis sélectionner ici. Sinon : asset theme pagedacceuil.jpg."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre header (desktop)",
      "default": "RECRUTE STAGIAIRE"
    },
    {
      "type": "text",
      "id": "form_label",
      "label": "Label formulaire",
      "default": "REJOINS LA LISTE"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Placeholder email",
      "default": "ton@email.com"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Libellé bouton",
      "default": "REJOINDRE"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Message de confirmation",
      "default": "Tu es sur la liste."
    },
    {
      "type": "text",
      "id": "portal_label",
      "label": "Bouton portail",
      "default": "LE PORTAIL →"
    },
    {
      "type": "url",
      "id": "portal_url",
      "label": "URL portail"
    },
    {
      "type": "text",
      "id": "lookbook_label",
      "label": "Bouton lookbook",
      "default": "LOOKBOOK ABCDRS →"
    },
    {
      "type": "url",
      "id": "lookbook_url",
      "label": "URL lookbook"
    }
  ],
  "presets": [
    {
      "name": "Accueil waiting list"
    }
  ]
}
{% endschema %}
