{%- liquid
  assign bg = section.settings.background_image
  assign portal_url = section.settings.portal_url | default: 'https://portail.recrutestagiaire.eu'
  assign lookbook_url = section.settings.lookbook_url | default: 'https://recrutestagiaire.eu/collections/abcdrs'
  assign heading_text = section.settings.heading | default: 'RECRUTE STAGIAIRE'
-%}

{{ 'rs-hero-video.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap" rel="stylesheet">

<section
  class="rs-home-landing shopify-section section-rs-home-landing"
  id="shopify-section-{{ section.id }}"
  data-rs-heading="{{ heading_text | escape }}"
  {{ section.shopify_attributes }}>
  {%- if bg != blank -%}
    {{
      bg
      | image_url: width: 3840
      | image_tag:
        class: 'rs-landing-bg',
        widths: '750, 1100, 1500, 1920, 2400, 3200, 3840',
        sizes: '250vw',
        loading: 'eager',
        alt: ''
    }}
  {%- else -%}
    <img
      class="rs-landing-bg"
      src="{{ 'pagedacceuil .jpg' | asset_url }}"
      alt=""
      width="2400"
      height="1600"
      loading="eager"
      decoding="async">
  {%- endif -%}

  <div class="rs-landing-overlay">
    <div class="rs-landing-overlay__form">
      <div class="rs-hero-video__content rs-landing-overlay__waitlist">
        {%- form 'customer', id: 'rs-waitlist-form', class: 'rs-landing-overlay__form-inner' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,waiting-list">
          {%- if form.posted_successfully? -%}
            <p class="rs-hero-video__subtitle rs-landing-overlay__success" role="status">
              {{ section.settings.success_message | default: 'Tu es sur la liste.' | escape }}
            </p>
          {%- else -%}
            {%- if form.errors -%}
              <p class="rs-landing-overlay__error" role="alert">{{ form.errors | default_errors }}</p>
            {%- endif -%}

            <div class="rs-hero-video__badge">
              <span class="rs-hero-video__badge-dot"></span>
              <span>{{ section.settings.form_label | default: 'REJOINS LA LISTE' | escape }}</span>
            </div>

            <div class="rs-hero-video__search">
              <span class="rs-hero-video__search-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="10.5" cy="10.5" r="6.25" stroke="currentColor" stroke-width="2" fill="none"/>
                  <path d="M15.2 15.2 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
                </svg>
              </span>
              <label class="visually-hidden" for="rs-waitlist-email">{{ section.settings.form_label | default: 'REJOINS LA LISTE' | escape }}</label>
              <input
                id="rs-waitlist-email"
                class="rs-hero-video__search-input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ section.settings.email_placeholder | default: 'ton@email.com' | escape }}"
                autocomplete="email"
                required
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                {% endif %}>
              <button type="submit" class="rs-hero-video__search-btn">
                <span class="rs-btn-full">{{ section.settings.submit_label | default: 'REJOINDRE' | escape }}</span>
                <span class="rs-btn-short" aria-hidden="true">→</span>
              </button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <div class="rs-landing-overlay__ctas">
      <a class="rs-landing-overlay__cta" href="{{ portal_url }}" rel="noopener noreferrer">LE PORTAIL →</a>
      <a class="rs-landing-overlay__cta" href="{{ lookbook_url }}">LOOKBOOK ABCDRS →</a>
    </div>
  </div>
</section>

<style>
  .section-rs-home-landing {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    min-height: 100dvh;
  }

  @media (max-width: 767.98px) {
    html.rs-home-landing-active,
    body.rs-home-landing-active {
      overflow: hidden !important;
      height: 100% !important;
      width: 100% !important;
      position: fixed !important;
      inset: 0 !important;
      overscroll-behavior: none !important;
      touch-action: none;
    }

    body.rs-home-landing-active.rs-home-landing-panning {
      touch-action: none;
    }
  }

  body.rs-home-landing-active .rs-site-footer,
  body.rs-home-landing-active footer.footer {
    display: none !important;
  }

  body.rs-home-landing-active .rs-header-mobile-bar__menu-btn,
  body.rs-home-landing-active .rs-header-burger-btn,
  body.rs-home-landing-active #rs-header-mobile-menu-btn {
    display: none !important;
  }

  body.rs-home-landing-active .rs-ticker,
  body.rs-home-landing-active .rs-header-kitsch-pop,
  body.rs-home-landing-active .rs-ph-navdesk,
  body.rs-home-landing-active .rs-banner-top__actions,
  body.rs-home-landing-active .rs-ph-brandlink-title,
  body.rs-home-landing-active .rs-ph-brandlink-title-hit,
  body.rs-home-landing-active .rs-nav-brand__name.logo {
    display: none !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header {
    z-index: 20 !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-two-tier,
  body.rs-home-landing-active .header-wrap.rs-header.rs-header--scroll-solid .rs-header-two-tier {
    background: transparent !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
    border-bottom-color: rgba(255, 255, 255, 0.12) !important;
    box-shadow: none !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-ticker {
    display: none !important;
  }

  @media (min-width: 768px) {
    body.rs-home-landing-active .rs-header-mobile-bar {
      display: none !important;
    }

    body.rs-home-landing-active .rs-header-top-line {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      width: 100%;
      gap: 1rem;
    }

    body.rs-home-landing-active .rs-header-pole-brand.rs-banner-top {
      grid-column: 1;
      justify-self: start;
    }

    body.rs-home-landing-active .rs-home-header-title {
      grid-column: 2;
      justify-self: center;
      margin: 0;
      padding: 0;
      color: #fff;
      font-family: var(--font-display), var(--rs-font-display), 'Syne', sans-serif;
      font-weight: 800;
      font-size: 14px;
      line-height: 1.2;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-align: center;
      white-space: nowrap;
      text-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 1px 3px rgba(0, 0, 0, 0.45);
      pointer-events: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-home-header-title {
      color: #fff;
      -webkit-text-fill-color: #fff;
    }

    body.rs-home-landing-active .header-wrap.rs-header.rs-header--scroll-solid .rs-home-header-title {
      color: var(--accent, #f472b6);
      -webkit-text-fill-color: var(--accent, #f472b6);
      text-shadow: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-ph-brandlink-logo {
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
    }
  }

  @media (max-width: 767.98px) {
    body.rs-home-landing-active .rs-header-mobile-bar {
      display: grid !important;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      min-height: 64px;
      padding: 0 12px;
      position: relative;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__brand {
      grid-column: 1;
      justify-self: start;
      z-index: 2;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title {
      display: block !important;
      visibility: visible !important;
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
      width: max-content !important;
      max-width: calc(100% - 96px) !important;
      margin: 0 !important;
      padding: 0 !important;
      text-align: center !important;
      font-family: var(--font-display), var(--rs-font-display), 'Syne', sans-serif;
      font-weight: 800;
      font-size: clamp(11px, 3.4vw, 17px);
      letter-spacing: 0.045em;
      line-height: 1.15;
      text-transform: uppercase;
      white-space: nowrap;
      z-index: 3;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title .rs-brand-title-break {
      display: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-mobile-bar__title {
      color: #fff;
      -webkit-text-fill-color: #fff;
      text-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 1px 3px rgba(0, 0, 0, 0.45);
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-mobile-bar__logo {
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
    }
  }

  .rs-landing-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 250vw;
    height: 100vh;
    height: 100dvh;
    object-fit: cover;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    will-change: transform;
    transform: translateX(0px);
    z-index: 0;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .rs-landing-bg {
      width: 100vw;
      transform: translateX(0) !important;
    }
  }

  .rs-landing-overlay {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: calc(var(--rs-portal-header-h, 72px) + 16px) 20px calc(24px + env(safe-area-inset-bottom, 0px));
    pointer-events: none;
    box-sizing: border-box;
  }

  .rs-landing-overlay__form {
    width: 100%;
    max-width: 360px;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .rs-landing-overlay__waitlist.rs-hero-video__content {
    position: relative;
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
    transform: none;
    text-align: center;
    pointer-events: none;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search {
    pointer-events: none;
  }

  .rs-landing-overlay__waitlist input,
  .rs-landing-overlay__waitlist button,
  .rs-landing-overlay__waitlist label,
  .rs-landing-overlay__waitlist a,
  .rs-landing-overlay__waitlist textarea,
  .rs-landing-overlay__waitlist select {
    pointer-events: auto;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__badge {
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 12px;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search {
    margin-bottom: 0;
    width: 100%;
    max-width: 100%;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search input[type='email'],
  .rs-landing-overlay__waitlist .rs-hero-video__search-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    border: 0;
    background: transparent;
    font-size: 15px;
    color: var(--rs-color-ink);
    outline: none;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search input[type='email']::placeholder {
    color: var(--rs-color-muted);
  }

  .rs-landing-overlay__form-inner {
    width: 100%;
    margin: 0;
  }

  .rs-landing-overlay__success {
    margin: 0;
    color: #fff;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 15px;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
  }

  .rs-landing-overlay__error {
    margin: 0 0 10px;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12px;
    color: #ffb4b4;
    background: rgba(80, 0, 0, 0.35);
    border: 1px solid rgba(255, 120, 120, 0.35);
    text-align: center;
  }

  .rs-landing-overlay__ctas {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: auto;
    max-width: none;
    pointer-events: none;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .rs-landing-overlay__ctas {
      flex-direction: row;
      justify-content: center;
      gap: 12px;
    }
  }

  .rs-landing-overlay__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    padding: 12px 28px;
    border-radius: 999px;
    border: none;
    background: var(--rs-color-brand, #f472b6);
    color: #fff !important;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.03em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: auto;
    transition: background 0.15s ease, opacity 0.15s ease;
  }

  .rs-landing-overlay__cta:hover {
    background: var(--rs-color-brand-hover, #db2777);
    color: #fff !important;
    opacity: 0.95;
  }
</style>

<script>
  (function () {
    var section = document.querySelector('.rs-home-landing');
    if (!section) return;

    var bg = section.querySelector('.rs-landing-bg');
    if (!bg) return;

    document.documentElement.classList.add('rs-home-landing-active');
    document.body.classList.add('rs-home-landing-active');

    var heading = section.getAttribute('data-rs-heading') || 'RECRUTE STAGIAIRE';

    var isPanning = false;
    var panOriginX = 0;
    var touchCurrentX = 0;

    function isMobile() {
      return window.innerWidth < 768;
    }

    function getMaxDrag() {
      if (!isMobile()) return 0;
      return -(bg.offsetWidth - window.innerWidth);
    }

    function applyWallpaperX(x) {
      touchCurrentX = x;
      bg.style.transform = 'translateX(' + x + 'px)';
    }

    function resetDesktopBg() {
      if (!isMobile()) {
        isPanning = false;
        touchCurrentX = 0;
        panOriginX = 0;
        document.body.classList.remove('rs-home-landing-panning');
        bg.style.transform = 'translateX(0px)';
      }
    }

    function isInteractive(target) {
      if (!target) return false;
      return !!target.closest(
        'a, button, input, textarea, select, label, [contenteditable="true"]'
      );
    }

    function setupHeaderTitle() {
      var topLine = document.querySelector('.header-wrap .rs-header-top-line');
      if (!topLine || topLine.querySelector('.rs-home-header-title')) return;

      var title = document.createElement('p');
      title.className = 'rs-home-header-title';
      title.textContent = heading;
      topLine.appendChild(title);
    }

    function normalizeMobileHeaderTitle() {
      var mobileTitle = document.querySelector('.rs-header-mobile-bar__title');
      if (!mobileTitle) return;
      mobileTitle.textContent = heading;
    }

    document.addEventListener(
      'touchstart',
      function (e) {
        if (!isMobile()) return;
        if (!e.touches || e.touches.length !== 1) return;
        if (isInteractive(e.target)) return;

        isPanning = true;
        panOriginX = e.touches[0].clientX - touchCurrentX;
        document.body.classList.add('rs-home-landing-panning');
      },
      { passive: true, capture: true }
    );

    document.addEventListener(
      'touchmove',
      function (e) {
        if (!isMobile() || !isPanning) return;
        if (!e.touches || e.touches.length !== 1) return;

        e.preventDefault();

        var newX = e.touches[0].clientX - panOriginX;
        var max = getMaxDrag();
        newX = Math.min(0, Math.max(max, newX));
        applyWallpaperX(newX);
      },
      { passive: false, capture: true }
    );

    function endPan() {
      if (!isPanning) return;
      isPanning = false;
      panOriginX = touchCurrentX;
      document.body.classList.remove('rs-home-landing-panning');
    }

    document.addEventListener('touchend', endPan, { passive: true, capture: true });
    document.addEventListener('touchcancel', endPan, { passive: true, capture: true });

    window.addEventListener('resize', function () {
      if (!isMobile()) {
        resetDesktopBg();
        return;
      }
      var max = getMaxDrag();
      applyWallpaperX(Math.min(0, Math.max(max, touchCurrentX)));
    });

    setupHeaderTitle();
    normalizeMobileHeaderTitle();
    resetDesktopBg();

    bg.addEventListener('load', function () {
      if (!isMobile()) {
        resetDesktopBg();
        return;
      }
      var max = getMaxDrag();
      applyWallpaperX(Math.min(0, Math.max(max, touchCurrentX)));
    });

    document.addEventListener('shopify:section:load', function (ev) {
      if (ev.target && ev.target.contains && ev.target.contains(section)) {
        setupHeaderTitle();
        normalizeMobileHeaderTitle();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Accueil waiting list",
  "tag": "section",
  "class": "section-rs-home-landing",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Image de fond (wallpaper)",
      "info": "Uploader pagedacceuil.jpg dans Fichiers Shopify. Sinon : asset theme pagedacceuil.jpg."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre header",
      "default": "RECRUTE STAGIAIRE"
    },
    {
      "type": "text",
      "id": "form_label",
      "label": "Label formulaire",
      "default": "REJOINS LA LISTE"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Placeholder email",
      "default": "ton@email.com"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Libellé bouton",
      "default": "REJOINDRE"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Message de confirmation",
      "default": "Tu es sur la liste."
    },
    {
      "type": "text",
      "id": "portal_label",
      "label": "Bouton portail",
      "default": "LE PORTAIL →"
    },
    {
      "type": "url",
      "id": "portal_url",
      "label": "URL portail"
    },
    {
      "type": "text",
      "id": "lookbook_label",
      "label": "Bouton lookbook",
      "default": "LOOKBOOK ABCDRS →"
    },
    {
      "type": "url",
      "id": "lookbook_url",
      "label": "URL lookbook"
    }
  ],
  "presets": [
    {
      "name": "Accueil waiting list"
    }
  ]
}
{% endschema %}
