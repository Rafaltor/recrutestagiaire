{%- liquid
  assign bg = section.settings.background_image
  assign portal_url = section.settings.portal_url | default: 'https://portail.recrutestagiaire.eu'
  assign lookbook_url = section.settings.lookbook_url | default: 'https://recrutestagiaire.eu/collections/abcdrs'
  assign heading_text = section.settings.heading | default: 'RECRUTE STAGIAIRE'
-%}

{{ 'rs-hero-video.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap" rel="stylesheet">

<section
  class="rs-home-landing shopify-section section-rs-home-landing"
  id="shopify-section-{{ section.id }}"
  data-rs-heading="{{ heading_text | escape }}"
  {{ section.shopify_attributes }}>
  <div class="rs-home-landing__viewport" data-rs-home-viewport>
    <div class="rs-home-landing__scene" data-rs-home-scene>
      <div class="rs-home-landing__media" aria-hidden="true">
        {%- if bg != blank -%}
          {{
            bg
            | image_url: width: 3840
            | image_tag:
              class: 'rs-home-landing__bg',
              widths: '750, 1100, 1500, 1920, 2400, 3200, 3840',
              sizes: '100vw',
              loading: 'eager',
              alt: ''
          }}
        {%- else -%}
          <img
            class="rs-home-landing__bg"
            data-rs-home-bg
            src="{{ 'pagedacceuil.jpg' | asset_url }}"
            alt=""
            width="2400"
            height="1600"
            loading="eager"
            decoding="async">
        {%- endif -%}
      </div>

      <div class="rs-home-landing__scene-ui">
        <a
          class="rs-home-landing__hotspot rs-home-landing__hotspot--portal rs-btn--primary text-decoration-none"
          href="{{ portal_url }}"
          rel="noopener noreferrer">
          {{ section.settings.portal_label | default: 'LE PORTAIL →' | escape }}
        </a>

        <div class="rs-home-landing__hotspot rs-home-landing__hotspot--form">
          {%- form 'customer', id: 'rs-waitlist-form', class: 'rs-home-landing__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,waiting-list">
            {%- if form.posted_successfully? -%}
              <p class="rs-home-landing__success" role="status">{{ section.settings.success_message | default: 'Tu es sur la liste.' | escape }}</p>
            {%- else -%}
              {%- if form.errors -%}
                <p class="rs-home-landing__error" role="alert">{{ form.errors | default_errors }}</p>
              {%- endif -%}
              <p class="rs-home-landing__form-kicker">{{ section.settings.form_label | default: 'REJOINS LA LISTE' | escape }}</p>
              <div class="rs-hero-video__search rs-home-landing__waitlist-bar">
                <label class="visually-hidden" for="rs-waitlist-email">{{ section.settings.form_label | default: 'REJOINS LA LISTE' | escape }}</label>
                <input
                  id="rs-waitlist-email"
                  class="rs-home-landing__waitlist-input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="{{ section.settings.email_placeholder | default: 'ton@email.com' | escape }}"
                  autocomplete="email"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                  {% endif %}>
                <button type="submit" class="rs-hero-video__search-btn">
                  <span class="rs-btn-full">{{ section.settings.submit_label | default: 'REJOINDRE' | escape }}</span>
                  <span class="rs-btn-short" aria-hidden="true">→</span>
                </button>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>

        <a class="rs-home-landing__hotspot rs-home-landing__hotspot--lookbook rs-btn--primary text-decoration-none" href="{{ lookbook_url }}">
          {{ section.settings.lookbook_label | default: 'LOOKBOOK ABCDRS →' | escape }}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .section-rs-home-landing {
    margin: 0;
    padding: 0;
  }

  body.rs-home-landing-active .rs-site-footer,
  body.rs-home-landing-active footer.footer {
    display: none !important;
  }

  body.rs-home-landing-active .rs-header-mobile-bar__menu-btn,
  body.rs-home-landing-active .rs-header-burger-btn,
  body.rs-home-landing-active #rs-header-mobile-menu-btn {
    display: none !important;
  }

  body.rs-home-landing-active .rs-ticker,
  body.rs-home-landing-active .rs-header-kitsch-pop,
  body.rs-home-landing-active .rs-ph-navdesk,
  body.rs-home-landing-active .rs-banner-top__actions,
  body.rs-home-landing-active .rs-ph-brandlink-title,
  body.rs-home-landing-active .rs-ph-brandlink-title-hit,
  body.rs-home-landing-active .rs-nav-brand__name.logo {
    display: none !important;
  }

  @media (min-width: 768px) {
    body.rs-home-landing-active .rs-header-mobile-bar {
      display: none !important;
    }
  }

  @media (max-width: 767.98px) {
    body.rs-home-landing-active .rs-header-mobile-bar {
      display: grid !important;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 8px;
      min-height: 64px;
      padding: 0 12px;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title {
      display: block !important;
      visibility: visible !important;
      width: auto !important;
      height: auto !important;
      position: static !important;
      justify-self: center;
      text-align: center;
      font-family: var(--font-display), var(--rs-font-display), 'Syne', sans-serif;
      font-weight: 800;
      font-size: clamp(10px, 3.3vw, 17px);
      letter-spacing: 0.045em;
      line-height: 1.15;
      text-transform: uppercase;
      pointer-events: auto;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-mobile-bar__title {
      color: #fff;
      -webkit-text-fill-color: #fff;
      text-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 1px 3px rgba(0, 0, 0, 0.45);
    }
  }

  body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-two-tier,
  body.rs-home-landing-active .header-wrap.rs-header.rs-header--scroll-solid .rs-header-two-tier {
    background: transparent !important;
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
    border-bottom-color: rgba(255, 255, 255, 0.12) !important;
    box-shadow: none !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-ticker {
    display: none !important;
  }

  @media (min-width: 768px) {
    body.rs-home-landing-active .rs-header-top-line {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      width: 100%;
      gap: 1rem;
    }

    body.rs-home-landing-active .rs-header-pole-brand.rs-banner-top {
      grid-column: 1;
      justify-self: start;
    }

    body.rs-home-landing-active .rs-home-header-title {
      grid-column: 2;
      justify-self: center;
      margin: 0;
      padding: 0;
      color: #fff;
      font-family: var(--font-display), var(--rs-font-display), 'Syne', sans-serif;
      font-weight: 800;
      font-size: 14px;
      line-height: 1.2;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-align: center;
      white-space: nowrap;
      text-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 1px 3px rgba(0, 0, 0, 0.45);
      pointer-events: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-home-header-title {
      color: #fff;
      -webkit-text-fill-color: #fff;
    }

    body.rs-home-landing-active .header-wrap.rs-header.rs-header--scroll-solid .rs-home-header-title {
      color: var(--accent, #f472b6);
      -webkit-text-fill-color: var(--accent, #f472b6);
      text-shadow: none;
    }
  }

  body.rs-portal-header.rs-home-landing-active main > .shopify-section.section-rs-home-landing:first-child {
    margin-top: calc(-1 * var(--rs-portal-header-h, 140px));
    position: relative;
    z-index: 0;
  }

  .rs-home-landing {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    touch-action: pan-y;
  }

  .rs-home-landing.rs-home-landing--panning {
    touch-action: none;
  }

  .rs-home-landing__viewport {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .rs-home-landing--mobile-pan .rs-home-landing__viewport {
    cursor: grab;
  }

  .rs-home-landing--mobile-pan.rs-home-landing--panning .rs-home-landing__viewport {
    cursor: grabbing;
  }

  .rs-home-landing__scene {
    position: absolute;
    top: 0;
    left: 50%;
    height: 100%;
    width: 100%;
    will-change: transform;
  }

  .rs-home-landing__media,
  .rs-home-landing__scene-ui {
    position: absolute;
    inset: 0;
  }

  .rs-home-landing__bg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .rs-home-landing__scene-ui {
    pointer-events: none;
    z-index: 1;
  }

  .rs-home-landing__hotspot {
    position: absolute;
    pointer-events: auto;
    z-index: 2;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 13px;
    white-space: nowrap;
  }

  .rs-home-landing__hotspot--portal {
    left: 5%;
    top: 50%;
    transform: translateY(-50%);
  }

  .rs-home-landing__hotspot--form {
    left: 50%;
    top: 54%;
    transform: translate(-50%, -50%);
    width: min(280px, 86vw);
    max-width: 360px;
  }

  .rs-home-landing__hotspot--lookbook {
    right: 5%;
    bottom: 10%;
    left: auto;
    top: auto;
    transform: none;
  }

  @media (min-width: 768px) {
    .rs-home-landing__hotspot--form {
      width: 360px;
    }

    .rs-home-landing__hotspot--portal {
      left: 8%;
    }

    .rs-home-landing__hotspot--lookbook {
      right: 8%;
      bottom: 12%;
    }
  }

  .rs-home-landing__form {
    width: 100%;
    margin: 0;
  }

  .rs-home-landing__form-kicker {
    margin: 0 0 10px;
    color: #fff;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-align: center;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
  }

  .rs-home-landing__waitlist-bar {
    margin-bottom: 0;
    width: 100%;
    max-width: 100%;
  }

  .rs-home-landing__waitlist-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    border: 0;
    background: transparent;
    font-size: 15px;
    color: var(--rs-color-ink, #0a0a0a);
    outline: none;
  }

  .rs-home-landing__waitlist-input::placeholder {
    color: var(--rs-color-muted, #6b7280);
  }

  .rs-home-landing__success,
  .rs-home-landing__error {
    margin: 0;
    padding: 14px 16px;
    border-radius: 12px;
    text-align: center;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .rs-home-landing__success {
    color: #fff;
    background: rgba(10, 10, 10, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.22);
  }

  .rs-home-landing__error {
    color: #ffb4b4;
    background: rgba(80, 0, 0, 0.35);
    border: 1px solid rgba(255, 120, 120, 0.35);
    font-size: 12px;
    margin-bottom: 8px;
  }
</style>

<script>
  (function () {
    var section = document.querySelector('.rs-home-landing');
    if (!section) return;

    var MOBILE_MQ = '(max-width: 767.98px)';
    var viewport = section.querySelector('[data-rs-home-viewport]');
    var scene = section.querySelector('[data-rs-home-scene]');
    var bg = section.querySelector('.rs-home-landing__bg');
    if (!viewport || !scene || !bg) return;

    document.body.classList.add('rs-home-landing-active');

    var heading = section.getAttribute('data-rs-heading') || 'RECRUTE STAGIAIRE';
    var offsetX = 0;
    var dragging = false;
    var pointerId = null;
    var startX = 0;
    var startOffset = 0;
    var mobileMq = window.matchMedia(MOBILE_MQ);

    function isMobile() {
      return mobileMq.matches;
    }

    function setupHeaderTitle() {
      var topLine = document.querySelector('.header-wrap .rs-header-top-line');
      if (!topLine || topLine.querySelector('.rs-home-header-title')) return;

      var title = document.createElement('p');
      title.className = 'rs-home-header-title';
      title.textContent = heading;
      topLine.appendChild(title);
    }

    function getSceneWidth() {
      return scene.offsetWidth || viewport.clientWidth;
    }

    function getMaxOffset() {
      var vw = viewport.clientWidth;
      var sceneW = getSceneWidth();
      return Math.max(0, (sceneW - vw) / 2);
    }

    function clampOffset() {
      var max = getMaxOffset();
      if (offsetX > max) offsetX = max;
      if (offsetX < -max) offsetX = -max;
    }

    function applyTransform() {
      clampOffset();
      scene.style.transform = 'translateX(calc(-50% + ' + offsetX + 'px))';
    }

    function updateSceneSize() {
      var vw = viewport.clientWidth;
      var vh = viewport.clientHeight || window.innerHeight;

      if (!isMobile()) {
        scene.style.width = vw + 'px';
        offsetX = 0;
        applyTransform();
        return;
      }

      var nw = bg.naturalWidth;
      var nh = bg.naturalHeight;
      if (!nw || !nh) {
        nw = 2400;
        nh = 1600;
      }

      var coverW = vh * (nw / nh);
      var sceneW = Math.max(vw * 1.5, coverW);
      scene.style.width = Math.ceil(sceneW) + 'px';
      clampOffset();
      applyTransform();
    }

    function setMode() {
      var mobile = isMobile();
      section.classList.toggle('rs-home-landing--mobile-pan', mobile);
      updateSceneSize();
    }

    function isInteractiveTarget(el) {
      if (!el || !section.contains(el)) return false;
      return !!el.closest('a, button, input, label, textarea, select, form, .rs-home-landing__hotspot');
    }

    function onPointerDown(e) {
      if (!isMobile() || isInteractiveTarget(e.target)) return;

      dragging = true;
      pointerId = e.pointerId != null ? e.pointerId : 'touch';
      startX = e.clientX != null ? e.clientX : (e.touches && e.touches[0] ? e.touches[0].clientX : 0);
      startOffset = offsetX;
      section.classList.add('rs-home-landing--panning');

      if (viewport.setPointerCapture && e.pointerId != null) {
        try {
          viewport.setPointerCapture(e.pointerId);
        } catch (err) {}
      }
    }

    function onPointerMove(e) {
      if (!dragging || !isMobile()) return;
      if (e.pointerId != null && pointerId != null && e.pointerId !== pointerId) return;

      var x = e.clientX != null ? e.clientX : (e.touches && e.touches[0] ? e.touches[0].clientX : startX);
      offsetX = startOffset + (x - startX);
      applyTransform();
    }

    function onPointerUp(e) {
      if (!dragging) return;
      if (e.pointerId != null && pointerId != null && e.pointerId !== pointerId) return;

      dragging = false;
      pointerId = null;
      section.classList.remove('rs-home-landing--panning');
      clampOffset();
      applyTransform();

      if (viewport.releasePointerCapture && e.pointerId != null) {
        try {
          viewport.releasePointerCapture(e.pointerId);
        } catch (err) {}
      }
    }

    setupHeaderTitle();
    setMode();

    viewport.addEventListener('pointerdown', onPointerDown, { passive: true });
    viewport.addEventListener('pointermove', onPointerMove, { passive: true });
    viewport.addEventListener('pointerup', onPointerUp);
    viewport.addEventListener('pointercancel', onPointerUp);

    viewport.addEventListener(
      'touchstart',
      function (e) {
        if (!isMobile() || isInteractiveTarget(e.target)) return;
        onPointerDown({ clientX: e.touches[0].clientX, pointerId: e.touches[0].identifier });
      },
      { passive: true }
    );

    viewport.addEventListener(
      'touchmove',
      function (e) {
        if (!dragging) return;
        e.preventDefault();
        onPointerMove({ clientX: e.touches[0].clientX, pointerId: e.touches[0].identifier });
      },
      { passive: false }
    );

    viewport.addEventListener('touchend', onPointerUp);
    viewport.addEventListener('touchcancel', onPointerUp);

    if (typeof mobileMq.addEventListener === 'function') {
      mobileMq.addEventListener('change', setMode);
    } else if (typeof mobileMq.addListener === 'function') {
      mobileMq.addListener(setMode);
    }

    window.addEventListener('resize', setMode);

    if (bg.complete) {
      setMode();
    } else {
      bg.addEventListener('load', setMode, { once: true });
    }

    document.addEventListener('shopify:section:load', function (ev) {
      if (ev.target && ev.target.contains && ev.target.contains(section)) {
        setupHeaderTitle();
        setMode();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Accueil waiting list",
  "tag": "section",
  "class": "section-rs-home-landing",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Image de fond (parallax)",
      "info": "Uploader pagedacceuil.jpg dans Fichiers Shopify, puis sélectionner ici. Sinon : asset theme pagedacceuil.jpg."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre header (desktop)",
      "default": "RECRUTE STAGIAIRE"
    },
    {
      "type": "text",
      "id": "form_label",
      "label": "Label formulaire",
      "default": "REJOINS LA LISTE"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Placeholder email",
      "default": "ton@email.com"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Libellé bouton",
      "default": "REJOINDRE"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Message de confirmation",
      "default": "Tu es sur la liste."
    },
    {
      "type": "text",
      "id": "portal_label",
      "label": "Bouton portail",
      "default": "LE PORTAIL →"
    },
    {
      "type": "url",
      "id": "portal_url",
      "label": "URL portail"
    },
    {
      "type": "text",
      "id": "lookbook_label",
      "label": "Bouton lookbook",
      "default": "LOOKBOOK ABCDRS →"
    },
    {
      "type": "url",
      "id": "lookbook_url",
      "label": "URL lookbook"
    }
  ],
  "presets": [
    {
      "name": "Accueil waiting list"
    }
  ]
}
{% endschema %}
