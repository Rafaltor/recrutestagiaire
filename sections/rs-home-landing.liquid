{%- liquid
  assign bg = section.settings.background_image
  assign portal_url = section.settings.portal_url | default: 'https://portail.recrutestagiaire.eu'
  assign lookbook_url = section.settings.lookbook_url | default: 'https://recrutestagiaire.eu/collections/abcdrs'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700&display=swap" rel="stylesheet">

<section
  class="rs-home-landing shopify-section section-rs-home-landing"
  id="shopify-section-{{ section.id }}"
  {{ section.shopify_attributes }}>
  <div class="rs-home-landing__bg-wrap" aria-hidden="true">
    {%- if bg != blank -%}
      {{
        bg
        | image_url: width: 3840
        | image_tag:
          class: 'rs-home-landing__bg',
          widths: '750, 1100, 1500, 1920, 2400, 3200, 3840',
          sizes: '150vw',
          loading: 'eager',
          alt: ''
      }}
    {%- else -%}
      <img
        class="rs-home-landing__bg"
        src="{{ 'pagedacceuil.jpg' | asset_url }}"
        alt=""
        width="2400"
        height="1600"
        loading="eager"
        decoding="async">
    {%- endif -%}
  </div>

  <div class="rs-home-landing__content">
    {%- if settings.logo != blank -%}
      {{
        settings.logo
        | image_url: width: 160
        | image_tag:
          class: 'rs-home-landing__logo',
          alt: shop.name,
          width: 80,
          height: 80,
          loading: 'eager'
      }}
    {%- else -%}
      <img
        class="rs-home-landing__logo"
        src="{{ 'rs-logo-eu.png' | asset_url }}"
        alt="{{ shop.name | escape }}"
        width="80"
        height="80"
        loading="eager"
        decoding="async">
    {%- endif -%}

    <h1 class="rs-home-landing__title">{{ section.settings.heading | default: 'RECRUTE STAGIAIRE' | escape }}</h1>

    <div class="rs-home-landing__form-wrap">
      {%- form 'customer', id: 'rs-waitlist-form', class: 'rs-home-landing__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,waiting-list">
        {%- if form.posted_successfully? -%}
          <p class="rs-home-landing__success" role="status">{{ section.settings.success_message | default: 'Tu es sur la liste.' | escape }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="rs-home-landing__error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <label class="rs-home-landing__label" for="rs-waitlist-email">{{ section.settings.form_label | default: 'REJOINS LA LISTE' | escape }}</label>
          <div class="rs-home-landing__fields">
            <input
              id="rs-waitlist-email"
              class="rs-home-landing__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.email_placeholder | default: 'ton@email.com' | escape }}"
              autocomplete="email"
              required
              {% if form.errors contains 'email' %}
                aria-invalid="true"
              {% endif %}>
            <button type="submit" class="rs-home-landing__submit">
              {{ section.settings.submit_label | default: 'REJOINDRE' | escape }}
            </button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="rs-home-landing__ctas">
      <a class="rs-home-landing__cta" href="{{ portal_url }}" rel="noopener noreferrer">
        {{ section.settings.portal_label | default: 'LE PORTAIL →' | escape }}
      </a>
      <a class="rs-home-landing__cta" href="{{ lookbook_url }}">
        {{ section.settings.lookbook_label | default: 'LOOKBOOK ABCDRS →' | escape }}
      </a>
    </div>
  </div>
</section>

<style>
  .section-rs-home-landing {
    margin: 0;
    padding: 0;
  }

  body[data-rs-page='index'] .rs-site-footer,
  body[data-rs-page='index'] footer.footer {
    display: none !important;
  }

  body[data-rs-page='index'] .rs-header-mobile-bar__menu-btn,
  body[data-rs-page='index'] .rs-header-burger-btn,
  body[data-rs-page='index'] #rs-header-mobile-menu-btn {
    display: none !important;
  }

  body.rs-portal-header[data-rs-page='index'] main > .shopify-section.section-rs-home-landing:first-child {
    margin-top: calc(-1 * var(--rs-portal-header-h, 140px));
    position: relative;
    z-index: 0;
  }

  .rs-home-landing {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
  }

  .rs-home-landing__bg-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .rs-home-landing__bg {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150%;
    height: 100%;
    min-height: 100%;
    object-fit: cover;
    object-position: center center;
    transform: translate(-50%, -50%);
    animation: rs-home-parallax-pan 48s linear infinite;
    will-change: transform;
  }

  @keyframes rs-home-parallax-pan {
    0% {
      transform: translate(-50%, -50%) translateX(12.5%);
    }
    100% {
      transform: translate(-50%, -50%) translateX(-12.5%);
    }
  }

  .rs-home-landing__content {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: calc(var(--rs-portal-header-h, 120px) + 1.5rem) 1.25rem 2.5rem;
    text-align: center;
  }

  .rs-home-landing__logo {
    height: 80px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.35));
  }

  .rs-home-landing__title {
    margin: 0;
    color: #fff;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: 4px;
    text-transform: uppercase;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
  }

  @media (min-width: 768px) {
    .rs-home-landing__title {
      font-size: 40px;
    }
  }

  .rs-home-landing__form-wrap {
    width: 100%;
    max-width: 360px;
    margin-top: 0.25rem;
  }

  .rs-home-landing__form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
  }

  .rs-home-landing__label {
    display: block;
    margin: 0;
    color: #fff;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .rs-home-landing__fields {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.65rem;
    width: min(280px, 100%);
  }

  @media (min-width: 768px) {
    .rs-home-landing__fields {
      width: 360px;
    }
  }

  .rs-home-landing__input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 16px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.15);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #fff;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    outline: none;
  }

  .rs-home-landing__input::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  .rs-home-landing__input:focus-visible {
    border-color: rgba(255, 255, 255, 0.55);
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.15);
  }

  .rs-home-landing__submit {
    align-self: center;
    padding: 12px 24px;
    border: none;
    border-radius: 4px;
    background: #fff;
    color: #0a0a0a;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.18s ease;
  }

  .rs-home-landing__submit:hover {
    opacity: 0.92;
  }

  .rs-home-landing__success,
  .rs-home-landing__error {
    margin: 0;
    color: #fff;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    letter-spacing: 0.02em;
  }

  .rs-home-landing__error {
    color: #ffb4b4;
    font-size: 12px;
  }

  .rs-home-landing__ctas {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  @media (min-width: 768px) {
    .rs-home-landing__ctas {
      flex-direction: row;
      justify-content: center;
      gap: 1rem;
    }
  }

  .rs-home-landing__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border-radius: 4px;
    border: 1px solid #fff;
    background: transparent;
    color: #fff;
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background 0.18s ease,
      color 0.18s ease;
  }

  .rs-home-landing__cta:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
</style>

{% schema %}
{
  "name": "Accueil waiting list",
  "tag": "section",
  "class": "section-rs-home-landing",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Image de fond (parallax)",
      "info": "Uploader pagedacceuil.jpg dans Fichiers Shopify, puis sélectionner ici. Sinon : asset theme pagedacceuil.jpg."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "RECRUTE STAGIAIRE"
    },
    {
      "type": "text",
      "id": "form_label",
      "label": "Label formulaire",
      "default": "REJOINS LA LISTE"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Placeholder email",
      "default": "ton@email.com"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Libellé bouton",
      "default": "REJOINDRE"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Message de confirmation",
      "default": "Tu es sur la liste."
    },
    {
      "type": "text",
      "id": "portal_label",
      "label": "Bouton portail",
      "default": "LE PORTAIL →"
    },
    {
      "type": "url",
      "id": "portal_url",
      "label": "URL portail"
    },
    {
      "type": "text",
      "id": "lookbook_label",
      "label": "Bouton lookbook",
      "default": "LOOKBOOK ABCDRS →"
    },
    {
      "type": "url",
      "id": "lookbook_url",
      "label": "URL lookbook"
    }
  ],
  "presets": [
    {
      "name": "Accueil waiting list"
    }
  ]
}
{% endschema %}
