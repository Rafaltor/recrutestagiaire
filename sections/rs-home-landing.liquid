  @media (max-width: 767.98px) {
    body.rs-home-landing-active .rs-header-mobile-bar {
      display: grid !important;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      min-height: 64px;
      padding: 0 12px;
      position: relative;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__brand {
      grid-column: 1;
      justify-self: start;
      z-index: 2;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title {
      display: block !important;
      visibility: visible !important;
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      transform: translate(-50%, -50%) !important;
      width: max-content !important;
      max-width: calc(100% - 96px) !important;
      margin: 0 !important;
      padding: 0 !important;
      text-align: center !important;
      font-family: var(--font-display), var(--rs-font-display), 'Syne', sans-serif;
      font-weight: 800;
      font-size: clamp(11px, 3.4vw, 17px);
      letter-spacing: 0.045em;
      line-height: 1.15;
      text-transform: uppercase;
      white-space: nowrap;
      z-index: 3;
    }

    body.rs-home-landing-active .rs-header-mobile-bar__title .rs-brand-title-break {
      display: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-mobile-bar__title {
      color: #fff;
      -webkit-text-fill-color: #fff;
      text-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 1px 3px rgba(0, 0, 0, 0.45);
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-header-mobile-bar__logo {
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.4));
    }
  }

  /* Header toujours lisible sur l’accueil (clavier / scroll-solid) */
  body.rs-home-landing-active .header-wrap.rs-header .rs-header-mobile-bar__title,
  body.rs-home-landing-active .header-wrap.rs-header .rs-home-header-title {
    color: #fff !important;
    -webkit-text-fill-color: #fff !important;
    text-shadow:
      0 0 14px rgba(0, 0, 0, 0.55),
      0 1px 3px rgba(0, 0, 0, 0.5) !important;
  }

  body.rs-home-landing-active .header-wrap.rs-header .rs-header-mobile-bar__logo,
  body.rs-home-landing-active .header-wrap.rs-header .rs-ph-brandlink-logo {
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.45)) !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  body.rs-home-landing-active.rs-home-landing-input-focus .header-wrap.rs-header {
    z-index: 10000 !important;
    visibility: visible !important;
    opacity: 1 !important;
    transform: translate3d(0, 0, 0) !important;
  }

  /* Canvas panoramique — scroll horizontal natif (style drakerelated.com) */
  .rs-landing-scroller {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: auto;
    overflow: hidden;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .rs-landing-scroller::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .rs-landing-scroller__track {
    position: relative;
    height: 100%;
    height: 100dvh;
  }

  .rs-landing-scene {
    position: relative;
    width: 100%;
    height: 100%;
    height: 100dvh;
  }

  .rs-landing-bg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    max-width: none !important;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* Hotspots accrochés au wallpaper — bougent avec le slide */
  .rs-landing-hotspots {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .rs-landing-hotspots * {
    pointer-events: none;
  }

  .rs-landing-hotspots a,
  .rs-landing-hotspots button,
  .rs-landing-hotspots input,
  .rs-landing-hotspots label,
  .rs-landing-hotspots textarea,
  .rs-landing-hotspots select {
    pointer-events: auto;
  }

  .rs-landing-hotspot {
    position: absolute;
    z-index: 1;
  }

  .rs-landing-hotspot--portal {
    left: 20%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .rs-landing-hotspot--form {
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(320px, 82vw);
    max-width: 320px;
  }

  .rs-landing-hotspot--grillz {
    top: 80%;
    right: 20%;
    bottom: auto;
    transform: translate(50%, -50%);
  }

  @media (min-width: 768px) {
    .rs-landing-hotspot--form {
      width: min(360px, 32vw);
      max-width: 360px;
    }
  }

  @media (max-width: 767.98px) {
    .rs-landing-scroller {
      overflow-x: auto;
      overflow-y: hidden;
      touch-action: pan-x;
      overscroll-behavior-x: contain;
      overscroll-behavior-y: none;
    }

    .rs-landing-scroller__track {
      width: 250vw;
      min-width: 250vw;
    }

    .rs-landing-bg {
      object-fit: cover;
      object-position: center center;
    }
  }

  @media (min-width: 768px) {
    .rs-landing-scroller {
      overflow: hidden;
      touch-action: auto;
    }

    .rs-landing-scroller__track {
      width: 100vw;
      min-width: 100vw;
    }
  }

  .rs-landing-overlay__waitlist.rs-hero-video__content {
    position: relative;
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
    transform: none;
    text-align: center;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__badge {
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 12px;
    color: #0a0a0a;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(0, 0, 0, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .rs-landing-overlay__waitlist .rs-hero-video__badge span {
    color: #0a0a0a;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 0;
    width: 100%;
    max-width: 100%;
    height: auto;
    min-height: 0;
    padding: 7px 8px 7px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition:
