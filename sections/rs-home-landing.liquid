  }

  .rs-landing-overlay__waitlist .rs-hero-video__search-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: auto;
    min-height: auto;
    margin: 0;
    padding: 4px 6px !important;
    border-radius: 0 !important;
    border: 0 !important;
    background: transparent !important;
    color: #fff !important;
    font-family: 'Syne', sans-serif !important;
