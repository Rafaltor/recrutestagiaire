    border-color: rgba(255, 255, 255, 0.85);
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search-icon {
    flex: 0 0 auto;
    opacity: 1;
    color: rgba(255, 255, 255, 0.65);
    line-height: 0;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search-icon svg {
    display: block;
    width: 16px;
    height: 16px;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search input[type='email'],
  .rs-landing-overlay__waitlist .rs-hero-video__search-input {
    flex: 1 1 auto;
    min-width: 0;
    height: auto;
    min-height: 0;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    font-size: clamp(12px, 3.45vw, 14.5px);
    letter-spacing: 0.06em;
    color: #fff;
    outline: none;
    box-shadow: none;
  }

  .rs-landing-overlay__waitlist .rs-hero-video__search input[type='email']::placeholder {
