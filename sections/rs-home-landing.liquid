        0 1px 3px rgba(0, 0, 0, 0.45);
      pointer-events: none;
    }

    body.rs-home-landing-active .header-wrap.rs-header:not(.rs-header--scroll-solid) .rs-home-header-title {
      color: #fff;
      -webkit-text-fill-color: #fff;
    }

    body.rs-home-landing-active .header-wrap.rs-header.rs-header--scroll-solid .rs-home-header-title {
      color: var(--accent, #f472b6);
      -webkit-text-fill-color: var(--accent, #f472b6);
