{%- assign rs_url_profils = '/pages/profils-candidats' -%}
{%- assign rs_url_deposer = '/pages/deposer-candidature' -%}
{%- assign promo_count = 0 -%}
{%- assign has_pole_cta = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'side_promo' -%}
    {%- assign promo_count = promo_count | plus: 1 -%}
  {%- elsif block.type == 'pole_cta' -%}
    {%- assign has_pole_cta = true -%}
  {%- endif -%}
{%- endfor -%}
{%- assign search_col = 'col-12' -%}
{%- if has_pole_cta and promo_count > 0 -%}
  {%- assign search_col = 'col-12 col-lg-5' -%}
{%- elsif has_pole_cta -%}
  {%- assign search_col = 'col-12 col-lg-10' -%}
{%- elsif promo_count > 0 -%}
  {%- assign search_col = 'col-12 col-lg-7' -%}
{%- else -%}
  {%- assign search_col = 'col-12 col-lg-12' -%}
{%- endif -%}

<div
  class="hero-header home-4 rs-hero rs-hero--pole rs-hero--pole-pe"
  style="background:{{ section.settings.intro_bg }};padding:{{ section.settings.padding_top }}px 0 0;">
  <div class="container">
    <div class="rs-hero__intro {{ section.settings.text_align }} pb-3 pb-md-4">
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' -%}
          <div class="mb-2" {{ block.shopify_attributes }}>
            <span
              class="badge text-dark py-2 px-3"
              style="background:{{ block.settings.color }};font-size:{{ block.settings.size }}px;">
              {{ block.settings.text }}
            </span>
          </div>
        {%- elsif block.type == 'heading' -%}
          <h1
            class="rs-hero__title-pe mb-2 mb-md-3"
            style="font-size:{{ block.settings.size }}px;"
            {{ block.shopify_attributes }}>
            {{ block.settings.text | default: 'Les meilleures opportunités vestimentaires du moment.' }}
          </h1>
        {%- elsif block.type == 'subheading' -%}
          <p
            class="rs-hero__lede-pe mb-3 mb-md-4{% if section.settings.text_align == 'text-center' %} mx-auto{% endif %}"
            style="font-size:{{ block.settings.size }}px;max-width:{{ block.settings.max_width }}px;{% if section.settings.text_align == 'text-center' %}margin-left:auto;margin-right:auto;{% endif %}"
            {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </p>
        {%- elsif block.type == 'buttons' -%}
          <div class="rs-hero__actions rs-hero__actions--intro rs-intro-cta-row d-flex flex-wrap gap-2 {% if section.settings.text_align == 'text-center' %}justify-content-center{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.btn1_label != blank -%}
              <a
                href="{% if block.settings.btn1_url != blank %}{{ block.settings.btn1_url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
                class="abt-btn rs-caf-btn-dossier text-decoration-none d-inline-flex align-items-center justify-content-center fw-semibold">
                {{ block.settings.btn1_label }}
              </a>
            {%- endif -%}
            {%- if block.settings.btn2_label != blank -%}
              <a
                href="{% if block.settings.btn2_url != blank %}{{ block.settings.btn2_url }}{% else %}{{ rs_url_profils }}{% endif %}"
                class="abt-btn rs-caf-btn-dossier rs-intro-cta--profils text-decoration-none d-inline-flex align-items-center justify-content-center fw-semibold">
                {{ block.settings.btn2_label }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div
    class="rs-hero__pole-strip"
    style="background:linear-gradient(180deg,{{ section.settings.strip_bg }} 0%,{{ section.settings.strip_bg_dark }} 100%);padding:0 0 {{ section.settings.padding_bottom }}px;">
    <div class="container">
      <div class="row g-0 align-items-stretch rs-hero__tile-row rs-hero__strip-row">
        {%- if has_pole_cta -%}
          <div class="col-12 col-lg-2 rs-hero__tile rs-hero__strip-cell rs-hero__strip-cell--cta d-flex align-items-center justify-content-center">
            {%- assign rs_pole_done = false -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'pole_cta' -%}
                {%- unless rs_pole_done -%}
                {%- assign rs_pole_done = true -%}
              <a
                href="{% if block.settings.url != blank %}{{ block.settings.url }}{% else %}{{ rs_url_deposer }}{% endif %}"
                class="rs-hero__pole-orb text-decoration-none d-flex flex-column align-items-center justify-content-center my-3 my-lg-2"
                style="width:{{ block.settings.size }}px;height:{{ block.settings.size }}px;min-width:{{ block.settings.size }}px;background:{{ block.settings.circle_bg }};color:{{ block.settings.circle_text }};"
                {{ block.shopify_attributes }}>
                <span class="rs-hero__pole-orb-label">{{ block.settings.label }}</span>
                {%- if block.settings.sublabel != blank -%}
                  <span class="rs-hero__pole-orb-sub">{{ block.settings.sublabel }}</span>
                {%- endif -%}
              </a>
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="{{ search_col }} rs-hero__tile rs-hero__strip-cell rs-hero__strip-cell--search">
          <div class="rs-hero__panel rs-hero__search-strip-inner h-100 py-3 px-2 px-lg-3 d-flex flex-column justify-content-center">
            {%- if section.settings.strip_search_kicker != blank -%}
              <p class="rs-hero__strip-kicker text-white mb-2 fw-bold small text-uppercase mb-lg-3">
                {{ section.settings.strip_search_kicker }}
              </p>
            {%- endif -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'search_bar' -%}
                <div class="rs-hero__search rs-hero__search--pole" {{ block.shopify_attributes }}>
                  <div class="row g-2 align-items-stretch">
                    <div class="col-12">
                      <div class="formField icons rs-hero__pole-field">
                        <form action="{{ routes.search_url }}" method="get">
                          <input type="hidden" name="type" value="product">
                          <input
                            type="text"
                            name="q"
                            class="form-control w-100 rs-hero__pole-input"
                            style="height:{{ block.settings.height }}px;font-size:{{ block.settings.font_size }}px;"
                            placeholder="{{ block.settings.placeholder | default: 'Nom du poste, collection...' }}">
                          <i class="bi bi-search icon"></i>
                        </form>
                      </div>
                    </div>
                    <div class="col-12 col-md-8">
                      <a
                        href="{{ routes.all_products_collection_url }}"
                        class="btn btn-warning w-100 fw-semibold d-flex align-items-center justify-content-center rs-hero__pole-cta-btn"
                        style="min-height:{{ block.settings.height }}px;font-size:{{ block.settings.font_size }}px;">
                        {{ block.settings.btn_label | default: 'Voir toutes les offres' }}
                      </a>
                    </div>
                    {%- if block.settings.secondary_label != blank -%}
                      <div class="col-12 col-md-4 d-flex align-items-stretch">
                        <a
                          href="{% if block.settings.secondary_url != blank %}{{ block.settings.secondary_url }}{% else %}{{ rs_url_profils }}{% endif %}"
                          class="btn btn-light w-100 fw-semibold d-flex align-items-center justify-content-center border border-2 border-white text-dark"
                          style="min-height:{{ block.settings.height }}px;font-size:{{ block.settings.font_size | default: 14 | minus: 1 }}px;">
                          {{ block.settings.secondary_label }}
                        </a>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        {%- if promo_count > 0 -%}
          <div class="col-12 col-lg-5 rs-hero__tile rs-hero__side-stack rs-hero__strip-cell--promos d-flex flex-column">
            {%- for block in section.blocks -%}
              {%- if block.type == 'side_promo' -%}
              <article
                class="rs-fake-promo flex-grow-1"
                style="background:{{ block.settings.bg_color }};border:1px solid {{ block.settings.border_color }};color:{{ block.settings.text_color }};"
                {{ block.shopify_attributes }}>
                {%- if block.settings.kicker != blank -%}
                  <span class="rs-fake-promo__kicker" style="color:{{ block.settings.kicker_color }};">{{ block.settings.kicker }}</span>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h4 class="rs-fake-promo__title" style="color:{{ block.settings.title_color }};">{{ block.settings.title }}</h4>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="rs-fake-promo__text">{{ block.settings.text }}</p>
                {%- endif -%}
                {%- if block.settings.link_label != blank -%}
                  <a href="{% if block.settings.link_url != blank %}{{ block.settings.link_url }}{% else %}#{% endif %}" class="rs-fake-promo__link">{{ block.settings.link_label }}</a>
                {%- endif -%}
              </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

