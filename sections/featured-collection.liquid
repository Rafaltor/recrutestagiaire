      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Badge",
          "default": "Offres actives"
        },
        {
          "type": "color",
          "id": "eyebrow_bg",
          "label": "Couleur fond badge",
          "default": "#ffc107"
        },
        {
          "type": "range",
          "id": "eyebrow_size",
          "min": 9,
          "max": 15,
          "step": 1,
          "unit": "px",
          "label": "Taille badge",
          "default": 11
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Les offres du moment"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Couleur titre",
          "default": "#212529"
        },
        {
          "type": "range",
          "id": "heading_size",
          "min": 14,
          "max": 40,
          "step": 1,
          "unit": "px",
          "label": "Taille titre",
          "default": 22
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Sous-titre"
        },
        {
          "type": "color",
          "id": "subheading_color",
          "label": "Couleur sous-titre",
          "default": "#6c757d"
        },
        {
          "type": "range",
          "id": "subheading_size",
          "min": 11,
          "max": 20,
          "step": 1,
          "unit": "px",
          "label": "Taille sous-titre",
          "default": 14
        },
        {
          "type": "checkbox",
          "id": "show_link",
          "label": "Afficher le lien",
          "default": true
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Texte du lien",
          "default": "Voir toutes les offres"
        },
        {
          "type": "range",
          "id": "link_size",
          "min": 10,
          "max": 16,
          "step": 1,
          "unit": "px",
          "label": "Taille texte lien",
          "default": 13
        }
      ]
    },
    {
      "type": "product_grid",
      "name": "Grille produits",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "products_count",
          "min": 1,
          "max": 24,
          "step": 1,
          "label": "Nombre de produits",
          "default": 6
        },
        {
          "type": "header",
          "content": "Contenu des cartes"
        },
        {
          "type": "checkbox",
          "id": "show_type",
          "label": "Afficher rayon / univers",
          "default": false
        },
        {
          "type": "text",
          "id": "label_rayon",
          "label": "Libellé rayon",
          "default": "Rayon / univers"
        },
        {
          "type": "checkbox",
          "id": "show_vendor_line",
          "label": "Ligne marque + logistique",
          "default": false
        },
        {
          "type": "text",
          "id": "card_logistics",
          "label": "Texte logistique",
          "default": "Expédition France"
        },
        {
          "type": "checkbox",
          "id": "show_offer_meta",
          "label": "Bloc fiche (réf., prix, etc.)",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_location",
          "label": "Localisation (si ligne marque off)",
          "default": false
        },
        {
          "type": "text",
          "id": "location_text",
          "label": "Texte localisation",
          "default": "Paris, France"
        },
        {
          "type": "checkbox",
          "id": "show_tags",
          "label": "Afficher les tags",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_location_tag",
          "label": "Tag localisation",
          "default": false
        },
        {
          "type": "text",
          "id": "location_tag",
          "label": "Texte tag localisation",
          "default": "Paris"
        },
        {
          "type": "checkbox",
          "id": "show_price_tag",
          "label": "Tag prix",
          "default": false
