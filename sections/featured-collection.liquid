{%- assign featured_col = blank -%}
{%- if section.settings.collection != blank -%}
  {%- assign featured_col = collections[section.settings.collection] -%}
{%- endif -%}
{%- if featured_col != blank -%}
  {%- assign products_source = featured_col.products -%}
{%- elsif collections.frontpage != blank -%}
  {%- assign products_source = collections.frontpage.products -%}
{%- else -%}
  {%- assign products_source = collections.all.products -%}
{%- endif -%}
{%- assign col_class = 'col-12 col-md-6 col-lg-4 col-xl-4' -%}
{%- if section.settings.columns == '2' -%}{%- assign col_class = 'col-12 col-md-6 col-lg-6 col-xl-6' -%}{%- endif -%}
{%- if section.settings.columns == '4' -%}{%- assign col_class = 'col-12 col-md-6 col-lg-3 col-xl-3' -%}{%- endif -%}

{%- unless request.page_type == 'index' -%}
<section class="rs-tile-band" style="padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;background:{{ section.settings.bg_color }};border-top:1px solid #888;border-bottom:1px solid #888;">
  <div class="container">

    {%- for block in section.blocks -%}

      {%- if block.type == 'section_header' -%}
        <div class="d-flex align-items-center justify-content-between mb-4" {{ block.shopify_attributes }}>
          <div>
            {%- if block.settings.eyebrow != blank -%}
              <span class="badge text-dark mb-2"
                style="background:{{ block.settings.eyebrow_bg }};font-size:{{ block.settings.eyebrow_size }}px;">
                {{ block.settings.eyebrow }}
              </span>
            {%- endif -%}
            <h2 class="fw-bold mb-0"
              style="font-size:{{ block.settings.heading_size }}px;color:{{ block.settings.heading_color }};">
              {{ block.settings.heading | default: "Les offres du moment" }}
            </h2>
            {%- if block.settings.subheading != blank -%}
              <p class="mb-0 mt-1"
                style="font-size:{{ block.settings.subheading_size }}px;color:{{ block.settings.subheading_color }};">
                {{ block.settings.subheading }}
              </p>
            {%- endif -%}
          </div>
          {%- if block.settings.show_link and block.settings.link_label != blank -%}
            <a href="{{ featured_col.url | default: routes.all_products_collection_url }}"
              class="btn btn-outline-primary btn-sm"
              style="font-size:{{ block.settings.link_size }}px;">
              {{ block.settings.link_label }} →
            </a>
          {%- endif -%}
        </div>

      {%- elsif block.type == 'product_grid' -%}
        <div class="row g-3 rs-tile-grid rs-tile-grid--floating" {{ block.shopify_attributes }}>
          {%- for product in products_source limit: block.settings.products_count -%}
            <div class="{{ col_class }} d-flex align-items-stretch">
              <div class="w-100">
                {% assign _carousel_uid = section.id | append: '_' | append: block.id %}
                {% render 'rs-offer-grid-card', product: product, card_settings: block.settings, collection: featured_col, carousel_uid: _carousel_uid %}
              </div>
            </div>
          {%- else -%}
            <div class="col-12 text-center py-5 text-muted">
              <span class="d-block mb-3 text-muted" style="line-height:0;">{% render 'icon-folder-dossier', w: 48, h: 40 %}</span>
              Ajoutez des produits pour qu'ils apparaissent ici.
            </div>
          {%- endfor -%}
        </div>

      {%- endif -%}

    {%- endfor -%}

  </div>
</section>
{%- endunless -%}

{% schema %}
{
  "name": "Grille d'offres",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection à afficher"
