          "label": "Taille type/département",
          "default": 11
        },
        {
          "type": "range",
          "id": "tag_size",
          "min": 9,
          "max": 14,
          "step": 1,
          "unit": "px",
          "label": "Taille tags",
          "default": 12
        },
        {
          "type": "range",
          "id": "badge_size",
          "min": 9,
          "max": 14,
          "step": 1,
          "unit": "px",
          "label": "Taille badge statut",
          "default": 11
        }
      ]
