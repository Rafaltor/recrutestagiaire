        },
        {
          "type": "text",
          "id": "contract_label_cdd",
          "label": "Libellé CDD",
          "default": "CDD"
        },
        {
          "type": "textarea",
          "id": "contract_cdi_collection_handles",
          "label": "Handles collection → CDI",
          "default": "permanent,permanents",
          "info": "Handles Shopify, virgules ou lignes. Si la collection de la grille est listée → CDI, sinon → CDD. Tags « cdi » / « cdd » en priorité si l’option est cochée."
        },
        {
