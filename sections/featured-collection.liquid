          "max": 5,
          "step": 1,
          "label": "Nb max tags produit",
          "default": 1
        },
        {
          "type": "text",
          "id": "badge_open",
          "label": "Badge ouvert",
          "default": "Offre active"
        },
        {
          "type": "text",
          "id": "badge_closed",
          "label": "Badge pourvu",
          "default": "Pourvu"
        },
        {
          "type": "header",
          "content": "Cartes (style fiche PE)"
        },
        {
          "type": "range",
