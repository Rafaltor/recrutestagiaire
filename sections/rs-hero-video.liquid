{{ 'rs-hero-video.css' | asset_url | stylesheet_tag }}

{%- liquid
  if collections['les-stagiaires-de-base'] != blank
    assign search_action = collections['les-stagiaires-de-base'].url
  else
    assign search_action = '/collections/les-stagiaires-de-base'
  endif
  assign v_shopify = section.settings.background_video
  assign v_mp4 = section.settings.mp4_url | strip
  assign v_poster = section.settings.poster_image
-%}

<section
  class="rs-hero-video section-rs-hero-video"
  id="shopify-section-{{ section.id }}"
  {{ section.shopify_attributes }}>
  <div class="rs-hero-video__media-wrap" aria-hidden="true">
    {%- if v_shopify != blank -%}
      {{
        v_shopify
        | video_tag:
          image_size: '2048x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'rs-hero-video__el'
      }}
    {%- elsif v_mp4 != blank -%}
      <video
        class="rs-hero-video__el"
        autoplay
        muted
        loop
        playsinline
        webkit-playsinline
        preload="auto"
        {% if v_poster != blank %}
          poster="{{ v_poster | image_url: width: 1920 }}"
        {% endif %}>
        <source src="{{ v_mp4 }}" type="video/mp4">
      </video>
    {%- elsif v_poster != blank -%}
      {{
        v_poster
        | image_url: width: 2400
        | image_tag:
          class: 'rs-hero-video__el rs-hero-video__el--image',
          widths: '750, 1100, 1500, 1920, 2400',
          sizes: '100vw',
          loading: 'eager',
          alt: ''
      }}
    {%- endif -%}
  </div>
  <div class="rs-hero-video__overlay"></div>

  <div class="rs-hero-video__content container">
    {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
      <div class="rs-hero-video__badge">
        <span class="rs-hero-video__badge-dot"></span>
        <span>{{ section.settings.badge_text | escape }}</span>
      </div>
    {%- endif -%}

    <h1 class="rs-hero-video__title">
      {%- if section.settings.heading_line_1 != blank -%}
        <span class="rs-hero-video__title-line">{{ section.settings.heading_line_1 | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading_line_2 != blank or section.settings.heading_emphasis != blank -%}
        <span class="rs-hero-video__title-line">
          {{ section.settings.heading_line_2 | escape }}{% if section.settings.heading_emphasis != blank %}
            <span class="rs-hero-video__title-accent"> {{ section.settings.heading_emphasis | escape }}</span>
          {% endif %}
        </span>
      {%- endif -%}
    </h1>

    {%- if section.settings.subtitle != blank -%}
      <p class="rs-hero-video__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    <div class="rs-hero-video__search">
      <span class="rs-hero-video__search-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.25" stroke="currentColor" stroke-width="2" fill="none"/>
          <path d="M15.2 15.2 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
        </svg>
      </span>
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ section.settings.search_placeholder | escape }}"
        autocomplete="off"
        aria-label="{{ section.settings.search_placeholder | escape }}">
      <a class="rs-hero-video__search-btn" href="{{ search_action }}">
        <span class="rs-btn-full">Voir les offres</span><span class="rs-btn-short" aria-hidden="true">→</span>
      </a>
    </div>

    {%- liquid
      assign portal_href = section.settings.portal_url | default: 'https://portail.recrutestagiaire.eu' | strip
      if portal_href == blank
        assign portal_href = 'https://portail.recrutestagiaire.eu'
      endif
      assign portal_lbl = section.settings.portal_label | default: 'Portail Candidat' | strip
    -%}
    {%- if portal_lbl != blank -%}
      <div class="rs-hero-video__portal">
        <a class="rs-hero-video__portal-btn text-decoration-none" href="{{ portal_href }}" rel="noopener noreferrer">
          {{- portal_lbl | escape -}}
        </a>
      </div>
    {%- endif -%}

    {%- assign stat_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'stat' -%}
        {%- assign stat_count = stat_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if stat_count > 0 -%}
      <div class="rs-hero-video__stats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="rs-hero-video__stat" {{ block.shopify_attributes }}>
              <span class="rs-hero-video__stat-val">{{ block.settings.value | escape }}</span>
              <span class="rs-hero-video__stat-lbl">{{ block.settings.label | escape }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    function rsHomeHeaderUnderHero() {
      if (document.body.getAttribute('data-rs-page') !== 'index') return;
      var h = document.querySelector('.header-wrap');
      if (!h) return;
      var px = Math.ceil(h.getBoundingClientRect().height);
      if (px < 1) px = h.offsetHeight || 168;
      document.documentElement.style.setProperty('--rs-home-header-h', px + 'px');
    }
    rsHomeHeaderUnderHero();
    document.addEventListener('DOMContentLoaded', rsHomeHeaderUnderHero);
    window.addEventListener('resize', rsHomeHeaderUnderHero);
    document.addEventListener('shopify:section:load', rsHomeHeaderUnderHero);
  })();
</script>

<script>
  (function () {
    var _observed = new WeakSet();

    function rsPlayVideo(v) {
      if (_observed.has(v) && !v.paused) return;
      v.muted = true;
      v.defaultMuted = true;
      v.setAttribute('muted', '');
      v.setAttribute('playsinline', '');
      v.setAttribute('webkit-playsinline', '');
      v.setAttribute('x5-playsinline', '');
      if ('playsInline' in v) v.playsInline = true;
      v.setAttribute('autoplay', '');
      /* load() toujours : couvre src="" et <source> enfants */
      try { v.load(); } catch (e) {}
      var p = v.play();
      if (p && typeof p.catch === 'function') {
        p.catch(function () {
          /* second essai après 300 ms (cas iOS strict) */
          setTimeout(function () { try { v.play(); } catch (e) {} }, 300);
        });
      }
    }

    function rsAttach(v) {
      if (_observed.has(v)) return;
      _observed.add(v);
      rsPlayVideo(v);
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries, obs) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { rsPlayVideo(e.target); obs.unobserve(e.target); }
          });
        }, { threshold: 0.01 }).observe(v);
      }
    }

    function rsHeroVideoEnsurePlay() {
      var root = document.querySelector('.section-rs-hero-video');
      if (!root) return;
      root.querySelectorAll('video').forEach(rsAttach);
    }

    rsHeroVideoEnsurePlay();
    document.addEventListener('DOMContentLoaded', rsHeroVideoEnsurePlay);
    window.addEventListener('load', rsHeroVideoEnsurePlay);
    window.addEventListener('pageshow', function (ev) {
      if (ev.persisted) rsHeroVideoEnsurePlay();
    });
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) rsHeroVideoEnsurePlay();
    });

    /* MutationObserver : détecte les vidéos ajoutées dynamiquement par Shopify */
    if ('MutationObserver' in window) {
      new MutationObserver(function (muts) {
        muts.forEach(function (m) {
          m.addedNodes.forEach(function (n) {
            if (n.nodeType !== 1) return;
            if (n.tagName === 'VIDEO') rsAttach(n);
            n.querySelectorAll && n.querySelectorAll('video').forEach(rsAttach);
          });
        });
      }).observe(document.body, { childList: true, subtree: true });
    }

    /* iOS : relance au premier toucher si le navigateur a bloqué l'autoplay */
    document.addEventListener('touchstart', rsHeroVideoEnsurePlay, { once: true, passive: true });
    document.addEventListener('shopify:section:load', function (ev) {
      if (ev.target && ev.target.querySelector && ev.target.querySelector('.rs-hero-video')) rsHeroVideoEnsurePlay();
    });
  })();
</script>

{% schema %}
{
  "name": "Hero vidéo",
  "tag": "section",
  "class": "section-rs-hero-video",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Média"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Vidéo (fichiers Shopify)"
    },
    {
      "type": "text",
      "id": "mp4_url",
      "label": "URL MP4 externe (repli)",
      "info": "Utilisée si aucune vidéo Shopify. Lien direct .mp4 (HTTPS)."
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Image / poster (repli)",
      "info": "Affichée si pas de vidéo, ou poster du MP4 externe."
    },
    {
      "type": "header",
      "content": "Textes"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Afficher le badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texte du badge",
      "default": "Candidatures ouvertes"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Titre — ligne 1",
      "default": "Chaque vêtement"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Titre — ligne 2 (avant le mot accent)",
      "default": "est une"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Mot accent (ligne rose)",
      "default": "offre"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Postule. Candidature non négociable. Les meilleurs CV finissent sur le packaging."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Placeholder recherche",
      "default": "Cherche un poste..."
    },
    {
      "type": "text",
      "id": "search_btn_label",
      "label": "Libellé bouton recherche",
      "default": "Voir les offres →"
    },
    {
      "type": "header",
      "content": "Portail candidats"
    },
    {
      "type": "url",
      "id": "portal_url",
      "label": "Lien portail",
      "info": "Si vide : https://portail.recrutestagiaire.eu"
    },
    {
      "type": "text",
      "id": "portal_label",
      "label": "Libellé du bouton",
      "default": "Portail Candidat"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistique",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Valeur",
          "default": "2"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Texte",
          "default": "offres actives"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero vidéo",
      "blocks": []
    }
  ]
}
{% endschema %}
