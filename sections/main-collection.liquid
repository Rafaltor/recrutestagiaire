{%- assign rs_profiles_url = section.settings.cand_profiles_url | default: settings.rs_portail_url_profils | default: 'https://portail.recrutestagiaire.eu/profils' -%}
{%- assign rs_strip_top = section.settings.collection_strip_top | default: '#f3f6ff' -%}
{%- assign rs_strip_bot = section.settings.collection_strip_bot | default: '#ffffff' -%}
{%- assign _is_all_collection = false -%}
{%- if collection.handle == 'all' -%}
  {%- assign _is_all_collection = true -%}
{%- endif -%}

{%- if _is_all_collection -%}
  <div class="rs-collection-head rs-collection-head--all border-bottom">
    <div class="container py-3 py-md-4">
      <h1 class="rs-collection-head--all__title mb-2 mb-md-3">
        {{ section.settings.collection_all_title | default: 'Offres en cours' | escape }}
      </h1>
      <p class="rs-collection-head--all__subtitle mb-2 mb-md-3">
        {{ section.settings.collection_all_subtitle | default: "Mes Basiques d'Amour · Collection SS26" | escape }}
      </p>
      {% if section.settings.show_breadcrumb %}
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb rs-collection-head--all__crumb mb-0 small">
            <li class="breadcrumb-item"><a href="{{ routes.root_url }}">Accueil</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ collection.title }}</li>
          </ol>
        </nav>
      {% endif %}
    </div>
  </div>
{%- else -%}
  <div class="rs-collection-head border-bottom" style="background: linear-gradient(180deg, {{ rs_strip_top }} 0%, {{ rs_strip_bot }} 100%);">
    <div class="container py-2 py-md-3">
      <h1 class="rs-collection-head__title mb-1 mb-md-2" style="font-size:{{ section.settings.title_size }}px;font-weight:{{ section.settings.title_weight }};">
        {{ collection.title }}
      </h1>
      {% if section.settings.show_breadcrumb %}
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb rs-collection-head__crumb mb-0 small">
            <li class="breadcrumb-item"><a href="{{ routes.root_url }}">Accueil</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ collection.title }}</li>
          </ol>
        </nav>
      {% endif %}
    </div>
  </div>
{%- endif -%}

{%- assign rs_needs_api = false -%}
{%- for b in section.blocks -%}
  {%- if b.type == 'sponsored_rail' and b.settings.content_type == 'profiles_api' -%}
    {%- assign rs_needs_api = true -%}
  {%- endif -%}
{%- endfor -%}
<section
  class="rs-uni-page rs-collection-pole{% if section.settings.sidebar_candidate_ads %} rs-uni-page--rails{% endif %}"
  style="--rs-uni-center-width-pct: {{ section.settings.center_column_pct | default: 60 }}%;--rs-uni-center-max: {{ section.settings.rail_center_max | default: 900 }}px;--rs-uni-cell-border: {{ section.settings.collection_cell_border | default: '#888888' }};background: {{ section.settings.collection_page_bg | default: '#ffffff' }};padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;"
  {{ section.shopify_attributes }}>
  <div
    class="rs-uni-shell"
    {% if section.settings.sidebar_candidate_ads and rs_needs_api %}
      data-rs-cand-ads="1"
      data-api="{{ section.settings.rs_api_url | escape }}"
      data-kicker="{{ section.settings.cand_kicker | default: 'Sponsorisé' | escape }}"
      data-url="{{ rs_profiles_url | escape }}"
      data-cand-label-email="{{ section.settings.cand_email_btn_label | default: 'E-mail' | escape }}"
      data-cand-label-cv="{{ section.settings.cand_cv_btn_label | default: 'CV' | escape }}"
    {% endif %}>
    {%- if section.settings.sidebar_candidate_ads -%}
      <aside class="rs-uni-rail rs-uni-rail--left" aria-label="Rails sponsorisés">
        {%- for block in section.blocks -%}
          {%- if block.type == 'sponsored_rail' and block.settings.side == 'left' -%}
            <div class="rs-uni-rail__slot" {{ block.shopify_attributes }}>
              {%- render 'rs-rail-slot-inner', block: block, section: section -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </aside>
    {%- endif -%}
    <div class="rs-uni-main">
      <div class="container">
        <div class="row g-4">

      <!-- Grille produits -->
      <div class="col-12 col-md-12">

        <!-- Produits -->
        {%- comment -%} Desktop : 3 colonnes par défaut (lg/xl). Tablette md : 2 par ligne. {%- endcomment -%}
        {% assign col_class = 'col-12 col-md-6 col-lg-4 col-xl-4' %}
        {% if section.settings.grid_cols == '1' %}{% assign col_class = 'col-12' %}{% endif %}
        {% if section.settings.grid_cols == '2' %}{% assign col_class = 'col-12 col-md-6 col-lg-6 col-xl-6' %}{% endif %}
        {% if section.settings.grid_cols == '3' %}{% assign col_class = 'col-12 col-md-6 col-lg-4 col-xl-4' %}{% endif %}
        {% if section.settings.grid_cols == '4' %}{% assign col_class = 'col-12 col-md-6 col-lg-3 col-xl-3' %}{% endif %}

        {% paginate collection.products by section.settings.products_per_page %}
          <div class="row g-3 rs-tile-grid rs-tile-grid--floating" id="products-grid">
            {% for product in collection.products %}
              <div class="{{ col_class }} product-item d-flex align-items-stretch"
                data-tags="{{ product.tags | join: ',' | downcase }}"
                data-type="{{ product.type | downcase }}">
                <div class="w-100">
                  {% render 'rs-offer-grid-card', product: product, card_settings: section.settings, collection: collection, carousel_uid: section.id %}
                </div>
              </div>
            {% else %}
              <div class="col-12 text-center py-5 text-muted">Aucun poste disponible pour le moment.</div>
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <div class="d-flex justify-content-center mt-4">
              <ul class="pagination">
                {% if paginate.previous %}<li class="page-item"><a class="page-link" href="{{ paginate.previous.url }}">←</a></li>{% endif %}
                {% for part in paginate.parts %}
                  {% if part.is_link %}
                    <li class="page-item"><a class="page-link" href="{{ part.url }}">{{ part.title }}</a></li>
                  {% else %}
                    <li class="page-item active"><span class="page-link">{{ part.title }}</span></li>
                  {% endif %}
                {% endfor %}
                {% if paginate.next %}<li class="page-item"><a class="page-link" href="{{ paginate.next.url }}">→</a></li>{% endif %}
              </ul>
            </div>
          {% endif %}

        {% endpaginate %}
      </div>
    </div>
        </div>
      </div>
    {%- if section.settings.sidebar_candidate_ads -%}
      <aside class="rs-uni-rail rs-uni-rail--right" aria-label="Rails sponsorisés">
        {%- for block in section.blocks -%}
          {%- if block.type == 'sponsored_rail' and block.settings.side == 'right' -%}
            <div class="rs-uni-rail__slot" {{ block.shopify_attributes }}>
              {%- render 'rs-rail-slot-inner', block: block, section: section -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </aside>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.sidebar_candidate_ads and rs_needs_api -%}
  {% render 'rs-candidate-rails-script' %}
{%- endif -%}

