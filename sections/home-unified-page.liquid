{%- liquid
  assign rs_url_profils = settings.rs_portail_url_profils | default: 'https://portail.recrutestagiaire.eu/profils'
  assign rs_url_deposer = settings.rs_portail_url_depot | default: 'https://portail.recrutestagiaire.eu/depot'
  assign cand_rail_url = section.settings.cand_profiles_url | default: rs_url_profils
  assign rail_profiles = false
  if section.settings.sidebar_ads and section.settings.rail_content == 'profiles'
    assign rail_profiles = true
  endif
  assign rs_home_shell_api = false
  if rail_profiles
    assign rs_home_shell_api = true
  else
    for b in section.blocks
      if b.type == 'sponsored_rail' and b.settings.content_type == 'profiles_api'
        assign rs_home_shell_api = true
      endif
    endfor
  endif
  assign rs_uni_text_pct = 100
  if section.settings.sidebar_ads
    assign rc = section.settings.rail_center_max | default: 900
    assign rs_uni_text_pct = rc | times: 100 | divided_by: 900
    if rs_uni_text_pct > 100
      assign rs_uni_text_pct = 100
    endif
    if rs_uni_text_pct < 68
      assign rs_uni_text_pct = 68
    endif
  endif
-%}
{%- capture rs_uni_grid_inner -%}
{%- assign _rs_home_render_idx = 0 -%}
{%- for block in section.blocks -%}
  {%- liquid
    assign _rs_skip_cell = false
    if block.type == 'sponsored_rail'
      if block.settings.side == 'left' or block.settings.side == 'right'
        assign _rs_skip_cell = true
      endif
    endif
    assign _rs_bt = block.type | default: '' | strip | downcase
    if _rs_bt contains 'featured_products'
      assign _rs_skip_cell = true
    endif
    assign _rs_cell_ad_flush = false
    assign _rs_sponsored_ct = block.settings.content_type | default: 'product'
    if block.type == 'sponsored_rail' and block.settings.side == 'center' and _rs_sponsored_ct == 'product'
      assign _rs_cell_ad_flush = true
    endif
  -%}
  {%- unless _rs_skip_cell -%}
    {%- assign _rs_home_render_idx = _rs_home_render_idx | plus: 1 -%}
    {%- assign _rs_home_mob_map = '1|3|5|7|8|4|2|9|6' | split: '|' -%}
    {%- assign _rs_home_mo_idx = _rs_home_render_idx | minus: 1 -%}
    {%- assign _rs_home_mo = _rs_home_mob_map[_rs_home_mo_idx] | default: _rs_home_render_idx -%}
    {%- assign pad = block.settings.cell_padding | default: 16 -%}
    {%- assign span_n = block.settings.col_span | default: 12 | plus: 0 -%}
    {%- if span_n < 1 or span_n > 12 -%}
      {%- assign span_n = 12 -%}
    {%- endif -%}
    {%- if block.type == 'blue_band' or block.type == 'hero_intro_bundle' -%}
      {%- assign pad = 0 -%}
    {%- endif -%}
    <div
      class="rs-uni-cell{% if block.settings.use_strip_bg %} rs-uni-cell--strip{% endif %}{% if block.type == 'blue_band' %} rs-uni-cell--blue-band{% endif %}{% if _rs_cell_ad_flush %} rs-uni-cell--ad-flush{% endif %}"
      data-span="{{ span_n }}"
      style="--rs-mo: {{ _rs_home_mo }};{% if _rs_cell_ad_flush %}padding:0;border:none;background:transparent;{% else %}{% if block.settings.use_strip_bg %}padding: {{ pad }}px {{ pad }}px {{ pad | plus: section.settings.strip_padding_bottom }}px {{ pad }}px;{% else %}padding: {{ pad }}px;{% endif %}{% if block.settings.use_strip_bg == false and block.settings.cell_bg != blank %}background: {{ block.settings.cell_bg }};{% endif %}border-color: {% if block.settings.cell_border != blank %}{{ block.settings.cell_border }}{% else %}{{ section.settings.default_cell_border }}{% endif %};{% endif %}"
      {{ block.shopify_attributes }}>
      {%- render 'rs-unified-block',
        block: block,
        section: section,
        rs_url_profils: rs_url_profils,
        rs_url_deposer: rs_url_deposer
      -%}
    </div>
  {%- endunless -%}
{%- endfor -%}
{%- endcapture -%}
<section
  class="rs-uni-page{% if section.settings.sidebar_ads %} rs-uni-page--rails{% endif %}"
  style="--rs-uni-gap: {{ section.settings.grid_gap }}px;--rs-uni-strip-top: {{ section.settings.strip_bg }};--rs-uni-strip-bot: {{ section.settings.strip_bg_dark }};--rs-uni-cell-border: {{ section.settings.default_cell_border }};--rs-uni-center-width-pct: {{ section.settings.center_column_pct | default: 60 }}%;--rs-uni-center-max: {{ section.settings.rail_center_max | default: 900 }}px;--rs-uni-text-pct: {{ rs_uni_text_pct }};padding-top: {{ section.settings.page_padding_top }}px;padding-bottom: {{ section.settings.page_padding_bottom }}px;background: {{ section.settings.page_bg }};"
  {{ section.shopify_attributes }}>
  {%- if section.settings.sidebar_ads -%}
    <div
      class="rs-uni-shell"
      {% if rs_home_shell_api %}
        data-rs-cand-ads="1"
        data-api="{{ section.settings.rs_api_url | escape }}"
        data-kicker="{{ section.settings.cand_kicker | default: 'Sponsorisé' | escape }}"
        data-url="{{ cand_rail_url | escape }}"
        data-cand-label-email="{{ section.settings.cand_email_btn_label | default: 'E-mail' | escape }}"
        data-cand-label-cv="{{ section.settings.cand_cv_btn_label | default: 'CV' | escape }}"
      {% endif %}>
      <aside class="rs-uni-rail rs-uni-rail--left" aria-label="{{ section.settings.rail_column_title | default: 'Offres en vedette' | escape }}">
        <p class="rs-uni-rail__col-title">{{ section.settings.rail_column_title | default: 'OFFRES EN VEDETTE' | escape }}</p>
        {%- if rail_profiles -%}
          {%- assign ln = section.settings.rail_left_count | default: 2 | plus: 0 -%}
          {%- if ln < 0 -%}{%- assign ln = 0 -%}{%- endif -%}
          {%- for i in (1..ln) -%}
            <div class="rs-uni-rail__slot">
              <div class="rs-uni-rail__stack">
                {% render 'rs-sponsored-rail-candidate-ad' %}
                {%- if section.settings.rail_profiles_under_product != blank -%}
                  {%- render 'rs-sponsored-rail-ad',
                    inline_product: section.settings.rail_profiles_under_product,
                    inline_kicker: section.settings.rail_profiles_under_kicker,
                    inline_show_price: section.settings.rail_profiles_under_show_price,
                    inline_show_stars: section.settings.rail_profiles_under_show_stars,
                    inline_cta: section.settings.rail_profiles_under_cta,
                    rail_compact: true
                  -%}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'sponsored_rail' and block.settings.side == 'left' -%}
              <div class="rs-uni-rail__slot" {{ block.shopify_attributes }}>
                {% render 'rs-rail-slot-inner', block: block, section: section %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </aside>
      <div class="rs-uni-main">
        <div class="container">
          <div class="rs-uni-grid">
            {{ rs_uni_grid_inner }}
          </div>
        </div>
      </div>
      <aside class="rs-uni-rail rs-uni-rail--right" aria-label="{{ section.settings.rail_column_title | default: 'Offres en vedette' | escape }}">
        <p class="rs-uni-rail__col-title">{{ section.settings.rail_column_title | default: 'OFFRES EN VEDETTE' | escape }}</p>
        {%- if rail_profiles -%}
          {%- assign rn = section.settings.rail_right_count | default: 2 | plus: 0 -%}
          {%- if rn < 0 -%}{%- assign rn = 0 -%}{%- endif -%}
          {%- for i in (1..rn) -%}
            <div class="rs-uni-rail__slot">
              <div class="rs-uni-rail__stack">
                {% render 'rs-sponsored-rail-candidate-ad' %}
                {%- if section.settings.rail_profiles_under_product != blank -%}
                  {%- render 'rs-sponsored-rail-ad',
                    inline_product: section.settings.rail_profiles_under_product,
                    inline_kicker: section.settings.rail_profiles_under_kicker,
                    inline_show_price: section.settings.rail_profiles_under_show_price,
                    inline_show_stars: section.settings.rail_profiles_under_show_stars,
                    inline_cta: section.settings.rail_profiles_under_cta,
                    rail_compact: true
                  -%}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'sponsored_rail' and block.settings.side == 'right' -%}
              <div class="rs-uni-rail__slot" {{ block.shopify_attributes }}>
                {% render 'rs-rail-slot-inner', block: block, section: section %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </aside>
    </div>
  {%- else -%}
    <div class="container">
      <div class="rs-uni-grid">
        {{ rs_uni_grid_inner }}
      </div>
    </div>
  {%- endif -%}
</section>

<script>
(function () {
  function normalizeApi(api) {
    return String(api || '').replace(/\?+$/, '');
  }
  function run(root) {
    var api = root.getAttribute('data-api');
    var elN = root.querySelector('[data-rs-kitsch-n]');
    if (!api || !elN) return;
    fetch(normalizeApi(api) + '?action=count')
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function (d) {
        elN.textContent = String(d && d.count != null ? d.count : '—');
        root.hidden = false;
      })
      .catch(function () { root.hidden = true; });
  }

  function runAll() {
    document.querySelectorAll('[data-rs-kitsch="1"]').forEach(run);
  }

  // Theme editor can inject sections asynchronously → run multiple times.
  runAll();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runAll);
  }
  window.addEventListener('load', runAll);
  setTimeout(runAll, 600);
})();

(function () {
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] || c;
    });
  }
  function runTopProfiles() {
    document.querySelectorAll('.rs-top-profile-api').forEach(function (wrap) {
      var url = wrap.getAttribute('data-rs-top-profile-api');
      var base = wrap.getAttribute('data-rs-portail-base') || 'https://portail.recrutestagiaire.eu';
      var fb = wrap.getAttribute('data-rs-top-profile-fallback') || 'Classement en cours...';
      var btnLabel = wrap.getAttribute('data-rs-top-profile-btn-label') || 'Voir son profil →';
      var mount = wrap.querySelector('[data-rs-top-profile-mount]');
      if (!url || !mount) return;
      mount.innerHTML = '<p class="text-muted mb-0">' + esc(fb) + '</p>';
      fetch(url, { credentials: 'omit', mode: 'cors' })
        .then(function (r) {
          if (!r.ok) throw new Error('http');
          return r.json();
        })
        .then(function (d) {
          /* Ionos : { id, name, instagram, metier, likes, rank, token } — portail possible : { profile: { … } } */
          var p = d && (d.profile || (d.id ? d : null));
          if (!p || !p.id) {
            mount.innerHTML = '<p class="text-muted mb-0">' + esc(fb) + '</p>';
            return;
          }
          var path =
            p.profile_url ||
            '/profil/' + encodeURIComponent(p.token != null && String(p.token) !== '' ? String(p.token) : String(p.id));
          var href = base.replace(/\/$/, '') + path;
          var likes =
            typeof p.likes === 'number'
              ? p.likes
              : typeof d.likes === 'number'
                ? d.likes
                : parseFloat(p.likes) || 0;
          var rank =
            p.rank_label ||
            d.rank_label ||
            (typeof p.rank === 'number' ? 'N°' + p.rank + ' — cette semaine' : 'Profil N°1 cette semaine');
          var handle = p.handle || p.instagram || '—';
          var job = p.job_title || p.metier || '—';
          var nom = p.name && String(p.name).trim() ? String(p.name).trim() : '';
          var headBlock =
            nom !== ''
              ? '<p class="mb-1"><strong>' + esc(nom) + '</strong></p>' +
                (handle !== '—' ? '<p class="mb-1 small text-muted">' + esc(handle) + '</p>' : '')
              : '<p class="mb-1"><strong>' + esc(handle) + '</strong></p>';
          mount.innerHTML =
            headBlock +
            '<p class="mb-1 small">' + esc(job) + '</p>' +
            '<p class="mb-2 small">Likes : <strong>' + esc(String(likes)) + '</strong></p>' +
            '<p class="mb-3 small text-muted">' + esc(rank) + '</p>' +
            '<a class="rs-pole-panel__footer-link" href="' + esc(href) + '" rel="noopener noreferrer">' + esc(btnLabel) + '</a>';
        })
        .catch(function () {
          mount.innerHTML = '<p class="text-muted mb-0">' + esc(fb) + '</p>';
        });
    });
  }
  runTopProfiles();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runTopProfiles);
  }
  window.addEventListener('load', runTopProfiles);
  setTimeout(runTopProfiles, 500);
  document.addEventListener('shopify:section:load', runTopProfiles);
})();
</script>

{%- if rs_home_shell_api -%}
