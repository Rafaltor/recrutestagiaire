    { "type": "header", "content": "Intro (texte du haut)" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignement intro",
      "default": "text-center",
      "options": [
        { "value": "text-center", "label": "Centré" },
        { "value": "text-start", "label": "Gauche" }
      ]
    },
    { "type": "header", "content": "Bandeau (recherche / strip)" },
    { "type": "color", "id": "strip_bg", "label": "Dégradé — haut", "default": "#ffe9a3" },
    { "type": "color", "id": "strip_bg_dark", "label": "Dégradé — bas", "default": "#c99406" },
    { "type": "range", "id": "strip_padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Marge bas bandeau rouge", "default": 28 }
  ],
  "blocks": [
    {
      "type": "blue_band",
      "name": "Bandeau bleu",
      "settings": [
        { "type": "select", "id": "col_span", "label": "Largeur colonnes", "default": "12", "options": [
          { "value": "12", "label": "12 — Pleine largeur" }, { "value": "9", "label": "9" }, { "value": "8", "label": "8" }, { "value": "6", "label": "6 — 1/2" }, { "value": "4", "label": "4 — 1/3" }, { "value": "3", "label": "3 — 1/4" }
        ]},
        { "type": "checkbox", "id": "use_strip_bg", "label": "Fond bandeau rouge", "default": false },
        { "type": "color", "id": "cell_bg", "label": "Fond cellule" },
        { "type": "range", "id": "cell_padding", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Padding cellule", "default": 0 },
        { "type": "color", "id": "cell_border", "label": "Bordure (défaut page)" },
        { "type": "text", "id": "band_title", "label": "Titre", "default": "Services & parcours" },
        { "type": "color", "id": "band_bg_top", "label": "Dégradé haut", "default": "#4d79ff" },
        { "type": "color", "id": "band_bg_bottom", "label": "Dégradé bas", "default": "#0033cc" },
        { "type": "color", "id": "band_text", "label": "Couleur texte", "default": "#ffffff" }
      ]
    },
    {
      "type": "hero_intro_bundle",
      "name": "Intro unifiée 9/12",
      "limit": 1,
      "settings": [
        { "type": "select", "id": "col_span", "label": "Largeur colonnes", "default": "9", "options": [
          { "value": "12", "label": "12" }, { "value": "9", "label": "9 — 3/4" }, { "value": "8", "label": "8" }, { "value": "6", "label": "6" }
        ]},
        { "type": "checkbox", "id": "use_strip_bg", "label": "Fond bandeau rouge", "default": false },
        { "type": "color", "id": "cell_bg", "label": "Fond cellule", "default": "#e8e8e8" },
        { "type": "range", "id": "cell_padding", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Padding cellule", "default": 0 },
        { "type": "color", "id": "cell_border", "label": "Bordure (vide = défaut)" },
        { "type": "header", "content": "Bandeau bleu haut" },
        { "type": "checkbox", "id": "show_band", "label": "Afficher le bandeau", "default": true },
        { "type": "text", "id": "band_title", "label": "Titre bandeau", "default": "Services & parcours" },
        { "type": "color", "id": "band_bg_top", "label": "Dégradé haut", "default": "#4d79ff" },
        { "type": "color", "id": "band_bg_bottom", "label": "Dégradé bas", "default": "#0033cc" },
        { "type": "color", "id": "band_text", "label": "Texte bandeau", "default": "#ffffff" },
        { "type": "header", "content": "Textes & boutons" },
        { "type": "select", "id": "text_align", "label": "Alignement", "default": "text-center", "options": [
          { "value": "text-center", "label": "Centré" }, { "value": "text-start", "label": "Gauche" }
        ]},
        { "type": "text", "id": "badge_text", "label": "Badge", "default": "Collectif artistique — Paris 2026" },
        { "type": "color", "id": "badge_color", "label": "Fond badge", "default": "#f5f8ff" },
        { "type": "range", "id": "badge_size", "min": 9, "max": 16, "step": 1, "unit": "px", "label": "Taille badge", "default": 12 },
