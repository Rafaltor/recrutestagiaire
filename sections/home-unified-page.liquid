{%- endif -%}

{% schema %}
{
  "name": "Page accueil unifiée",
  "tag": "section",
  "class": "section-home-unified-page",
  "settings": [
    {
      "type": "paragraph",
      "content": "Dès 768 px de largeur d’écran, chaque bloc utilise sa valeur « Largeur colonnes » (sur 12). Ex. trois blocs en 4 + 4 + 4 tiennent sur une ligne. Vérifiez ce réglage dans chaque bloc."
    },
    { "type": "header", "content": "Page" },
    { "type": "color", "id": "page_bg", "label": "Fond autour cellules", "default": "#efefef" },
    { "type": "range", "id": "page_padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Marge haute page", "default": 0 },
    { "type": "range", "id": "page_padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Marge basse page", "default": 0 },
    { "type": "range", "id": "grid_gap", "min": 0, "max": 24, "step": 1, "unit": "px", "label": "Espacement des cellules", "default": 8 },
    { "type": "color", "id": "default_cell_border", "label": "Bordure cellules défaut", "default": "#dddddd" },
    { "type": "header", "content": "Rails pubs latéraux" },
    {
      "type": "checkbox",
      "id": "sidebar_ads",
      "label": "Activer rails sponsorisés",
      "default": true,
      "info": "Mode « Offres Shopify » : blocs « Pub rail latéral », contenu réglable par bloc (offre ou API). Mode « Profils candidats » : nombre de pubs ci‑dessous."
    },
    {
      "type": "text",
      "id": "rail_column_title",
      "label": "Titre des colonnes latérales (desktop)",
      "default": "OFFRES EN VEDETTE"
    },
    {
      "type": "select",
      "id": "rail_content",
      "label": "Contenu des rails",
      "default": "products",
      "options": [
        { "value": "products", "label": "Offres Shopify (blocs)" },
        { "value": "profiles", "label": "Profils candidats (API)" }
      ]
    },
    {
      "type": "range",
      "id": "rail_left_count",
      "min": 0,
      "max": 6,
      "step": 1,
      "label": "Pubs gauche (mode API)",
      "default": 2,
      "info": "Utilisé si « Profils candidats »."
    },
    {
      "type": "range",
      "id": "rail_right_count",
      "min": 0,
      "max": 6,
      "step": 1,
      "label": "Pubs droite (mode API)",
      "default": 2,
      "info": "Utilisé si « Profils candidats »."
    },
    {
      "type": "text",
      "id": "cand_kicker",
      "label": "Mention (rails profils)",
      "default": "Sponsorisé"
    },
    {
      "type": "text",
      "id": "cand_email_btn_label",
      "label": "Libellé bouton E-mail (profil API)",
      "default": "E-mail"
    },
    {
      "type": "text",
      "id": "cand_cv_btn_label",
      "label": "Libellé bouton CV (profil API)",
      "default": "CV"
    },
    {
      "type": "url",
      "id": "cand_profiles_url",
      "label": "Lien des pubs profils",
      "info": "Vide = URL « Profils » du thème (réglages Portail), par défaut le portail."
    },
    {
      "type": "range",
      "id": "center_column_pct",
      "min": 50,
      "max": 75,
      "step": 1,
      "unit": "%",
      "label": "Largeur zone centrale (écran)",
      "default": 60,
      "info": "Chaque rail latéral occupe le reste (environ 20 % chacun si 60 % au centre). Les encarts s’agrandissent en largeur et les visuels produit suivent."
    },
    {
      "type": "range",
      "id": "rail_center_max",
      "min": 640,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Échelle typo (réf. px, optionnel)",
      "default": 900,
      "info": "Ajuste la taille de texte des offres (variable --rs-uni-text-pct). N’impose plus la largeur de la colonne (celle-ci suit « Largeur zone centrale » en % ci-dessus)."
