<!-- Breadcrumb (retour + fil type mockup) -->
<div class="gray py-3 border-bottom">
  <div class="container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
      <a href="{{ collection.url | default: routes.all_products_collection_url }}" class="btn btn-sm btn-light-primary rounded-pill fw-medium px-4">
        <i class="bi bi-box-arrow-in-left me-2"></i>Retour aux offres
      </a>
      <div class="rs-pro-mock__breadcrumb-top small text-muted ms-md-auto text-md-end">
        <a href="{{ routes.all_products_collection_url }}" class="text-muted text-decoration-none">Offres en cours</a>
        {% if collection %}
          <span class="text-muted"> › </span>
          <a href="{{ collection.url }}" class="text-muted text-decoration-none">{{ collection.title }}</a>
        {% endif %}
        <span class="text-muted"> › </span>
        <span class="text-body">{{ section.settings.breadcrumb_ref_prefix | default: 'Poste n°' }}RS-{{ product.id }}</span>
      </div>
    </div>
  </div>
</div>

<section class="rs-uni-page pt-4 pb-5">
  <div class="container">
    {% render 'rs-product-page-mockup', product: product, section: section, collection: collection %}
  </div>
</section>

<script>
(function () {
  var main = document.getElementById('rs-pro-hero-img');
  document.querySelectorAll('.rs-pro-mock__thumb[data-src]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var src = this.getAttribute('data-src');
      if (main && src) main.setAttribute('src', src);
      document.querySelectorAll('.rs-pro-mock__thumb').forEach(function (t) {
        t.classList.remove('active');
      });
      this.classList.add('active');
    });
  });

  var variantInput = document.getElementById('product-variant-id');
  var priceEl = document.getElementById('rs-pro-price');
  if (!variantInput) return;
  document.querySelectorAll('.variant-select').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.variant-select').forEach(function (b) {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      this.classList.add('active');
      this.setAttribute('aria-pressed', 'true');
      variantInput.value = this.dataset.id;
      if (priceEl && this.dataset.money) priceEl.textContent = this.dataset.money;
      if (typeof history !== 'undefined' && history.replaceState) {
        try {
          var u = new URL(window.location.href);
          u.searchParams.set('variant', this.dataset.id);
          history.replaceState({}, '', u);
        } catch (e) {}
      }
    });
  });

  var shareBtn = document.getElementById('rs-pro-share-offer');
  if (shareBtn) {
    var resetLabel = shareBtn.getAttribute('data-reset-label') || "Sauvegarder l'offre";
    shareBtn.addEventListener('click', function () {
      var url = window.location.href;
      if (navigator.share) {
        navigator.share({ title: document.title, url: url }).catch(function () {});
      } else if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(function () {
          shareBtn.textContent = 'Lien copié';
          setTimeout(function () {
            shareBtn.textContent = resetLabel;
          }, 2000);
        });
      } else {
        window.prompt('Copier le lien :', url);
      }
    });
  }
})();
</script>

