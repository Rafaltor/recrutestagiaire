<section class="rs-uni-page rs-product-pole pt-4 pb-5" {{ section.shopify_attributes }}>
  <div class="container">
    {% render 'rs-product-page-mockup', product: product, section: section, collection: collection %}
  </div>
</section>

<script>
(function () {
  var main = document.getElementById('rs-pro-hero-img');
  document.querySelectorAll('.rs-pro-mock__thumb[data-src]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var src = this.getAttribute('data-src');
      if (main && src) main.setAttribute('src', src);
      document.querySelectorAll('.rs-pro-mock__thumb').forEach(function (t) {
        t.classList.remove('active');
      });
      this.classList.add('active');
    });
  });

  var variantInput = document.getElementById('product-variant-id');
  var priceEl = document.getElementById('rs-pro-price');
  if (!variantInput) return;
  document.querySelectorAll('.variant-select').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.variant-select').forEach(function (b) {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      this.classList.add('active');
      this.setAttribute('aria-pressed', 'true');
      variantInput.value = this.dataset.id;
      if (priceEl && this.dataset.money) priceEl.textContent = this.dataset.money;
      if (typeof history !== 'undefined' && history.replaceState) {
        try {
          var u = new URL(window.location.href);
          u.searchParams.set('variant', this.dataset.id);
          history.replaceState({}, '', u);
        } catch (e) {}
      }
    });
  });

})();
</script>

{% schema %}
{
  "name": "Fiche produit",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    { "type": "text", "id": "breadcrumb_ref_prefix", "label": "Préfixe fil d’Ariane (réf.)", "default": "Réf." },
    { "type": "text", "id": "price_label", "label": "Libellé prix", "default": "Prix" },
    {
      "type": "text",
      "id": "apply_lead_text",
      "label": "Texte au-dessus des choix de taille",
      "default": "Choisissez votre taille",
      "info": "Affiché juste au-dessus des pastilles de taille. Si vide, le « repli » ci-dessous est utilisé."
    },
    {
      "type": "text",
      "id": "variant_heading",
      "label": "Repli si le texte ci-dessus est vide",
      "default": "Choisissez votre taille"
    },
    {
      "type": "text",
      "id": "qty_label",
      "label": "Libellé champ quantité (bloc prix)",
      "default": "Quantité",
      "info": "Affiché à côté du champ nombre dans le cadre prix / postuler."
    },
    { "type": "text", "id": "add_to_cart_text", "label": "Texte bouton ajouter au panier", "default": "Ajouter au panier" },
    { "type": "text", "id": "free_shipping_text", "label": "Sous-texte prix (ex. livraison)", "default": "Livraison offerte dès 200 € d'achat" },
    { "type": "text", "id": "similar_title", "label": "Titre produits similaires", "default": "Vous aimerez aussi" },
    { "type": "text", "id": "description_title", "label": "Titre bloc description", "default": "Description" },
    { "type": "text", "id": "sold_out_message", "label": "Message rupture de stock", "default": "Ce produit est actuellement indisponible." },
    { "type": "text", "id": "sold_out_cta", "label": "Bouton rupture de stock", "default": "Voir la boutique" },
    {
      "type": "text",
      "id": "reassurance_default_1",
      "label": "Puce réassurance 1 (si pas de métachamp)",
      "default": "Disponible immédiatement"
    },
    {
      "type": "text",
      "id": "reassurance_default_2",
      "label": "Puce réassurance 2",
      "default": "Expédition sous 48h ouvrées"
    },
    {
      "type": "text",
      "id": "reassurance_default_3",
      "label": "Puce réassurance 3",
      "default": "Retours sous 14 jours"
    },
    { "type": "header", "content": "Fiche offre (valeurs par défaut)" },
    {
      "type": "paragraph",
      "content": "Métachamps produit (accès Boutique en ligne / Storefront) : contrat `custom.contrat_type` (ou `custom.contract_type`), détail département `custom.departement_detail`, `custom.department_detai` ou `department_detail`, `availability_label`, `matiere`, `missions`, `profil_recherche`, `avantages`, `reassurance_*`, `edition_limitee`, `collection_badge`, `localisation` / `ville`. Voir docs/product-offer-field-map.md."
    },
    { "type": "text", "id": "default_location", "label": "Localisation (métadonnées / SEO)", "default": "Paris, France", "info": "Utilisée si métachamps localisation absents." },
    { "type": "text", "id": "employer_label", "label": "Nom employeur", "default": "Recrute Stagiaire" },
    { "type": "url", "id": "employer_url", "label": "Lien employeur", "info": "Vide = accueil boutique." },
    { "type": "header", "content": "Titres blocs métachamps" },
    { "type": "text", "id": "missions_title", "label": "Titre — Missions", "default": "Missions du poste" },
    { "type": "text", "id": "profil_title", "label": "Titre — Profil", "default": "Profil recherché" },
    { "type": "text", "id": "avantages_title", "label": "Titre — Avantages", "default": "Avantages du poste" }
  ],
  "blocks": [
    {
      "type": "sponsored_rail",
      "name": "Pub rail latéral",
      "settings": [
        {
          "type": "select",
          "id": "side",
          "label": "Côté",
          "default": "right",
          "options": [
            { "value": "left", "label": "Gauche" },
            { "value": "right", "label": "Droite" }
          ]
        },
        {
          "type": "select",
          "id": "content_type",
          "label": "Contenu",
          "default": "profiles_api",
          "options": [
            { "value": "product", "label": "Offre Shopify" },
            { "value": "profiles_api", "label": "Profil candidat (API)" }
          ]
        },
        { "type": "product", "id": "product", "label": "Produit" },
        { "type": "text", "id": "kicker", "label": "Mention", "default": "Sponsorisé" },
        { "type": "checkbox", "id": "show_price", "label": "Afficher le prix", "default": true },
        { "type": "checkbox", "id": "show_stars", "label": "Étoiles décoratives", "default": true },
        { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Voir" }
      ]
    },
    {
      "type": "candidate_rail",
      "name": "Profil API (ancien)",
      "settings": [
        {
          "type": "select",
          "id": "side",
          "label": "Côté",
          "default": "right",
          "options": [
            { "value": "left", "label": "Gauche" },
            { "value": "right", "label": "Droite" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fiche produit"
    }
  ]
}
{% endschema %}
