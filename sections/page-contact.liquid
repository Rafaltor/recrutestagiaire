{%- assign rs_profils = settings.rs_portail_url_profils | default: 'https://portail.recrutestagiaire.eu/profils' -%}
{%- assign rs_depot = settings.rs_portail_url_depot | default: 'https://portail.recrutestagiaire.eu/depot' -%}

<div class="gray py-4 border-bottom">
  <div class="container">
    <h1 class="fs-3 fw-semibold mb-1">
      {{ section.settings.heading | default: page.title }}
    </h1>
    {%- if section.settings.lead != blank -%}
      <p class="mb-0 text-muted" style="font-size: 15px; max-width: 42rem;">
        {{ section.settings.lead }}
      </p>
    {%- endif -%}
  </div>
</div>

<div class="container py-5">
  <div class="row g-5">
    <div class="col-lg-5">
      <div class="pe-lg-3">
        {%- if section.settings.info_richtext != blank -%}
          <div class="rte mb-4" style="font-size: 15px; line-height: 1.75;">
            {{ section.settings.info_richtext }}
          </div>
        {%- endif -%}

        <ul class="list-unstyled small mb-0" style="font-size: 14px;">
          {%- if section.settings.email != blank -%}
            <li class="mb-2">
              <span class="fw-semibold text-dark">E-mail</span><br>
              <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.instagram_url != blank -%}
            <li class="mb-2">
              <span class="fw-semibold text-dark">Instagram</span><br>
              <a href="{{ section.settings.instagram_url | escape }}" target="_blank" rel="noopener noreferrer">
                {{ section.settings.instagram_label | default: section.settings.instagram_url | escape }}
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.extra_line != blank -%}
            <li class="mb-2">
              {{ section.settings.extra_line }}
            </li>
          {%- endif -%}
        </ul>

        <div class="mt-4 d-flex flex-wrap gap-2">
          <a href="{{ rs_profils | escape }}" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener noreferrer">
            Portail — Profils
          </a>
          <a href="{{ rs_depot | escape }}" class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener noreferrer">
            Portail — Déposer
          </a>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="rounded border p-4 p-md-5 bg-white" style="border-color: #dee2e6 !important;">
        <h2 class="h5 fw-bold mb-3">{{ section.settings.form_heading }}</h2>
        {%- if section.settings.form_intro != blank -%}
          <p class="text-muted small mb-4">{{ section.settings.form_intro }}</p>
        {%- endif -%}

        {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="alert alert-success small" role="status">
              {{ section.settings.success_message | default: 'Merci. Nous revenons vers vous dès que possible.' }}
            </div>
          {%- endif -%}

          {{ form.errors | default_errors }}

          <div class="mb-3">
            <label class="form-label small fw-semibold" for="ContactForm-name">Nom</label>
            <input
              type="text"
              id="ContactForm-name"
              class="form-control"
              name="contact[name]"
              value="{% if form.name %}{{ form.name }}{% endif %}"
              autocomplete="name"
              required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold" for="ContactForm-email">E-mail</label>
            <input
              type="email"
              id="ContactForm-email"
              class="form-control"
              name="contact[email]"
              value="{% if form.email %}{{ form.email }}{% endif %}"
              autocomplete="email"
              required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold" for="ContactForm-phone">Téléphone (optionnel)</label>
            <input
              type="tel"
              id="ContactForm-phone"
              class="form-control"
              name="contact[phone]"
              value="{% if form.phone %}{{ form.phone }}{% endif %}"
              autocomplete="tel">
          </div>

          <div class="mb-4">
            <label class="form-label small fw-semibold" for="ContactForm-body">Message</label>
            <textarea
              id="ContactForm-body"
              class="form-control"
              name="contact[body]"
              rows="6"
              required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>

          <button type="submit" class="btn btn-primary">
            {{ section.settings.submit_label | default: 'Envoyer' }}
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page Contact",
  "tag": "section",
  "class": "section-page-contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre principal",
      "default": "Contact"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Accroche sous le titre",
      "default": "Une question sur la boutique, le portail candidatures ou le collectif ? Écrivez-nous."
    },
    {
      "type": "richtext",
      "id": "info_richtext",
      "label": "Bloc infos (colonne gauche)",
      "default": "<p><strong>Boutique</strong> : commandes et produits sur ce site.</p><p><strong>Candidatures & vote</strong> : le portail dédié (liens ci-dessous).</p>"
    },
    {
      "type": "text",
      "id": "email",
      "label": "E-mail affiché",
      "default": "contact@recrutestagiaire.eu",
      "info": "Adresse publique ; le formulaire envoie vers l’e-mail configuré dans les notifications Shopify."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Lien Instagram (optionnel)"
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "Libellé Instagram",
      "default": "@recrutestagiaire"
    },
    {
      "type": "textarea",
      "id": "extra_line",
      "label": "Ligne libre (optionnel)",
      "info": "Ex. horaires, ville, précision légale."
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Titre du formulaire",
      "default": "Envoyer un message"
    },
    {
      "type": "textarea",
      "id": "form_intro",
      "label": "Texte sous le titre du formulaire",
      "default": "Réponse sous quelques jours ouvrés. Pour déposer un CV, utilisez le portail « Déposer »."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Libellé bouton envoi",
      "default": "Envoyer le message"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Message après envoi réussi",
      "default": "Merci ! Votre message a bien été envoyé."
    }
  ],
  "presets": [{ "name": "Page Contact" }]
}
{% endschema %}
