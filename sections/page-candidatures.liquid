{%- assign rs_mode = section.settings.page_mode | default: 'both' -%}
{%- assign show_profiles = false -%}
{%- assign show_form = false -%}
{%- if rs_mode == 'profiles' or rs_mode == 'both' -%}{%- assign show_profiles = true -%}{%- endif -%}
{%- if rs_mode == 'form' or rs_mode == 'both' -%}{%- assign show_form = true -%}{%- endif -%}

<!-- En-tête page -->
<div class="gray py-4 border-bottom rs-candidatures-head">
  <div class="container">
    <h1 style="font-size:{{ section.settings.page_title_size }}px;font-weight:600;margin:0 0 4px;">
      {{ section.settings.page_title | default: 'Candidatures ouvertes' }}
    </h1>
    <p style="font-size:{{ section.settings.subtitle_size }}px;color:#6c757d;margin:0;">
      {{ section.settings.page_subtitle | default: 'Découvrez les profils disponibles ou déposez votre candidature.' }}
    </p>
  </div>
</div>

<section class="rs-page-cand" style="padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="row g-0 rs-tile-split align-items-start{% if rs_mode == 'form' %} justify-content-center{% endif %}">

      {%- if show_profiles -%}
      <div class="{% if rs_mode == 'both' %}col-xl-8 col-lg-8 rs-tile-split__main{% else %}col-12{% endif %} col-md-12">
        <div class="d-flex align-items-center justify-content-between mb-4">
          <h2 style="font-size:{{ section.settings.grid_title_size }}px;font-weight:600;margin:0;">
            {{ section.settings.grid_title | default: 'Profils disponibles' }}
          </h2>
          <span id="rs-count" class="badge bg-success rs-profile-count" style="display:none;"></span>
        </div>

        <div class="mb-4">
          <div class="formField icons">
            <input type="text" id="rs-search" class="form-control lights"
              style="height:{{ section.settings.search_height }}px;"
              placeholder="{{ section.settings.search_placeholder | default: 'Rechercher par nom, poste...' }}">
            <i class="bi bi-search icon"></i>
          </div>
        </div>

        <div id="rs-loading" class="text-center py-5">
          <div class="spinner-border text-primary" role="status"></div>
          <p class="text-muted mt-3 small">Chargement des profils...</p>
        </div>

        <div id="rs-grid" class="rs-pe-list" style="display:none;"></div>

        <div id="rs-empty" class="text-center py-5" style="display:none;">
          <i class="bi bi-people fs-1 text-muted d-block mb-3"></i>
          <p class="text-muted">Aucun profil disponible pour le moment.</p>
        </div>

        <div id="rs-config-error" class="alert alert-warning" style="display:none;">
          <i class="bi bi-gear me-2"></i>
          Indiquez l’<strong>URL du proxy API</strong> (IONOS) dans le customizer Shopify pour afficher les profils.
        </div>

        <div id="rs-net-error" class="alert alert-danger" style="display:none;">
          <i class="bi bi-exclamation-triangle me-2"></i>
          Impossible de charger les profils. Vérifiez l’URL du proxy, la config Supabase sur IONOS et le CORS.
        </div>

        {%- if rs_mode == 'profiles' and section.settings.form_page_url != blank -%}
          <div class="mt-4">
            <a href="{{ section.settings.form_page_url }}" class="btn btn-primary">
              {{ section.settings.form_page_link_label | default: 'Déposer ma candidature' }}
            </a>
          </div>
        {%- endif -%}
      </div>
      {%- endif -%}

      {%- if show_form -%}
      <div class="{% if rs_mode == 'both' %}col-xl-4 col-lg-4 rs-tile-split__aside{% else %}col-12 col-lg-8 col-xl-7{% endif %} col-md-12">
        {%- if rs_mode == 'form' and section.settings.profiles_page_url != blank -%}
          <div class="mb-3">
            <a href="{{ section.settings.profiles_page_url }}" class="btn btn-outline-secondary btn-sm">
              {{ section.settings.profiles_page_link_label | default: 'Voir les profils publiés' }}
            </a>
          </div>
        {%- endif -%}

        <div id="deposer-candidature" class="border rounded overflow-hidden{% if rs_mode == 'form' %} mx-auto{% endif %}"
          {% if rs_mode == 'both' %}style="position:sticky;top:80px;"{% endif %}>
          <div style="background:linear-gradient(135deg,{{ section.settings.form_header_from }},{{ section.settings.form_header_to }});padding:20px 24px;">
            <h4 class="text-white fw-semibold mb-1"
              style="font-size:{{ section.settings.form_title_size }}px;">
              {{ section.settings.form_title | default: 'Déposer ma candidature' }}
            </h4>
            <p class="text-white small mb-0" style="opacity:.75;">
              {{ section.settings.form_subtitle | default: 'Votre profil sera visible après modération.' }}
            </p>
          </div>

          <div class="p-4">

            <div id="rs-success" class="alert alert-success mb-3" style="display:none;">
              <i class="bi bi-check-circle-fill me-2"></i>
              <strong>{{ section.settings.success_title | default: 'Candidature envoyée !' }}</strong><br>
              <span class="small">{{ section.settings.success_text | default: 'Elle sera visible après validation.' }}</span>
            </div>

            <div id="rs-form-error" class="alert alert-danger mb-3 small" style="display:none;"></div>

            <form id="rs-form" novalidate>
              {%- if section.settings.cv_affinda_intro != blank -%}
                <p class="small text-muted mb-3">{{ section.settings.cv_affinda_intro }}</p>
              {%- endif -%}

              <div class="mb-3">
                <label class="form-label fw-semibold" for="rs-cv-file" style="font-size:{{ section.settings.form_label_size }}px;">
                  {{ section.settings.label_cv | default: 'Votre CV' }} <span class="text-danger">*</span>
                </label>
                <input type="file" id="rs-cv-file" name="file" class="form-control"
                  style="font-size:{{ section.settings.form_input_size }}px;"
                  accept=".pdf,.doc,.docx,.odt,.rtf,.txt,.html,.htm,image/png,image/jpeg,image/tiff,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                  required
                  {% if section.settings.cv_help != blank %}aria-describedby="rs-cv-help"{% endif %}>
                {% if section.settings.cv_help != blank %}
                  <div id="rs-cv-help" class="form-text" style="font-size:{{ section.settings.form_label_size | minus: 1 }}px;">
                    {{ section.settings.cv_help }}
                  </div>
                {% endif %}
                <div class="d-flex flex-wrap align-items-stretch gap-2 mt-2">
                  <button type="button" class="btn btn-outline-primary btn-sm" id="rs-extract-cv">
                    <i class="bi bi-magic me-1" aria-hidden="true"></i>{{ section.settings.cv_extract_label | default: 'Extraire les infos du CV' }}
                  </button>
                  <span class="small text-muted align-self-center" id="rs-extract-status" style="display:none;" role="status"></span>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold" style="font-size:{{ section.settings.form_label_size }}px;">
                  {{ section.settings.label_name | default: 'Nom & Prénom' }} <span class="text-danger">*</span>
                </label>
                <input type="text" id="rs-nom" class="form-control"
                  style="font-size:{{ section.settings.form_input_size }}px;"
                  placeholder="{{ section.settings.placeholder_name | default: 'ex : Sophie Martin' }}" required>
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold" style="font-size:{{ section.settings.form_label_size }}px;">
                  {{ section.settings.label_email | default: 'Adresse email' }} <span class="text-danger">*</span>
                </label>
                <input type="email" id="rs-email" class="form-control"
                  style="font-size:{{ section.settings.form_input_size }}px;"
                  placeholder="{{ section.settings.placeholder_email | default: 'votre@email.com' }}" required>
                {% if section.settings.email_help != blank %}
                  <div class="form-text" style="font-size:{{ section.settings.form_label_size | minus: 1 }}px;">
                    {{ section.settings.email_help }}
                  </div>
                {% endif %}
              </div>

              <div class="mb-3">
                <label class="form-label fw-semibold" style="font-size:{{ section.settings.form_label_size }}px;">
                  {{ section.settings.label_poste | default: 'Poste recherché' }} <span class="text-danger">*</span>
                </label>
                <input type="text" id="rs-poste" class="form-control"
                  style="font-size:{{ section.settings.form_input_size }}px;"
                  placeholder="{{ section.settings.placeholder_poste | default: 'ex : Designer textile, Modéliste...' }}" required>
              </div>

              <div class="mb-4">
                <label class="form-label fw-semibold" style="font-size:{{ section.settings.form_label_size }}px;">
                  {{ section.settings.label_portfolio | default: 'Portfolio ou site web' }}
                </label>
                <input type="url" id="rs-portfolio" class="form-control"
                  style="font-size:{{ section.settings.form_input_size }}px;"
                  placeholder="{{ section.settings.placeholder_portfolio | default: 'https://...' }}">
              </div>

              <button type="submit" id="rs-submit" class="btn btn-primary w-100 fw-semibold"
                style="font-size:{{ section.settings.submit_size }}px;border-radius:{{ section.settings.submit_radius }}px;padding:10px;">
                <span id="rs-submit-text">
                  <i class="bi bi-send me-2"></i>{{ section.settings.submit_label | default: 'Envoyer ma candidature' }}
                </span>
                <span id="rs-submit-loader" style="display:none;">
                  <span class="spinner-border spinner-border-sm me-2"></span>Envoi en cours...
                </span>
              </button>

            </form>
          </div>
        </div>
      </div>
      {%- endif -%}

    </div>
  </div>
</section>

<style>
  .rs-pe-list { display: flex; flex-direction: column; gap: {{ section.settings.card_gap_pe | default: 16 }}px; }
  .rs-pe-card {
    border: 1px solid #c5d5e4;
    border-radius: {{ section.settings.card_radius }}px;
    background: #fff;
    box-shadow: 0 1px 3px rgba(0, 40, 100, 0.08);
    overflow: hidden;
  }
  .rs-pe-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px 14px;
    background: linear-gradient(180deg, {{ section.settings.pe_bar_color | default: '#005a9c' }} 0%, {{ section.settings.pe_bar_color_dark | default: '#004578' }} 100%);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .rs-pe-card__status { text-transform: uppercase; }
  .rs-pe-card__ref { opacity: 0.9; font-weight: 500; font-size: 11px; }
  .rs-pe-card__body { padding: 16px 18px 14px; }
  .rs-pe-card__title {
    margin: 0 0 14px;
    font-size: {{ section.settings.card_name_size }}px;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.25;
    border-bottom: 2px solid {{ section.settings.pe_accent | default: '#e85d04' }};
    padding-bottom: 8px;
  }
  .rs-pe-dl { margin: 0; }
  .rs-pe-dl > div {
    display: grid;
    grid-template-columns: minmax(120px, 34%) 1fr;
    gap: 8px 16px;
    padding: 8px 0;
    border-bottom: 1px solid #e8eef4;
    font-size: {{ section.settings.card_role_size }}px;
  }
  .rs-pe-dl > div:last-of-type { border-bottom: none; }
  .rs-pe-dl dt {
    margin: 0;
    color: #5a6c7d;
    font-weight: 600;
  }
  .rs-pe-dl dd { margin: 0; color: #222; word-break: break-word; }
  .rs-pe-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px dashed #cfd8e3;
  }
  .rs-pe-card__actions .btn { flex: 1 1 auto; min-width: 120px; }
  @media (max-width: 576px) {
    .rs-pe-dl > div { grid-template-columns: 1fr; gap: 2px; }
    .rs-pe-dl dt { font-size: 11px; }
  }

  #rs-count.rs-profile-count {
    align-items: center;
    justify-content: center;
    line-height: 1.2;
    text-align: center;
    vertical-align: middle;
    align-self: center;
    padding: 0.42em 0.75em;
    box-sizing: border-box;
  }

</style>

<script>
(function() {
  var API = {{ section.settings.rs_api_url | json }};

  var FIELD_POSTE = {{ section.settings.airtable_field_poste | default: 'Poste recherché' | json }};
  var FIELD_PROF  = {{ section.settings.airtable_field_professions | json }};

  var AVATAR_SIZE  = {{ section.settings.avatar_size }};
  var CARD_RADIUS  = {{ section.settings.card_radius }};
  var ROLE_SIZE    = {{ section.settings.card_role_size }};
  var EMAIL_SIZE   = {{ section.settings.card_email_size }};
  var BTN_SIZE     = {{ section.settings.card_btn_size }};

  var elGrid     = document.getElementById('rs-grid');
  var elLoading  = document.getElementById('rs-loading');
  var elEmpty    = document.getElementById('rs-empty');
  var elCfgErr   = document.getElementById('rs-config-error');
  var elNetErr   = document.getElementById('rs-net-error');
  var elCount    = document.getElementById('rs-count');
  var elSearch   = document.getElementById('rs-search');
  var allRecords = [];

  function load() {
    if (!elGrid || !elLoading) return;
    if (!API) {
      elLoading.style.display = 'none';
      if (elCfgErr) elCfgErr.style.display = 'block';
      return;
    }
    var url = String(API).replace(/\?+$/, '') + '?action=profiles';

    fetch(url)
      .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function(data) {
        elLoading.style.display = 'none';
        var recs = (data && data.profiles) ? data.profiles : [];
        if (!recs.length) {
          if (elEmpty) elEmpty.style.display = 'block';
          return;
        }
        // Format API (proxy) -> format attendu par render()
        allRecords = recs.map(function(p) {
          var sc = p.score;
          var num = typeof sc === 'number' && !isNaN(sc) ? sc : parseFloat(sc);
          if (isNaN(num)) num = 0;
          return {
            id: p.id || '',
            _rsScore: num,
            fields: {
              'Nom Prénom': p.name || '',
              'Email': p.email || '',
              // Backward compat: allow custom field names in theme settings
              [FIELD_POSTE]: p.role || '',
              ...(FIELD_PROF ? { [FIELD_PROF]: p.professions || '' } : {}),
              'CV': p.cv || '',
              'Portfolio': p.portfolio || ''
            }
          };
        });
        allRecords.sort(function(a, b) {
          var d = (b._rsScore || 0) - (a._rsScore || 0);
          if (d !== 0) return d;
          var na = (a.fields && a.fields['Nom Prénom']) ? String(a.fields['Nom Prénom']) : '';
          var nb = (b.fields && b.fields['Nom Prénom']) ? String(b.fields['Nom Prénom']) : '';
          return na.localeCompare(nb, 'fr', { sensitivity: 'base' });
        });
        if (elCount) {
          elCount.textContent = allRecords.length + ' profil' + (allRecords.length > 1 ? 's' : '');
          elCount.style.display = 'inline-flex';
        }
        elGrid.style.display = '';
        render(allRecords);
      })
      .catch(function(err) {
        elLoading.style.display = 'none';
        if (elNetErr) elNetErr.style.display = 'block';
        console.error('Profils API error:', err);
      });
  }

  function esc(s) {
    if (s == null || s === '') return '';
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function escAttr(s) {
    if (s == null || s === '') return '';
    return String(s).replace(/"/g, '&quot;');
  }

  function professionText(f) {
    var pProf = (FIELD_PROF && f[FIELD_PROF]) ? String(f[FIELD_PROF]).trim() : '';
    var pPoste = f[FIELD_POSTE] ? String(f[FIELD_POSTE]).trim() : '';
    var parts = [];
    if (pProf) parts.push(pProf);
    if (pPoste && pPoste !== pProf) parts.push(pPoste);
    return parts.join(' — ');
  }

  function recordSearchBlob(r) {
    var f = r.fields;
    return [
      f['Nom Prénom'], f['Email'], professionText(f),
      FIELD_PROF ? f[FIELD_PROF] : '', f[FIELD_POSTE] ? f[FIELD_POSTE] : ''
    ].join(' ').toLowerCase();
  }

  function render(records) {
    if (!elGrid) return;
    elGrid.innerHTML = '';
    if (!records.length) {
      elGrid.innerHTML = '<div class="text-center text-muted py-4">Aucun résultat.</div>';
      return;
    }
    records.forEach(function(rec) {
      var f         = rec.fields;
      var nom       = f['Nom Prénom'] || 'Candidat';
      var email     = f['Email'] || '';
      var prof      = professionText(f);
      var cv        = f['CV'] || '';
      var portfolio = f['Portfolio'] || '';
      var initials  = nom.trim().split(/\s+/).map(function(p){ return p.charAt(0); }).join('').substring(0,2).toUpperCase() || '?';
      var refId     = (rec.id || '').replace(/^rec/i, '');
      var refShort  = refId ? refId.substring(0, 8).toUpperCase() : '';

      var profDd = prof
        ? esc(prof)
        : '<span class="text-muted" style="font-style:italic;">Non renseigné</span>';
      var emailDd = email
        ? '<a href="mailto:' + esc(email) + '">' + esc(email) + '</a>'
        : '<span class="text-muted">Non communiqué</span>';

      var actions = '';
      if (cv)        actions += '<a href="' + escAttr(cv) + '" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary" style="font-size:' + BTN_SIZE + 'px;"><i class="bi bi-file-earmark-text me-1"></i>Consulter le CV</a>';
      if (portfolio) actions += '<a href="' + escAttr(portfolio) + '" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary" style="font-size:' + BTN_SIZE + 'px;"><i class="bi bi-link-45deg me-1"></i>Portfolio / lien</a>';
      if (email)     actions += '<a href="mailto:' + escAttr(email) + '" class="btn btn-sm btn-primary" style="font-size:' + BTN_SIZE + 'px;"><i class="bi bi-envelope me-1"></i>Contacter</a>';
      var actionsHtml = actions
        ? '<div class="rs-pe-card__actions">' + actions + '</div>'
        : '';

      var div = document.createElement('div');
      div.className = 'rs-card';
      div.dataset.search = recordSearchBlob(rec);
      div.innerHTML =
        '<article class="rs-pe-card">' +
          '<div class="rs-pe-card__head">' +
            '<span class="rs-pe-card__status">Profil disponible</span>' +
            (refShort ? '<span class="rs-pe-card__ref">N° dossier ' + esc(refShort) + '</span>' : '') +
          '</div>' +
          '<div class="rs-pe-card__body">' +
            '<div class="d-flex gap-3 align-items-start">' +
              '<div aria-hidden="true" style="width:' + AVATAR_SIZE + 'px;height:' + AVATAR_SIZE + 'px;min-width:' + AVATAR_SIZE + 'px;background:linear-gradient(180deg,#e8eef4,#d4dee8);border:1px solid #b8c9d9;border-radius:4px;display:flex;align-items:center;justify-content:center;color:#005a9c;font-weight:800;font-size:' + Math.round(AVATAR_SIZE * 0.32) + 'px;">' +
                esc(initials) +
              '</div>' +
              '<div class="flex-grow-1 min-w-0">' +
                '<h3 class="rs-pe-card__title">' + esc(nom) + '</h3>' +
                '<dl class="rs-pe-dl">' +
                  '<div><dt>Métier(s) recherché(s)</dt><dd>' + profDd + '</dd></div>' +
                  '<div><dt>Adresse e-mail</dt><dd style="font-size:' + EMAIL_SIZE + 'px;">' + emailDd + '</dd></div>' +
                '</dl>' +
              '</div>' +
            '</div>' +
            actionsHtml +
          '</div>' +
        '</article>';
      elGrid.appendChild(div);
    });
  }

  if (elSearch) {
    elSearch.addEventListener('input', function() {
      var q = this.value.toLowerCase().trim();
      if (!q) { render(allRecords); return; }
      render(allRecords.filter(function(r) {
        return recordSearchBlob(r).indexOf(q) !== -1;
      }));
    });
  }

  var form     = document.getElementById('rs-form');
  var elSucc   = document.getElementById('rs-success');
  var elFrmE   = document.getElementById('rs-form-error');
  var elBtn    = document.getElementById('rs-submit');
  var elBTxt   = document.getElementById('rs-submit-text');
  var elBLdr   = document.getElementById('rs-submit-loader');
  var elFile   = document.getElementById('rs-cv-file');
  var elExBtn  = document.getElementById('rs-extract-cv');
  var elExStat = document.getElementById('rs-extract-status');

  if (elExBtn && elExStat) {
    elExBtn.addEventListener('click', function() {
      if (!elFrmE) return;
      elFrmE.style.display = 'none';
      if (!API) {
        elFrmE.innerHTML = '<i class="bi bi-x-circle me-2"></i>API non configurée : impossible d’analyser le CV.';
        elFrmE.style.display = 'block';
        return;
      }
      if (!elFile || !elFile.files || !elFile.files[0]) {
        elExStat.textContent = 'Sélectionnez d’abord un fichier PDF ou Word.';
        elExStat.style.display = 'inline';
        return;
      }
      elExBtn.disabled = true;
      elExStat.textContent = 'Analyse en cours…';
      elExStat.style.display = 'inline';
      var fd = new FormData();
      fd.append('file', elFile.files[0], elFile.files[0].name);
      var url = String(API).replace(/\?+$/, '') + '?action=parse_cv';
      fetch(url, { method: 'POST', body: fd, mode: 'cors' })
        .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, s: r.status, d: d }; }); })
        .then(function(x) {
          elExBtn.disabled = false;
          if (x.ok && x.d) {
            var p = x.d;
            if (p.name) document.getElementById('rs-nom').value = p.name;
            if (p.email) document.getElementById('rs-email').value = p.email;
            if (p.role) document.getElementById('rs-poste').value = p.role;
            if (p.portfolio) document.getElementById('rs-portfolio').value = p.portfolio;
            elExStat.textContent = p.note || 'Vérifiez les champs et envoyez la candidature.';
            elExStat.style.display = 'inline';
            return;
          }
          elExStat.textContent = '';
          elExStat.style.display = 'none';
          var det = (x.d && x.d.details != null) ? String(x.d.details) : '';
          var msg = (x.d && x.d.error) || det || ('HTTP ' + (x.s || ''));
          if (x.s === 501 && x.d && x.d.info) {
            msg = msg + ' — ' + String(x.d.info);
          }
          elFrmE.innerHTML = '<i class="bi bi-exclamation-triangle me-2"></i>' + esc(msg);
          elFrmE.style.display = 'block';
        })
        .catch(function() {
          elExBtn.disabled = false;
          elExStat.textContent = 'Erreur réseau.';
          elExStat.style.display = 'inline';
        });
    });
  }

  if (form && elFrmE && elSucc && elBtn && elBTxt && elBLdr) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      elFrmE.style.display = 'none'; elSucc.style.display = 'none';
      if (!API) {
        elFrmE.innerHTML = '<i class="bi bi-x-circle me-2"></i>API non configurée.';
        elFrmE.style.display = 'block'; return;
      }
      var nom  = document.getElementById('rs-nom').value.trim();
      var email= document.getElementById('rs-email').value.trim();
      var poste= document.getElementById('rs-poste').value.trim();
      var port = document.getElementById('rs-portfolio') ? document.getElementById('rs-portfolio').value.trim() : '';
      if (!elFile || !elFile.files || !elFile.files[0]) {
        elFrmE.innerHTML = '<i class="bi bi-x-circle me-2"></i>Joignez votre CV (fichier).';
        elFrmE.style.display = 'block'; return;
      }
      if (!nom || !email || !poste) {
        elFrmE.innerHTML = '<i class="bi bi-x-circle me-2"></i>Veuillez remplir les champs obligatoires.';
        elFrmE.style.display = 'block'; return;
      }
      elBTxt.style.display = 'none'; elBLdr.style.display = 'inline-block'; elBtn.disabled = true;
      var fdata = new FormData();
      fdata.append('name', nom);
      fdata.append('email', email);
      fdata.append('role', poste);
      fdata.append('cv', '');
      fdata.append('portfolio', port || '');
      fdata.append('file', elFile.files[0], elFile.files[0].name);
      fetch(String(API).replace(/\?+$/, '') + '?action=submit', {
        method: 'POST',
        body: fdata,
        mode: 'cors'
      })
      .then(function(r) {
        elBTxt.style.display = 'inline'; elBLdr.style.display = 'none'; elBtn.disabled = false;
        if (r.ok) {
          elSucc.style.display = 'block';
          form.reset();
          if (elExStat) { elExStat.textContent = ''; elExStat.style.display = 'none'; }
          setTimeout(function() { elSucc.style.display = 'none'; }, 8000);
        } else {
          return r.json().then(function(d) {
            elFrmE.innerHTML = '<i class="bi bi-x-circle me-2"></i>' + ((d && d.error) || 'Erreur. Réessayez.');
            elFrmE.style.display = 'block';
          });
        }
      })
      .catch(function() {
        elBTxt.style.display = 'inline'; elBLdr.style.display = 'none'; elBtn.disabled = false;
        elFrmE.innerHTML = '<i class="bi bi-x-circle me-2"></i>Erreur réseau.';
        elFrmE.style.display = 'block';
      });
    });
  }

  if (elGrid) {
    load();
  }
})();
</script>

